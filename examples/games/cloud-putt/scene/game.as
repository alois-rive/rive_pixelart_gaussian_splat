function stepped(v: f64, q: f64): f64 {
    return Math.floor(v / q) * q;
}

function smooth01(t: f64): f64 {
    let u = Math.min(1.0, Math.max(0.0, t));
    return u * u * (3.0 - 2.0 * u);
}

function powerSpeed(p: f64): f64 {
    return 0.35 + (VMAX - 0.35) * Math.pow(p, 1.3);
}

function millAngle(t: f64): f64 {
    return Math.floor(t * 12.0) / 12.0 * MILL_SPEED;
}

function fterm(kind: i32, a: f64, b: f64, u: f64): f64 {
    if (kind == 0) {
        return 1.0;
    }
    if (kind == 1) {
        return smooth01((u - a) / (b - a));
    }
    if (kind == 2) {
        return Math.min(1.0, Math.max(0.0, (u - a) / (b - a)));
    }
    if (kind == 3) {
        let t = (u - a) / (b - a);
        return (t >= 0.0 && t <= 1.0) ? t : 0.0;
    }
    if (kind == 4) {
        let t = (u - a) / b;
        return Math.max(0.0, 1.0 - t * t);
    }
    if (kind == 5) {
        return (u >= a && u <= b) ? 1.0 : 0.0;
    }
    return 0.0;
}

// the felt's height above FELT at a world point of hole hi
function height(hi: i32, x: f64, z: f64): f64 {
    let h = 0.0;
    for (let k = TERM_AT[hi]; k < TERM_AT[hi + 1]; k++) {
        let o = k * 8;
        if (TERM[o] == 1.0) {
            let dx = x - TERM[o + 2], dz = z - TERM[o + 3], s = TERM[o + 4];
            h += TERM[o + 1] * Math.exp(-(dx * dx + dz * dz) / (2.0 * s * s));
        } else {
            h += TERM[o + 1] * fterm(<i32>TERM[o + 2], TERM[o + 3], TERM[o + 4], x)
                             * fterm(<i32>TERM[o + 5], TERM[o + 6], TERM[o + 7], z);
        }
    }
    return h;
}

function inRect(a: StaticArray<f64>, o: i32, x: f64, z: f64): bool {
    return x >= a[o] && x <= a[o + 2] && z >= a[o + 1] && z <= a[o + 3];
}

function onBridge(hi: i32, x: f64, z: f64): bool {
    let o = hi * 11 + 7;
    if (HOLE[o] == 0.0 && HOLE[o + 2] == 0.0) {
        return false;
    }
    return inRect(HOLE, o, x, z);
}

// over felt (or the bridge) and not over a hazard
function solid(hi: i32, x: f64, z: f64): bool {
    if (onBridge(hi, x, z)) {
        return true;
    }
    for (let k = HAZ_AT[hi]; k < HAZ_AT[hi + 1]; k++) {
        if (inRect(HAZ, k * 5, x, z)) {
            return false;
        }
    }
    for (let k = FELT_AT[hi]; k < FELT_AT[hi + 1]; k++) {
        if (inRect(FELTR, k * 4, x, z)) {
            return true;
        }
    }
    return false;
}

function hazardKind(hi: i32, x: f64, z: f64): i32 {
    for (let k = HAZ_AT[hi]; k < HAZ_AT[hi + 1]; k++) {
        if (HAZ[k * 5 + 4] == 1.0 && inRect(HAZ, k * 5, x, z)) {
            return RES_WATER;
        }
    }
    return RES_GAP;
}

// a sliding gate's offset and speed along its axis at time t
function blockOff(k: i32, t: f64): f64 {
    let o = k * 8;
    return BLOCK[o + 5] * Math.sin(2.0 * Math.PI * (t + BLOCK[o + 7]) / BLOCK[o + 6]);
}

function blockVel(k: i32, t: f64): f64 {
    let o = k * 8;
    return BLOCK[o + 5] * 2.0 * Math.PI / BLOCK[o + 6] * Math.cos(2.0 * Math.PI * (t + BLOCK[o + 7]) / BLOCK[o + 6]);
}

// a ball: the real one and the demo's planning copy
class Ball {
    x: f64 = 0;
    z: f64 = 0;
    y: f64 = 0;
    vx: f64 = 0;
    vz: f64 = 0;
    vy: f64 = 0;
    vys: f64 = 0;      // the ground's vertical speed under the rolling ball (the last step's)
    air: bool = false;
    rest: f64 = 0;
    slow: f64 = 0;
    incup: bool = false;
    ev: i32 = EV_NONE; // the strongest event of the last step, for sounds
    evMag: f64 = 0;

    reset(x: f64, z: f64): void {
        this.x = x; this.z = z;
        this.vx = 0; this.vz = 0; this.vy = 0; this.vys = 0;
        this.air = false; this.rest = 0; this.slow = 0; this.incup = false;
        this.ev = EV_NONE; this.evMag = 0;
    }

    event(kind: i32, mag: f64): void {
        if (mag > this.evMag) {
            this.ev = kind;
            this.evMag = mag;
        }
    }

    // pushes the ball out along n and bounces the velocity relative to a moving surface
    push(nx: f64, nz: f64, depth: f64, e: f64, vxo: f64, vzo: f64): f64 {
        this.x += nx * depth;
        this.z += nz * depth;
        let rvx = this.vx - vxo, rvz = this.vz - vzo;
        let vn = rvx * nx + rvz * nz;
        if (vn < 0) {
            rvx -= (1 + e) * vn * nx;
            rvz -= (1 + e) * vn * nz;
            this.vx = rvx + vxo;
            this.vz = rvz + vzo;
            return -vn;
        }
        return 0;
    }
}

// one physics substep of hole hi at time t
function stepBall(hi: i32, b: Ball, t: f64): i32 {
    let h0 = height(hi, b.x, b.z);
    if (!b.air) {
        let e = 0.02;
        let gx = (height(hi, b.x + e, b.z) - height(hi, b.x - e, b.z)) / (2 * e);
        let gz = (height(hi, b.x, b.z + e) - height(hi, b.x, b.z - e)) / (2 * e);
        let ax = -G_SLOPE * gx, az = -G_SLOPE * gz;
        let sp = Math.sqrt(b.vx * b.vx + b.vz * b.vz);
        if (sp < 0.06 && Math.sqrt(ax * ax + az * az) < STATIC) {
            b.vx = 0; b.vz = 0;
            b.rest += DT_S;
            return b.rest > 0.15 ? RES_REST : RES_NONE;
        }
        b.rest = 0;
        // held against a wall by a slope: slow for long enough is at rest too
        b.slow = sp < 0.06 ? b.slow + DT_S : 0.0;
        if (b.slow > 0.6) {
            b.vx = 0; b.vz = 0;
            return RES_REST;
        }
        let f = (MU0 + MU1 * sp) * DT_S;
        if (sp > f) {
            b.vx -= b.vx / sp * f;
            b.vz -= b.vz / sp * f;
        } else {
            b.vx = 0; b.vz = 0;
        }
        b.vx += ax * DT_S;
        b.vz += az * DT_S;
        let vyPrev = b.vys;
        let nx = b.x + b.vx * DT_S, nz = b.z + b.vz * DT_S;
        if (!solid(hi, nx, nz)) {
            b.x = nx; b.z = nz;
            b.air = true;
            b.vy = vyPrev;
            b.y = FELT + h0 + R;
        } else {
            let h1 = height(hi, nx, nz);
            if (h1 - h0 < vyPrev * DT_S - 0.5 * G_AIR * DT_S * DT_S - 0.003) {
                b.air = true;     // the ground falls away faster than the ball: it flies
                b.vy = vyPrev;
                b.y = FELT + h0 + R + vyPrev * DT_S;
            } else {
                b.y = FELT + h1 + R;
                b.vys = (h1 - h0) / DT_S;
            }
            b.x = nx; b.z = nz;
        }
    } else {
        b.vy -= G_AIR * DT_S;
        b.x += b.vx * DT_S;
        b.z += b.vz * DT_S;
        b.y += b.vy * DT_S;
        if (solid(hi, b.x, b.z)) {
            let g = FELT + height(hi, b.x, b.z) + R;
            if (b.y <= g) {
                b.y = g;
                if (b.vy < -1.4) {
                    b.event(EV_LAND, -b.vy);
                    b.vy = -b.vy * 0.3;
                    b.vx *= 0.75;     // a hard landing eats speed
                    b.vz *= 0.75;
                } else {
                    b.air = false;
                    b.vy = 0;
                    b.vys = 0;
                }
            }
        } else if (b.y < FELT + R - 0.35) {
            return hazardKind(hi, b.x, b.z);
        }
    }
    collide(hi, b, t);
    // the cup
    if (!b.air) {
        let cx = HOLE[hi * 11 + 5], cz = HOLE[hi * 11 + 6];
        let dx = cx - b.x, dz = cz - b.z;
        let d = Math.sqrt(dx * dx + dz * dz);
        let sp = Math.sqrt(b.vx * b.vx + b.vz * b.vz);
        if (d < CUP_R) {
            if (sp < V_CAPTURE && !b.incup) {
                return RES_HOLED;
            }
            if (!b.incup) {
                b.incup = true;     // one verdict per pass over the cup
                if (sp < V_LIP) {
                    // rims out: turned away from the centre, much slower
                    let cross = b.vx * dz - b.vz * dx;
                    let off = Math.abs(cross) / sp;
                    let ang = 55.0 * Math.PI / 180.0 * (1 - off / CUP_R) * (cross > 0 ? -1.0 : 1.0);
                    let c = Math.cos(ang), s = Math.sin(ang);
                    let vx = (b.vx * c - b.vz * s) * 0.55, vz = (b.vx * s + b.vz * c) * 0.55;
                    b.vx = vx; b.vz = vz;
                    b.event(EV_LIP, sp);
                } else {
                    b.vx *= 0.9;
                    b.vz *= 0.9;
                    b.event(EV_SKIM, sp);
                }
            }
        } else if (d > CUP_R + 0.05) {
            b.incup = false;
        }
        if (!solid(hi, b.x, b.z)) {
            b.air = true;
            b.vy = 0;
        }
    }
    return RES_NONE;
}

function collide(hi: i32, b: Ball, t: f64): void {
    for (let k = WALL_AT[hi]; k < WALL_AT[hi + 1]; k++) {
        let o = k * 4;
        let x0 = WALL[o], z0 = WALL[o + 1];
        let ex = WALL[o + 2] - x0, ez = WALL[o + 3] - z0;
        let l2 = ex * ex + ez * ez;
        let u = Math.min(1.0, Math.max(0.0, ((b.x - x0) * ex + (b.z - z0) * ez) / l2));
        let dx = b.x - (x0 + ex * u), dz = b.z - (z0 + ez * u);
        let d = Math.sqrt(dx * dx + dz * dz);
        let lim = R + WALL_HALF;
        if (d < lim && d > 1e-6) {
            let kk = b.push(dx / d, dz / d, lim - d, E_WALL, 0, 0);
            if (kk > 0.3) {
                b.event(EV_WALL, kk);
            }
        }
    }
    for (let k = POST_AT[hi]; k < POST_AT[hi + 1]; k++) {
        let o = k * 3;
        let dx = b.x - POST[o], dz = b.z - POST[o + 1];
        let d = Math.sqrt(dx * dx + dz * dz);
        let lim = R + POST[o + 2];
        if (d < lim && d > 1e-6) {
            let kk = b.push(dx / d, dz / d, lim - d, E_POST, 0, 0);
            if (kk > 0.3) {
                b.event(EV_POST, kk);
            }
        }
    }
    for (let k = BLOCK_AT[hi]; k < BLOCK_AT[hi + 1]; k++) {
        let o = k * 8;
        let off = blockOff(k, t), vel = blockVel(k, t);
        let alongZ = BLOCK[o + 4] == 1.0;
        let bx = BLOCK[o] + (alongZ ? 0.0 : off), bz = BLOCK[o + 1] + (alongZ ? off : 0.0);
        let bvx = alongZ ? 0.0 : vel, bvz = alongZ ? vel : 0.0;
        let hx = BLOCK[o + 2], hz = BLOCK[o + 3];
        let cx = Math.max(bx - hx, Math.min(bx + hx, b.x));
        let cz = Math.max(bz - hz, Math.min(bz + hz, b.z));
        let dx = b.x - cx, dz = b.z - cz;
        let d = Math.sqrt(dx * dx + dz * dz);
        if (d < R) {
            let nx = 0.0, nz = 0.0, depth = 0.0;
            if (d > 1e-6) {
                nx = dx / d; nz = dz / d; depth = R - d;
            } else {
                let ox = hx - Math.abs(b.x - bx), oz = hz - Math.abs(b.z - bz);
                if (ox < oz) {
                    nx = b.x > bx ? 1.0 : -1.0; depth = ox + R;
                } else {
                    nz = b.z > bz ? 1.0 : -1.0; depth = oz + R;
                }
            }
            let kk = b.push(nx, nz, depth, E_BLOCK, bvx, bvz);
            if (kk > 0.3) {
                b.event(EV_BLOCK, kk);
            }
        }
    }
    if (hi == 0) {
        sails(b, t);
    }
}

// the windmill's sails, turning in the plane in front of its tunnel
function sails(b: Ball, t: f64): void {
    let S = MILL_S * SAIL_SCALE;
    let zb = MILL_Z + 1.16 * MILL_S;
    let hy = FELT + MILL_Y + 1.62 * MILL_S;
    if (Math.abs(b.z - zb) > R + 0.05) {
        return;
    }
    let th = millAngle(t);
    for (let k = 0; k < 4; k++) {
        let phi = (th + 45.0 + 90.0 * <f64>k) * Math.PI / 180.0;
        let dx = Math.cos(phi), dy = Math.sin(phi);
        let nx = -dy, ny = dx;
        let ax = MILL_X + (dx * 0.45 + nx * 0.2) * S;
        let ay = hy + (dy * 0.45 + ny * 0.2) * S;
        let bx = MILL_X + (dx * 1.66 + nx * 0.2) * S;
        let by = hy + (dy * 1.66 + ny * 0.2) * S;
        let ex = bx - ax, ey = by - ay;
        let u = Math.min(1.0, Math.max(0.0, ((b.x - ax) * ex + (b.y - ay) * ey) / (ex * ex + ey * ey)));
        let qx = b.x - (ax + ex * u), qy = b.y - (ay + ey * u);
        if (Math.sqrt(qx * qx + qy * qy) < R + 0.21 * S) {
            let side = b.z > zb ? 1.0 : -1.0;
            b.z = zb + side * (R + 0.06);
            if (b.vz * side < 0) {
                b.event(EV_SAIL, Math.abs(b.vz));
                b.vz = -b.vz * 0.45;
            }
            return;
        }
    }
}

export class Game {
    state: i32 = ST_IDLE;
    st: f64 = 0;             // time in the state
    clock: f64 = 0;          // the obstacles' clock
    wasDemo: bool = false;
    hi: i32 = 0;             // the hole being played
    strokes: i32 = 0;
    card: StaticArray<i32> = new StaticArray<i32>(9);
    best: i32 = 0;
    rounds: i32 = 0;
    started: bool = false;   // a putt was made this round (the hint goes)
    lieX: f64 = 0;           // where the last putt was made from (a hazard brings the ball back here)
    lieZ: f64 = 0;
    ball: Ball = new Ball();
    plan: Ball = new Ball();
    res: i32 = RES_NONE;
    roll: f64 = 0;           // the ball's rolling angle, degrees
    heading: f64 = 0;
    verdict: string = "";
    verdictC: i32 = C_WHITE;
    big: bool = false;
    knockWait: i32 = 0;
    creakStep: i32 = -1;
    powerStep: i32 = 0;

    // the camera's glide
    camX: f64 = 0;
    camZ: f64 = 0;
    fromX: f64 = 0;
    fromZ: f64 = 0;
    toX: f64 = 0;
    toZ: f64 = 0;

    // aiming
    aimAng: f64 = 0;
    aimPow: f64 = 0;
    pressX: f32 = 0;
    pressY: f32 = 0;
    pressWX: f64 = 0;
    pressWZ: f64 = 0;
    curX: f32 = 0;
    curY: f32 = 0;

    // bones
    ballB: i32 = -1;
    sailsB: i32 = -1;
    gateB: StaticArray<i32> = new StaticArray<i32>(2);
    flagB: StaticArray<i32> = new StaticArray<i32>(9);
    sparkB: StaticArray<i32> = new StaticArray<i32>(NSPARK);
    dropB: StaticArray<i32> = new StaticArray<i32>(NDROP);
    cloudB: StaticArray<i32> = new StaticArray<i32>(NCLOUD);
    rippleB: i32 = -1;
    flagLift: f64 = 0;
    flagHop: f64 = 9;

    // effects
    sparkT: f64 = 9;
    sparkN: i32 = 0;
    sparkVX: StaticArray<f64> = new StaticArray<f64>(NSPARK);
    sparkVY: StaticArray<f64> = new StaticArray<f64>(NSPARK);
    sparkVZ: StaticArray<f64> = new StaticArray<f64>(NSPARK);
    fxX: f64 = 0;
    fxY: f64 = 0;
    fxZ: f64 = 0;
    dropT: f64 = 9;
    dropVX: StaticArray<f64> = new StaticArray<f64>(NDROP);
    dropVY: StaticArray<f64> = new StaticArray<f64>(NDROP);
    dropVZ: StaticArray<f64> = new StaticArray<f64>(NDROP);
    dropY0: f64 = 0;
    rippleOn: bool = false;

    // the demo
    dWait: f64 = 0;
    dPhase: i32 = 0;         // 0 waiting, 1 planning, 2 aiming
    dK: i32 = 0;
    dBestC: StaticArray<f64> = new StaticArray<f64>(6);
    dBestA: StaticArray<f64> = new StaticArray<f64>(6);
    dBestP: StaticArray<f64> = new StaticArray<f64>(6);
    dAng: f64 = 0;
    dPow: f64 = 0;
    dRelease: f64 = 0;
    dFirst: bool = true;
    field: StaticArray<f32> = new StaticArray<f32>(GMAX);
    fx0: f64 = 0;
    fz0: f64 = 0;
    fnx: i32 = 0;
    fnz: i32 = 0;
    fieldHole: i32 = -1;

    start(api: GameApi): void {
        api.playable = true;
        this.ballB = api.bone("ball");
        this.sailsB = api.bone("sails");
        this.rippleB = api.bone("ripple");
        for (let i = 0; i < 2; i++) {
            this.gateB[i] = api.bone("gate" + i.toString());
        }
        for (let i = 0; i < 9; i++) {
            this.flagB[i] = api.bone("flag" + i.toString());
        }
        for (let i = 0; i < NSPARK; i++) {
            this.sparkB[i] = api.bone("spark" + i.toString());
        }
        for (let i = 0; i < NDROP; i++) {
            this.dropB[i] = api.bone("drop" + i.toString());
        }
        for (let i = 0; i < NCLOUD; i++) {
            this.cloudB[i] = api.bone("cloudlet" + i.toString());
        }
        this.wasDemo = api.demo;
        this.newRound(api);
        this.camX = this.toX;
        this.camZ = this.toZ;
        this.state = ST_IDLE;
        this.st = 0;
    }

    // ---------------------------------------------------------------- the round

    newRound(api: GameApi): void {
        for (let i = 0; i < 9; i++) {
            this.card[i] = 0;
        }
        this.started = false;
        this.dFirst = true;
        this.beginHole(api, 0);
        this.fromX = this.camX;
        this.fromZ = this.camZ;
    }

    beginHole(api: GameApi, hi: i32): void {
        this.hi = hi;
        this.strokes = 0;
        this.lieX = HOLE[hi * 11 + 3];
        this.lieZ = HOLE[hi * 11 + 4];
        this.ball.reset(this.lieX, this.lieZ);
        this.ball.y = FELT + height(hi, this.lieX, this.lieZ) + R;
        this.flagLift = 0;
        this.holeTarget(hi);
        this.dPhase = 0;
        this.dWait = this.dFirst ? 0.15 : 0.7;
    }

    // the camera frames the hole's felt (the mill's hole a little further north for its roof)
    holeTarget(hi: i32): void {
        let x0 = 1e9, z0 = 1e9, x1 = -1e9, z1 = -1e9;
        for (let k = FELT_AT[hi]; k < FELT_AT[hi + 1]; k++) {
            x0 = Math.min(x0, FELTR[k * 4]); z0 = Math.min(z0, FELTR[k * 4 + 1]);
            x1 = Math.max(x1, FELTR[k * 4 + 2]); z1 = Math.max(z1, FELTR[k * 4 + 3]);
        }
        this.toX = (x0 + x1) * 0.5;
        this.toZ = (z0 + z1) * 0.5 + (hi == 0 ? -1.6 : 0.15);
    }

    // ---------------------------------------------------------------- update

    update(api: GameApi): void {
        let dt = api.dt;
        if (api.demoChanged || api.demo != this.wasDemo) {
            this.wasDemo = api.demo;
            this.newRound(api);
            this.camX = this.toX;     // a fresh round where it starts: no glide
            this.camZ = this.toZ;
            this.state = ST_IDLE;
            this.st = 0;
            this.hideFx(api);
        }
        this.clock += dt;
        this.st += dt;
        this.sparkT += dt;
        this.dropT += dt;
        this.flagHop += dt;
        if (this.knockWait > 0) {
            this.knockWait--;
        }
        let st = this.state;
        if (st == ST_ROLL) {
            this.physics(api, dt);
        } else if (st == ST_SINK) {
            if (this.st > 0.45) {
                this.endHole(api, false);
            }
        } else if (st == ST_CHEER) {
            if (this.st > 1.6) {
                if (this.hi >= 8) {
                    this.finishRound(api);
                } else {
                    this.state = ST_GLIDE;
                    this.st = 0;
                    this.fromX = this.camX;
                    this.fromZ = this.camZ;
                    this.beginHole(api, this.hi + 1);
                    api.sound(SFX_WHOOSH, 0.8, 0.35);
                }
            }
        } else if (st == ST_HAZARD) {
            if (this.st > 1.2) {
                if (this.strokes >= MAX_STROKES) {
                    this.endHole(api, true);
                } else {
                    this.ball.reset(this.lieX, this.lieZ);
                    this.ball.y = FELT + height(this.hi, this.lieX, this.lieZ) + R;
                    this.state = ST_IDLE;
                    this.st = 0;
                    this.dPhase = 0;
                    this.dWait = 0.5;
                    api.soundAt(SFX_POP, this.lieX, this.ball.y, this.lieZ, 1.2, 0.5);
                }
            }
        } else if (st == ST_GLIDE) {
            let u = smooth01(this.st / 1.3);
            this.camX = this.fromX + (this.toX - this.fromX) * u;
            this.camZ = this.fromZ + (this.toZ - this.fromZ) * u;
            if (this.st >= 1.3) {
                this.camX = this.toX;
                this.camZ = this.toZ;
                this.state = ST_IDLE;
                this.st = 0;
                api.soundAt(SFX_POP, this.ball.x, this.ball.y, this.ball.z, 1.0, 0.5);
            }
        } else if (st == ST_OVER) {
            if (api.demo && this.st > 2.2) {
                this.restart(api);
            }
        }
        if (api.demo) {
            this.demo(api, dt);
        }
        this.camera(api);
        this.draw(api, dt);
        this.creak(api);
    }

    restart(api: GameApi): void {
        this.fromX = this.camX;
        this.fromZ = this.camZ;
        this.newRound(api);
        this.state = ST_GLIDE;
        this.st = 0;
        api.sound(SFX_WHOOSH, 0.7, 0.35);
    }

    camera(api: GameApi): void {
        api.useTarget = true;
        api.targetX = this.camX;
        api.targetY = 0.4;
        api.targetZ = this.camZ;
    }

    physics(api: GameApi, dt: f64): void {
        let n = <i32>Math.round(dt / DT_S);
        let b = this.ball;
        let t0 = this.clock - dt;
        for (let i = 0; i < n; i++) {
            b.ev = EV_NONE;
            b.evMag = 0;
            let ox = b.x, oz = b.z;
            let r = stepBall(this.hi, b, t0 + <f64>i * DT_S);
            this.roll += Math.sqrt((b.x - ox) * (b.x - ox) + (b.z - oz) * (b.z - oz)) / R * 57.2958;
            if (b.ev != EV_NONE) {
                this.eventSound(api, b.ev, b.evMag);
            }
            if (r != RES_NONE) {
                this.settle(api, r);
                return;
            }
        }
        let sp = Math.sqrt(b.vx * b.vx + b.vz * b.vz);
        if (sp > 0.05) {
            this.heading = Math.atan2(b.vx, b.vz) * 57.2958;
        }
        if (this.st > 16.0) {
            this.settle(api, RES_REST);
        }
    }

    settle(api: GameApi, r: i32): void {
        let b = this.ball;
        if (r == RES_HOLED) {
            this.state = ST_SINK;
            this.st = 0;
            let cx = HOLE[this.hi * 11 + 5], cz = HOLE[this.hi * 11 + 6];
            let cy = FELT + height(this.hi, cx, cz);
            // the rattle on the rim, then the drop
            api.soundAt(SFX_TICK, cx, cy, cz, 1.6, 0.8);
            api.soundAt(SFX_TICK, cx, cy, cz, 1.35, 0.7, 0.06);
            api.soundAt(SFX_TICK, cx, cy, cz, 1.15, 0.6, 0.11);
            api.soundAt(SFX_THUD, cx, cy, cz, 1.7, 0.9, 0.2);
            api.soundAt(SFX_CLICK, cx, cy, cz, 0.7, 0.5, 0.22);
            return;
        }
        if (r == RES_WATER || r == RES_GAP) {
            this.strokes++;
            this.state = ST_HAZARD;
            this.st = 0;
            this.res = r;
            // the splash lands a little on along the ball's path (clear of a bank or the bridge)
            let sp = Math.sqrt(b.vx * b.vx + b.vz * b.vz);
            let ux = sp > 0.01 ? b.vx / sp : 0.0, uz = sp > 0.01 ? b.vz / sp : 0.0;
            this.fxX = b.x + ux * 0.35;
            this.fxZ = b.z + uz * 0.35;
            let o = this.hi * 11 + 7;
            if (HOLE[o + 2] != 0.0 && this.fxX > HOLE[o] && this.fxX < HOLE[o + 2]) {
                // off the bridge's side: into the brook beside it, not under the deck
                let mz = (HOLE[o + 1] + HOLE[o + 3]) * 0.5, hz = (HOLE[o + 3] - HOLE[o + 1]) * 0.5 + 0.45;
                if (Math.abs(this.fxZ - mz) < hz) {
                    this.fxZ = mz + (this.fxZ > mz ? hz : -hz);
                }
            }
            if (r == RES_WATER) {
                this.fxY = FELT - 0.2;
                this.verdict = "SPLASH! +1";
                api.soundAt(SFX_SPLASH, b.x, this.fxY, b.z, 1.0, 0.9);
                api.soundAt(SFX_SPLASH, b.x, this.fxY, b.z, 1.4, 0.4, 0.12);
            } else {
                this.fxY = -1.2;
                this.verdict = "INTO THE CLOUDS! +1";
                api.soundAt(SFX_SHOOT, b.x, b.y, b.z, 0.45, 0.6);
                api.soundAt(SFX_WHOOSH, b.x, -1.0, b.z, 0.6, 0.5, 0.35);
            }
            this.verdictC = C_PEACH;
            this.burstDrops(api, r == RES_WATER);
            return;
        }
        // at rest
        if (this.strokes >= MAX_STROKES) {
            this.endHole(api, true);
            return;
        }
        this.state = ST_IDLE;
        this.st = 0;
        this.dPhase = 0;
        this.dWait = 0.35;
    }

    endHole(api: GameApi, pickedUp: bool): void {
        let par = <i32>HOLE[this.hi * 11 + 2];
        let s = this.strokes;
        if (pickedUp) {
            s = MAX_STROKES;
        }
        this.card[this.hi] = s;
        this.state = ST_CHEER;
        this.st = 0;
        this.flagHop = 0;
        let cx = HOLE[this.hi * 11 + 5], cz = HOLE[this.hi * 11 + 6];
        let cy = FELT + height(this.hi, cx, cz);
        let pan = api.panAt(cx, cy, cz);
        this.big = false;
        if (pickedUp) {
            this.verdict = "PICKED UP: 6";
            this.verdictC = C_PEACH;
            api.note(60, 0.5, pan, SFX_NOTE);
            api.note(55, 0.5, pan, SFX_NOTE, 0.16);
            return;
        }
        let d = s - par;
        if (s == 1) {
            this.verdict = "HOLE IN ONE!";
            this.verdictC = C_YELLOW;
            this.big = true;
            this.burstSparks(api, cx, cy, cz, NSPARK);
            api.sound(SFX_WIN, 1.0, 0.8);
            let mel: StaticArray<f64> = [72, 76, 79, 84, 79, 84, 88];
            for (let i = 0; i < 7; i++) {
                api.note(mel[i], 0.55, 0, SFX_NOTE, 0.1 + <f64>i * 0.11);
            }
            api.note(84, 0.45, 0, SFX_BELL, 0.9);
        } else if (d <= -2) {
            this.verdict = "EAGLE!";
            this.verdictC = C_YELLOW;
            this.big = true;
            this.burstSparks(api, cx, cy, cz, 8);
            api.sound(SFX_POWERUP, 1.0, 0.6);
            api.note(76, 0.5, pan, SFX_NOTE, 0.1);
            api.note(79, 0.5, pan, SFX_NOTE, 0.2);
            api.note(84, 0.5, pan, SFX_BELL, 0.3);
        } else if (d == -1) {
            this.verdict = "BIRDIE!";
            this.verdictC = C_LIME;
            this.burstSparks(api, cx, cy, cz, 6);
            api.note(76, 0.55, pan, SFX_NOTE, 0.05);
            api.note(83, 0.55, pan, SFX_NOTE, 0.17);
            api.note(88, 0.35, pan, SFX_BELL, 0.3);
        } else if (d == 0) {
            this.verdict = "PAR";
            this.verdictC = C_WHITE;
            api.note(72, 0.5, pan, SFX_NOTE, 0.05);
            api.note(79, 0.5, pan, SFX_NOTE, 0.18);
        } else if (d == 1) {
            this.verdict = "BOGEY";
            this.verdictC = C_PEACH;
            api.note(67, 0.45, pan, SFX_NOTE, 0.05);
            api.note(64, 0.45, pan, SFX_NOTE, 0.2);
        } else {
            this.verdict = d == 2 ? "DOUBLE BOGEY" : "+" + d.toString();
            this.verdictC = C_PINK;
            api.note(62, 0.45, pan, SFX_NOTE, 0.05);
            api.note(57, 0.45, pan, SFX_NOTE, 0.22);
        }
    }

    finishRound(api: GameApi): void {
        this.state = ST_OVER;
        this.st = 0;
        let tot = this.total();
        let newBest = this.best == 0 || tot < this.best;
        if (newBest) {
            this.best = tot;
        }
        this.rounds++;
        // the round-end jingle: a little tune in C, brighter for a good round
        let good = tot <= 26;
        let mel: StaticArray<f64> = good ? [72, 76, 79, 84, 83, 84, 88, 91] : [72, 74, 76, 72, 67, 69, 71, 72];
        for (let i = 0; i < 8; i++) {
            api.note(mel[i], 0.5, 0, SFX_NOTE, <f64>i * 0.13 + (i == 7 ? 0.1 : 0.0));
        }
        api.note(good ? 60 : 48, 0.35, 0, SFX_BELL, 1.05);
        if (newBest && this.rounds > 1) {
            api.sound(SFX_POWERUP, 1.0, 0.6, 0, 1.3);
        } else if (good) {
            api.sound(SFX_WIN, 1.0, 0.6, 0, 1.2);
        }
    }

    total(): i32 {
        let t = 0;
        for (let i = 0; i < 9; i++) {
            t += this.card[i];
        }
        return t;
    }

    parSoFar(): i32 {
        let t = 0;
        for (let i = 0; i < 9; i++) {
            if (this.card[i] > 0) {
                t += <i32>HOLE[i * 11 + 2];
            }
        }
        return t;
    }

    // ---------------------------------------------------------------- putting

    putt(api: GameApi, ang: f64, p: f64): void {
        let b = this.ball;
        let sp = powerSpeed(p);
        b.vx = Math.cos(ang) * sp;
        b.vz = Math.sin(ang) * sp;
        b.vy = 0; b.vys = 0; b.air = false; b.rest = 0; b.slow = 0; b.incup = false;
        this.lieX = b.x;
        this.lieZ = b.z;
        this.strokes++;
        this.started = true;
        this.state = ST_ROLL;
        this.st = 0;
        this.heading = Math.atan2(b.vx, b.vz) * 57.2958;
        // the putter's tock: brighter and louder with the power, a low body under a hard one
        api.soundAt(SFX_CLICK, b.x, b.y, b.z, 0.55 + 0.7 * p, 0.45 + 0.5 * p);
        api.soundAt(SFX_THUD, b.x, b.y, b.z, 2.2 - 0.6 * p, 0.25 + 0.5 * p);
        if (p > 0.75) {
            api.soundAt(SFX_WHOOSH, b.x, b.y, b.z, 1.4, 0.25, 0.04);
        }
    }

    eventSound(api: GameApi, ev: i32, mag: f64): void {
        let b = this.ball;
        if (ev == EV_LIP) {
            // the cup's rattle: the ball rims round and out
            api.soundAt(SFX_TICK, b.x, b.y, b.z, 1.7, 0.8);
            api.soundAt(SFX_TICK, b.x, b.y, b.z, 1.45, 0.7, 0.05);
            api.soundAt(SFX_TICK, b.x, b.y, b.z, 1.8, 0.6, 0.1);
            api.soundAt(SFX_CLICK, b.x, b.y, b.z, 1.3, 0.4, 0.14);
            return;
        }
        if (ev == EV_SKIM) {
            api.soundAt(SFX_TICK, b.x, b.y, b.z, 2.0, 0.5);
            return;
        }
        if (this.knockWait > 0) {
            return;
        }
        this.knockWait = 4;
        let v = Math.min(1.0, mag / 6.0);
        if (ev == EV_WALL) {
            // a wooden knock: higher and louder the harder
            api.soundAt(SFX_THUD, b.x, b.y, b.z, 1.7 + 0.8 * v, 0.3 + 0.6 * v);
            api.soundAt(SFX_CLICK, b.x, b.y, b.z, 0.5 + 0.4 * v, 0.25 + 0.4 * v);
        } else if (ev == EV_POST) {
            api.soundAt(SFX_BLIP, b.x, b.y, b.z, 0.9 + 0.5 * v, 0.35 + 0.4 * v);
            api.soundAt(SFX_POP, b.x, b.y, b.z, 0.8, 0.3 + 0.3 * v);
        } else if (ev == EV_BLOCK) {
            api.soundAt(SFX_THUD, b.x, b.y, b.z, 1.1 + 0.4 * v, 0.4 + 0.5 * v);
        } else if (ev == EV_SAIL) {
            api.soundAt(SFX_HIT, b.x, b.y, b.z, 0.9, 0.35 + 0.4 * v);
            api.soundAt(SFX_THUD, b.x, b.y, b.z, 1.3, 0.4);
        } else if (ev == EV_LAND) {
            api.soundAt(SFX_THUD, b.x, b.y, b.z, 1.0 + 0.3 * v, 0.5 + 0.4 * v);
        }
    }

    // the windmill creaks each time a sail swings past its tunnel, louder when it is in view
    creak(api: GameApi): void {
        let q = <i32>Math.floor(millAngle(this.clock) / 45.0);
        if (q == this.creakStep) {
            return;
        }
        let first = this.creakStep < 0;
        this.creakStep = q;
        if (first) {
            return;
        }
        let dx = this.camX - MILL_X, dz = this.camZ - MILL_Z;
        let near = Math.max(0.0, 1.0 - Math.sqrt(dx * dx + dz * dz) / 16.0);
        if (near <= 0.05) {
            return;
        }
        let hy = FELT + MILL_Y + 1.6 * MILL_S;
        if (q % 2 == 0) {
            api.soundAt(SFX_TICK, MILL_X, hy, MILL_Z, 0.42, 0.55 * near);
            api.soundAt(SFX_TICK, MILL_X, hy, MILL_Z, 0.36, 0.35 * near, 0.07);
        } else {
            api.soundAt(SFX_TICK, MILL_X, hy, MILL_Z, 0.5, 0.25 * near);
        }
    }

    // ---------------------------------------------------------------- the pointer

    pointer(api: GameApi, kind: i32, x: f32, y: f32): bool {
        if (this.state == ST_OVER) {
            if (kind == POINTER_DOWN && this.st > 0.8) {
                this.restart(api);
                api.sound(SFX_BLIP, 1.2, 0.5);
            }
            return true;
        }
        if (kind == POINTER_DOWN) {
            if (this.state == ST_IDLE) {
                // a press anywhere starts the aim (on a phone the ball is too small to hit)
                this.state = ST_AIM;
                this.st = 0;
                this.pressX = x;
                this.pressY = y;
                this.curX = x;
                this.curY = y;
                this.aimPow = 0;
                this.powerStep = 0;
                let b = this.ball;
                api.soundAt(SFX_CLICK, b.x, b.y, b.z, 1.5, 0.2);
            }
            return true;
        }
        if (this.state != ST_AIM) {
            return true;
        }
        this.curX = x;
        this.curY = y;
        this.updateAim(api);
        if (kind == POINTER_UP) {
            if (this.aimPow < 0.03) {
                this.state = ST_IDLE;   // too short a pull: no putt
                this.st = 0;
            } else {
                this.putt(api, this.aimAng, this.aimPow);
            }
        }
        return true;
    }

    // the aim from the drag: the putt goes against it, its screen length is the power
    updateAim(api: GameApi): void {
        let dx = this.curX - this.pressX, dy = this.curY - this.pressY;
        let len = Mathf.sqrt(dx * dx + dy * dy);
        let p = <f64>Mathf.min(1, len / DRAG_FULL);
        let b = this.ball;
        let gy = <f32>(b.y - R);
        if (len > 1.5 && api.pick(this.pressX, this.pressY, gy)) {
            let ax = <f64>api.hitX, az = <f64>api.hitZ;
            if (api.pick(this.curX, this.curY, gy)) {
                let wx = ax - <f64>api.hitX, wz = az - <f64>api.hitZ;
                if (wx * wx + wz * wz > 1e-6) {
                    this.aimAng = Math.atan2(wz, wx);
                }
            }
        }
        this.aimPow = p;
        let step = <i32>(p * 10.0);
        if (step != this.powerStep) {
            if (step > this.powerStep) {
                api.soundAt(SFX_TICK, b.x, b.y, b.z, 0.9 + 0.12 * <f64>step, 0.18);
            }
            this.powerStep = step;
        }
    }

    // ---------------------------------------------------------------- the demo player

    demo(api: GameApi, dt: f64): void {
        if (this.state == ST_OVER || this.state == ST_GLIDE) {
            return;
        }
        if (this.state != ST_IDLE && this.state != ST_AIM) {
            return;
        }
        if (this.dPhase == 0) {
            this.dWait -= dt;
            if (this.dWait > 0) {
                return;
            }
            if (this.dFirst && this.hi == 0 && this.strokes == 0) {
                // the round's first putt is a known line: straight up the deck into the mill's tunnel
                this.dFirst = false;
                this.dAng = -Math.PI / 2 + 0.01;
                this.dPow = 0.56;
                this.dRelease = this.clock + 0.45;
                this.startDemoAim(api);
                return;
            }
            this.dFirst = false;
            if (this.fieldHole != this.hi) {
                this.buildField(this.hi);
            }
            this.dPhase = 1;
            this.dK = 0;
            for (let i = 0; i < 6; i++) {
                this.dBestC[i] = 1e9;
            }
            this.dRelease = this.clock + 1.3;
            return;
        }
        if (this.dPhase == 1) {
            this.planStep(api);
            return;
        }
        // aiming: the virtual pointer pulls back to the planned power, then lets go
        let total = Math.max(0.2, this.dRelease - this.dAimFrom);
        let u = Math.min(1.0, (this.clock - this.dAimFrom) / total);
        let p = this.dPow * smooth01(u * 1.25);
        this.aimAng = this.dAng;
        this.aimPow = p;
        // where the virtual finger is (HUD), for the drawing
        let b = this.ball;
        if (api.project(<f32>b.x, <f32>(b.y - R), <f32>b.z)) {
            let bx = api.screenX, by = api.screenY;
            if (api.project(<f32>(b.x - Math.cos(this.dAng)), <f32>(b.y - R), <f32>(b.z - Math.sin(this.dAng)))) {
                let ex = api.screenX - bx, ey = api.screenY - by;
                let el = Mathf.sqrt(ex * ex + ey * ey);
                if (el > 0.001) {
                    this.pressX = bx;
                    this.pressY = by;
                    this.curX = bx + ex / el * <f32>p * DRAG_FULL;
                    this.curY = by + ey / el * <f32>p * DRAG_FULL;
                }
            }
        }
        if (this.clock >= this.dRelease) {
            this.dPhase = 0;
            this.putt(api, this.dAng, this.dPow);
        }
    }

    dAimFrom: f64 = 0;
    planSteps: i32 = 0;

    startDemoAim(api: GameApi): void {
        this.dPhase = 2;
        this.dAimFrom = this.clock;
        this.state = ST_AIM;
        this.st = 0;
        this.aimPow = 0;
    }

    // a slice of the search: coarse candidates (36 directions x 8 powers), then the six best judged
    // by their mean cost over four nudged copies (a person picks a shot that still works when off)
    planStep(api: GameApi): void {
        let b = this.ball;
        let t0 = this.dRelease;
        this.planSteps = 0;
        // out of time: settle for the best so far (the release keeps its clock for the obstacles)
        let late = this.clock > this.dRelease - 0.25;
        while (this.planSteps < PLAN_STEPS) {
            let k = this.dK;
            if (late && k < 36 * NPOW + 24) {
                k = 36 * NPOW + 24;
                for (let i = 0; i < 6; i++) {
                    this.dBestC[i] *= 5.0;    // judged by the coarse cost alone
                }
                this.dK = k;
            }
            if (k < 36 * NPOW) {
                let a = <f64>(k / NPOW) * Math.PI * 2.0 / 36.0;
                let p = POWS[k % NPOW];
                let c = this.tryShot(b.x, b.z, a, p, t0);
                // keep the six best
                let j = 5;
                if (c < this.dBestC[5]) {
                    while (j > 0 && this.dBestC[j - 1] > c) {
                        this.dBestC[j] = this.dBestC[j - 1];
                        this.dBestA[j] = this.dBestA[j - 1];
                        this.dBestP[j] = this.dBestP[j - 1];
                        j--;
                    }
                    this.dBestC[j] = c;
                    this.dBestA[j] = a;
                    this.dBestP[j] = p;
                }
            } else if (k < 36 * NPOW + 24) {
                let i = (k - 36 * NPOW) / 4, m = (k - 36 * NPOW) % 4;
                let a = this.dBestA[i], p = this.dBestP[i];
                let sa = AIM_SD0 + AIM_SD1 * p;
                if (m == 0) { a += sa; } else if (m == 1) { a -= sa; } else if (m == 2) { p *= 1 + POW_SD; } else { p *= 1 - POW_SD; }
                this.dBestC[i] += this.tryShot(b.x, b.z, a, p, t0);
            } else {
                let best = 0;
                for (let i = 1; i < 6; i++) {
                    if (this.dBestC[i] < this.dBestC[best]) {
                        best = i;
                    }
                }
                // the hand: a little off in aim and power
                let p = this.dBestP[best];
                this.dAng = this.dBestA[best] + this.gauss(api) * (AIM_SD0 + AIM_SD1 * p);
                this.dPow = Math.max(0.04, Math.min(1.0, p * (1 + this.gauss(api) * POW_SD)));
                this.startDemoAim(api);
                return;
            }
            this.dK++;
        }
    }

    gauss(api: GameApi): f64 {
        return (api.rand() + api.rand() + api.rand() + api.rand() - 2.0) * 1.732;
    }

    tryShot(x: f64, z: f64, a: f64, p: f64, t0: f64): f64 {
        let s = this.plan;
        s.reset(x, z);
        s.y = FELT + height(this.hi, x, z) + R;
        let sp = powerSpeed(p);
        s.vx = Math.cos(a) * sp;
        s.vz = Math.sin(a) * sp;
        let t = t0;
        let r = RES_REST;
        for (let i = 0; i < 1920; i++) {
            let q = stepBall(this.hi, s, t);
            t += DT_S;
            this.planSteps++;
            if (q != RES_NONE) {
                r = q;
                break;
            }
        }
        if (r == RES_HOLED) {
            return 1.0;
        }
        if (r == RES_WATER || r == RES_GAP) {
            return 2.0 + moreStrokes(this.fdist(x, z));
        }
        return 1.0 + moreStrokes(this.fdist(s.x, s.z));
    }

    // the path distance from the cup over the walkable felt (relaxed 8-neighbour sweeps)
    buildField(hi: i32): void {
        let x0 = 1e9, z0 = 1e9, x1 = -1e9, z1 = -1e9;
        for (let k = FELT_AT[hi]; k < FELT_AT[hi + 1]; k++) {
            x0 = Math.min(x0, FELTR[k * 4]); z0 = Math.min(z0, FELTR[k * 4 + 1]);
            x1 = Math.max(x1, FELTR[k * 4 + 2]); z1 = Math.max(z1, FELTR[k * 4 + 3]);
        }
        let nx = <i32>((x1 - x0) / GRID) + 1, nz = <i32>((z1 - z0) / GRID) + 1;
        if (nx * nz > GMAX) {
            nz = GMAX / nx;
        }
        this.fx0 = x0; this.fz0 = z0; this.fnx = nx; this.fnz = nz;
        this.fieldHole = hi;
        let INF: f32 = 1e9;
        for (let j = 0; j < nz; j++) {
            for (let i = 0; i < nx; i++) {
                let px = x0 + (<f64>i + 0.5) * GRID, pz = z0 + (<f64>j + 0.5) * GRID;
                let ok = solid(hi, px, pz);
                if (ok) {
                    for (let k = WALL_AT[hi]; k < WALL_AT[hi + 1]; k++) {
                        let o = k * 4;
                        let ex = WALL[o + 2] - WALL[o], ez = WALL[o + 3] - WALL[o + 1];
                        let u = Math.min(1.0, Math.max(0.0, ((px - WALL[o]) * ex + (pz - WALL[o + 1]) * ez) / (ex * ex + ez * ez)));
                        let qx = px - WALL[o] - ex * u, qz = pz - WALL[o + 1] - ez * u;
                        if (Math.sqrt(qx * qx + qz * qz) < WALL_HALF + 0.12) {
                            ok = false;
                            break;
                        }
                    }
                }
                if (ok) {
                    for (let k = POST_AT[hi]; k < POST_AT[hi + 1]; k++) {
                        let qx = px - POST[k * 3], qz = pz - POST[k * 3 + 1];
                        if (Math.sqrt(qx * qx + qz * qz) < POST[k * 3 + 2] + 0.12) {
                            ok = false;
                        }
                    }
                }
                this.field[j * nx + i] = ok ? INF : -1;
            }
        }
        let ci = <i32>((HOLE[hi * 11 + 5] - x0) / GRID), cj = <i32>((HOLE[hi * 11 + 6] - z0) / GRID);
        this.field[cj * nx + ci] = 0;
        let g = <f32>GRID, gd = <f32>(GRID * 1.414);
        for (let it = 0; it < 80; it++) {
            let changed = false;
            for (let pass = 0; pass < 2; pass++) {
                for (let jj = 0; jj < nz; jj++) {
                    let j = pass == 0 ? jj : nz - 1 - jj;
                    for (let ii = 0; ii < nx; ii++) {
                        let i = pass == 0 ? ii : nx - 1 - ii;
                        let v = this.field[j * nx + i];
                        if (v < 0) {
                            continue;
                        }
                        let best = v;
                        for (let dj = -1; dj <= 1; dj++) {
                            for (let di = -1; di <= 1; di++) {
                                if (di == 0 && dj == 0) {
                                    continue;
                                }
                                let a = i + di, c = j + dj;
                                if (a < 0 || c < 0 || a >= nx || c >= nz) {
                                    continue;
                                }
                                let w = this.field[c * nx + a];
                                if (w < 0) {
                                    continue;
                                }
                                let cand = w + ((di != 0 && dj != 0) ? gd : g);
                                if (cand < best) {
                                    best = cand;
                                }
                            }
                        }
                        if (best < v) {
                            this.field[j * nx + i] = best;
                            changed = true;
                        }
                    }
                }
            }
            if (!changed) {
                break;
            }
        }
    }

    fdist(x: f64, z: f64): f64 {
        let i = <i32>Math.floor((x - this.fx0) / GRID), j = <i32>Math.floor((z - this.fz0) / GRID);
        if (i >= 0 && j >= 0 && i < this.fnx && j < this.fnz) {
            let v = this.field[j * this.fnx + i];
            if (v >= 0 && v < 1e8) {
                return <f64>v;
            }
        }
        return 30.0;
    }

    // ---------------------------------------------------------------- effects

    burstSparks(api: GameApi, x: f64, y: f64, z: f64, n: i32): void {
        this.sparkT = 0;
        this.sparkN = n;
        this.fxX = x; this.fxY = y + 0.15; this.fxZ = z;
        for (let i = 0; i < NSPARK; i++) {
            let a = <f64>i * 2.399 + 0.3;      // the golden angle: an even spray, no random needed
            let s = 1.2 + 0.5 * <f64>(i % 3);
            this.sparkVX[i] = Math.cos(a) * s;
            this.sparkVZ[i] = Math.sin(a) * s;
            this.sparkVY[i] = 3.6 + 0.4 * <f64>(i % 4);
        }
        api.soundAt(SFX_POP, x, y, z, 1.4, 0.4);
    }

    burstDrops(api: GameApi, water: bool): void {
        this.dropT = 0;
        this.dropY0 = this.fxY;
        this.rippleOn = water;
        for (let i = 0; i < NDROP; i++) {
            let a = <f64>i * 2.399 + 0.7;
            let s = water ? 0.9 + 0.3 * <f64>(i % 2) : 0.5;
            this.dropVX[i] = Math.cos(a) * s;
            this.dropVZ[i] = Math.sin(a) * s;
            this.dropVY[i] = water ? 2.6 + 0.5 * <f64>(i % 3) : 1.2 + 0.3 * <f64>(i % 3);
        }
    }

    hideFx(api: GameApi): void {
        this.sparkT = 9;
        this.dropT = 9;
        for (let i = 0; i < NSPARK; i++) {
            api.hide(this.sparkB[i]);
        }
        for (let i = 0; i < NDROP; i++) {
            api.hide(this.dropB[i]);
        }
        api.hide(this.rippleB);
    }

    // ---------------------------------------------------------------- placing the bones

    draw(api: GameApi, dt: f64): void {
        let t = this.clock;
        // the windmill's sails, stepped at 12 fps
        api.place(this.sailsB, MILL_X, FELT + MILL_Y + 1.62 * MILL_S, MILL_Z + 1.16 * MILL_S, 0, 0, millAngle(t), SAIL_SCALE);
        // the sliding gates (hole 4)
        for (let k = 0; k < 2; k++) {
            let g = BLOCK_AT[3] + k;
            let o = g * 8;
            let alongZ = BLOCK[o + 4] == 1.0;
            let off = blockOff(g, t);
            let bx = BLOCK[o] + (alongZ ? 0.0 : off), bz = BLOCK[o + 1] + (alongZ ? off : 0.0);
            api.place(this.gateB[k], bx, FELT + height(3, bx, bz) - 0.02, bz);
        }
        // the flags: each waves on its own beat; this hole's lifts out of the cup as the ball nears
        let b = this.ball;
        let cx = HOLE[this.hi * 11 + 5], cz = HOLE[this.hi * 11 + 6];
        let dcx = b.x - cx, dcz = b.z - cz;
        let near = (this.state == ST_ROLL || this.state == ST_SINK) && Math.sqrt(dcx * dcx + dcz * dcz) < 2.2;
        let want = near ? 0.85 : 0.0;
        if (this.state == ST_CHEER) {
            want = 0.0;
        }
        this.flagLift += (want - this.flagLift) * Math.min(1.0, dt * 7.0);
        for (let i = 0; i < 9; i++) {
            let fx = HOLE[i * 11 + 5], fz = HOLE[i * 11 + 6];
            let fy = FELT + height(i, fx, fz);
            let wave = stepped(Math.sin(t * 1.7 + <f64>i * 1.3) * 14.0, 7.0);
            let lift = 0.0, spin = 0.0;
            if (i == this.hi) {
                lift = stepped(this.flagLift, 0.08);
                if (this.state == ST_CHEER && this.flagHop < 0.9) {
                    let u = this.flagHop / 0.9;
                    lift += Math.sin(u * Math.PI) * (this.big ? 0.9 : 0.45);
                    spin = stepped(u * 360.0, 30.0);
                }
            }
            api.place(this.flagB[i], fx, fy + lift, fz, wave + spin);
        }
        // drifting clouds round the island
        for (let i = 0; i < NCLOUD; i++) {
            let span = 52.0;
            let x = -26.0 + ((t * (0.35 + 0.12 * <f64>i) + <f64>i * 17.0) % span);
            let y = i == 0 ? 1.8 : (i == 1 ? -3.2 : -1.6);
            let z = i == 0 ? -15.0 : (i == 1 ? 14.5 : 15.5);
            api.place(this.cloudB[i], stepped(x, 0.06), y, z, <f64>i * 40.0, 0, 0, i == 2 ? 0.7 : 1.0);
        }
        this.drawBall(api);
        this.drawFx(api);
    }

    drawBall(api: GameApi): void {
        let b = this.ball;
        let st = this.state;
        if (st == ST_GLIDE) {
            if (this.st < 1.1) {
                api.hide(this.ballB);
                return;
            }
            // pops onto the tee as the camera settles
            let u = (this.st - 1.1) / 0.2;
            let s = 0.4 + 0.6 * Math.min(1.0, u);
            api.placeScaled(this.ballB, b.x, b.y + 0.12 * Math.sin(Math.min(1.0, u) * Math.PI), b.z, 0, s, s, s);
            return;
        }
        if (st == ST_OVER) {
            api.hide(this.ballB);
            return;
        }
        if (st == ST_SINK) {
            let cx = HOLE[this.hi * 11 + 5], cz = HOLE[this.hi * 11 + 6];
            let cy = FELT + height(this.hi, cx, cz);
            let u = Math.min(1.0, this.st / 0.35);
            let x = b.x + (cx - b.x) * Math.min(1.0, u * 2.0), z = b.z + (cz - b.z) * Math.min(1.0, u * 2.0);
            let y = cy + R - 0.02 - 0.42 * u * u;
            if (u >= 1.0) {
                api.hide(this.ballB);
            } else {
                api.place(this.ballB, x, y, z, this.heading, stepped(this.roll, 30.0));
            }
            return;
        }
        if (st == ST_CHEER) {
            api.hide(this.ballB);
            return;
        }
        if (st == ST_HAZARD) {
            if (this.res == RES_WATER) {
                let u = Math.min(1.0, this.st / 0.2);
                if (u >= 1.0) {
                    api.hide(this.ballB);
                } else {
                    api.place(this.ballB, b.x, b.y - (b.y - this.fxY) * u, b.z);
                }
            } else {
                // falls into the gap's clouds
                let y = b.y + b.vy * this.st - 0.5 * G_AIR * this.st * this.st;
                if (y < -1.15) {
                    api.hide(this.ballB);
                } else {
                    api.place(this.ballB, b.x + b.vx * this.st * 0.3, y, b.z + b.vz * this.st * 0.3, this.heading, stepped(this.roll, 30.0));
                }
            }
            return;
        }
        if (st == ST_AIM) {
            // anticipation: squashed by the pull
            let p = this.aimPow;
            let yaw = Math.atan2(Math.cos(this.aimAng), Math.sin(this.aimAng)) * 57.2958;
            api.placeScaled(this.ballB, b.x, b.y - 0.03 * p, b.z, yaw, 1.0 + 0.12 * p, 1.0 - 0.16 * p, 1.0 + 0.12 * p);
            return;
        }
        if (st == ST_IDLE) {
            api.place(this.ballB, b.x, b.y, b.z, this.heading, stepped(this.roll, 30.0));
            return;
        }
        api.place(this.ballB, b.x, b.y, b.z, this.heading, stepped(this.roll, 30.0));
    }

    drawFx(api: GameApi): void {
        // confetti
        for (let i = 0; i < NSPARK; i++) {
            let tt = this.sparkT;
            if (i >= this.sparkN || tt > 1.5) {
                api.hide(this.sparkB[i]);
                continue;
            }
            let y = this.fxY + this.sparkVY[i] * tt - 4.5 * tt * tt;
            if (y < this.fxY - 0.1) {
                api.hide(this.sparkB[i]);
                continue;
            }
            api.place(this.sparkB[i], this.fxX + this.sparkVX[i] * tt, y, this.fxZ + this.sparkVZ[i] * tt,
                      stepped(tt * 500.0 + <f64>i * 40.0, 45.0), stepped(tt * 300.0, 45.0));
        }
        // the splash (or a puff of cloud from the gap)
        let water = this.rippleOn;
        for (let i = 0; i < NDROP; i++) {
            let tt = this.dropT;
            let g = water ? 9.0 : 2.0;
            let y = this.dropY0 + this.dropVY[i] * tt - 0.5 * g * tt * tt;
            if (tt > 1.0 || y < this.dropY0 - 0.05) {
                api.hide(this.dropB[i]);
                continue;
            }
            let s = water ? 1.0 : 1.6;
            api.place(this.dropB[i], this.fxX + this.dropVX[i] * tt, y, this.fxZ + this.dropVZ[i] * tt, 0, 0, 0, s);
        }
        if (water && this.dropT < 0.9) {
            let s = 0.35 + 0.75 * stepped(this.dropT / 0.9, 0.12);
            api.placeScaled(this.rippleB, this.fxX, this.dropY0 + 0.03, this.fxZ, 0, s, 1, s);
        } else {
            api.hide(this.rippleB);
        }
    }

    // ---------------------------------------------------------------- the HUD

    hud(api: GameApi): void {
        let ink = api.paletteColor(C_INK);
        let slate = api.paletteColor(C_SLATE);
        let white = api.paletteColor(C_WHITE);
        let peach = api.paletteColor(C_PEACH);
        let yellow = api.paletteColor(C_YELLOW);
        let lime = api.paletteColor(C_LIME);
        let pink = api.paletteColor(C_PINK);
        let ice = api.paletteColor(C_ICE);
        let w = <f32>api.hudW, h = <f32>api.hudH;
        let st = this.state;
        let hi = this.hi;
        let par = <i32>HOLE[hi * 11 + 2];

        // the aim: a rubber band to the finger, a dotted line the way the ball will go, a meter
        if (st == ST_AIM && this.aimPow > 0.0) {
            let b = this.ball;
            let gy = <f32>(b.y - R + 0.02);
            if (api.project(<f32>b.x, gy, <f32>b.z)) {
                let bx = api.screenX, by = api.screenY;
                let p = this.aimPow;
                let L = 0.5 + 3.6 * p;
                if (api.project(<f32>(b.x + Math.cos(this.aimAng) * L), gy, <f32>(b.z + Math.sin(this.aimAng) * L))) {
                    let ex = api.screenX - bx, ey = api.screenY - by;
                    let el = Mathf.sqrt(ex * ex + ey * ey);
                    let n = <i32>(el / 3.0);
                    let c = p > 0.8 ? pink : (p > 0.5 ? yellow : white);
                    for (let k = 1; k <= n; k++) {
                        let q = <f32>k / <f32>n;
                        let px = Mathf.round(bx + ex * q), py = Mathf.round(by + ey * q);
                        api.rect(px, py + 1, 1, 1, slate);
                        api.rect(px, py, 1, 1, c);
                    }
                }
                // the pull: from the ball towards the finger, as long as the drag (capped)
                let fx = this.curX - this.pressX, fy = this.curY - this.pressY;
                let fl = Mathf.sqrt(fx * fx + fy * fy);
                if (fl > 2) {
                    let k = Mathf.min(fl, DRAG_FULL) / fl;
                    api.line(bx, by, bx + fx * k, by + fy * k, ice);
                }
                // the meter beside the ball
                let mx = Mathf.round(bx + 7), my = Mathf.round(by - 16);
                api.rect(mx - 1, my - 1, 5, 20, ink);
                let fill = Mathf.round(<f32>p * 18);
                for (let k: f32 = 0; k < fill; k++) {
                    let q = k / 18;
                    let c = q > 0.8 ? pink : (q > 0.5 ? yellow : lime);
                    api.rect(mx, my + 17 - k, 3, 1, c);
                }
            }
        }

        // the top bar: hole, name, par, strokes
        api.rect(0, 0, w, 9, ink);
        let ht = "HOLE " + (hi + 1).toString();
        api.text(3, 2, ht, yellow, 1);
        api.text(9 + api.textWidth(ht, 1), 2, HOLE_NAME[hi], white, 1);
        let rt = "PAR " + par.toString() + "  STROKE " + this.strokes.toString();
        api.text(w - 3 - api.textWidth(rt, 1), 2, rt, peach, 1);

        // the scorecard along the bottom: nine cells, then the total against par
        let cw: f32 = 11;
        let x0: f32 = 3, y0 = h - 11;
        api.rect(0, y0 - 2, w, 13, ink);
        for (let i = 0; i < 9; i++) {
            let cx = x0 + <f32>i * (cw + 1);
            let s = this.card[i];
            let p2 = <i32>HOLE[i * 11 + 2];
            let bg = slate;
            if (i == hi && st != ST_OVER) {
                bg = api.paletteColor(C_PERI);
            }
            api.rect(cx, y0, cw, 9, bg);
            if (s > 0) {
                let c = s == 1 ? yellow : (s < p2 ? lime : (s == p2 ? white : (s == p2 + 1 ? peach : pink)));
                api.text(cx + 4, y0 + 2, s.toString(), c, 1);
            } else {
                api.text(cx + 4, y0 + 2, (i + 1).toString(), ink, 1);
            }
        }
        let tot = this.total();
        let diff = tot - this.parSoFar();
        let dt2 = diff == 0 ? "E" : (diff > 0 ? "+" + diff.toString() : diff.toString());
        let tt = "TOTAL " + tot.toString() + " " + dt2;
        api.text(x0 + 9 * (cw + 1) + 3, y0 + 2, tt, diff < 0 ? lime : (diff == 0 ? white : peach), 1);
        if (this.best > 0) {
            let bt = "BEST " + this.best.toString();
            api.text(w - 3 - api.textWidth(bt, 1), y0 + 2, bt, yellow, 1);
        }

        // the hint before the first putt
        if (!this.started && !api.demo && (st == ST_IDLE || st == ST_AIM) && hi == 0) {
            let s1 = "PRESS, DRAG BACK, LET GO TO PUTT";
            let tw = api.textWidth(s1, 1);
            let hx = Mathf.floor((w - tw) * 0.5);
            hx = w - tw - 4;
            api.rect(hx - 3, 11, tw + 6, 9, ink);
            api.text(hx, 13, s1, white, 1);
        }

        // the verdict of a hole (or a hazard)
        if ((st == ST_CHEER && this.st < 1.6) || (st == ST_HAZARD && this.st < 1.2)) {
            let sc = this.big ? 2 : 1;
            let tw = api.textWidth(this.verdict, sc);
            let rise = <f32>Math.min(4.0, Math.floor(this.st * 12.0));
            let vy = 24 - rise;
            let vx = Mathf.floor((w - tw) * 0.5);
            api.rect(vx - 3, vy - 3, tw + 6, 5 * <f32>sc + 6, ink);
            api.text(vx, vy, this.verdict, api.paletteColor(this.verdictC), sc);
        }

        // the next hole's title while the camera glides
        if (st == ST_GLIDE) {
            let s1 = "HOLE " + (hi + 1).toString() + ": " + HOLE_NAME[hi];
            let s2 = "PAR " + par.toString();
            let tw = api.textWidth(s1, 1);
            let vx = Mathf.floor((w - tw) * 0.5);
            api.rect(vx - 4, 20, tw + 8, 17, ink);
            api.text(vx, 23, s1, yellow, 1);
            api.textCentered(30, s2, white, 1);
        }

        // the round's card
        if (st == ST_OVER) {
            let bw: f32 = 150, bh: f32 = 74;
            let bx = Mathf.floor((w - bw) * 0.5), by = Mathf.floor((h - bh) * 0.5) - 6;
            api.rect(bx - 1, by - 1, bw + 2, bh + 2, slate);
            api.rect(bx, by, bw, bh, ink);
            api.textCentered(by + 5, "ROUND OVER", yellow, 2);
            let diff2 = tot - 26;
            let ds = diff2 == 0 ? "EVEN" : (diff2 > 0 ? "+" + diff2.toString() : diff2.toString());
            api.textCentered(by + 21, "SCORE " + tot.toString() + "  (" + ds + ")  PAR 26", white, 1);
            // par and strokes per hole
            let gx = bx + 12;
            for (let i = 0; i < 9; i++) {
                let cx = gx + <f32>i * 14;
                let p2 = <i32>HOLE[i * 11 + 2];
                let s = this.card[i];
                api.text(cx + 3, by + 31, (i + 1).toString(), api.paletteColor(C_PERI), 1);
                api.text(cx + 3, by + 38, p2.toString(), ice, 1);
                let c = s == 1 ? yellow : (s < p2 ? lime : (s == p2 ? white : (s == p2 + 1 ? peach : pink)));
                api.rect(cx, by + 45, 10, 9, slate);
                api.text(cx + 3, by + 47, s.toString(), c, 1);
            }
            api.textCentered(by + 58, "BEST " + this.best.toString(), yellow, 1);
            if (!api.demo && this.st > 0.8 && (<i32>(this.st * 2.0)) % 2 == 0) {
                api.textCentered(by + bh + 4, "CLICK TO PLAY AGAIN", white, 1, ink);
            }
        }
    }
}

function moreStrokes(d: f64): f64 {
    return 1.0 + Math.min(2.5, 0.1 * d + 0.03 * d * d);
}
