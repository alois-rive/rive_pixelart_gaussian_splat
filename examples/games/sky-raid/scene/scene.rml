<Rive version="1" kind="fragment">
    <!-- One artboard filled by the splat renderer. Every ScriptInput* below is matched
         to an @input of splat_scene.as BY NAME (a misspelled name is silently ignored);
         leave one out and the script's default holds. All are bindable and keyable. -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:60" width="640" height="400" styleId="0:5" name="Scene" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>
        <Fill name="Background">
            <SolidColor colorValue="FF1F240A" name="Void"/>
        </Fill>
        <LayoutComponent width="640" height="400" styleId="0:11" name="Root" id="0:10">
            <LayoutComponentStyle layoutWidthScaleType="fill" layoutHeightScaleType="fill"
                widthUnitsValue="auto" heightUnitsValue="auto" name="Style" id="0:11"/>
            <ScriptedLayout scriptAssetId="0:80" name="Splats" id="0:12">
                <ScriptInputString propertyValue="splats" name="blobName"/>
                <ScriptInputBoolean propertyValue="false" name="orbit"/>
                <!-- demo mode, bound to the Sample view model's `demo`: a host (the gallery) or
                     `--arg demo=true` makes a game play itself and a diorama turn -->
                <ScriptInputBoolean propertyValue="false" name="demo">
                    <DataBindContext sourcePathIds="0:60-0:61" propertyKey="245"/>
                </ScriptInputBoolean>
                <ScriptInputNumber propertyValue="3" name="pixelSize"/>
                <!-- a top-down shoot'em up over a scrolling countryside: orthographic, yaw 0, pitched 60
                     degrees down (house walls and tree trunks still show). orthoHeight 9.549657 over 136 art
                     rows: a texel of 0.070218 m, so the game's 12 m world wrap is exactly 148 art rows along
                     the view (12 sin 60 / texel) and a wrap changes no pixel. game.as moves targetZ forward
                     (a translating camera: snapped to the art grid, the blit slides by screen pixels) -->
                <ScriptInputNumber propertyValue="9.549657" name="orthoHeight"/>
                <ScriptInputNumber propertyValue="0" name="yaw"/>
                <ScriptInputNumber propertyValue="60" name="pitch"/>
                <ScriptInputNumber propertyValue="0" name="spin"/>
                <ScriptInputBoolean propertyValue="true" name="useTarget"/>
                <ScriptInputNumber propertyValue="0" name="targetX"/>
                <ScriptInputNumber propertyValue="0" name="targetY"/>
                <ScriptInputNumber propertyValue="0" name="targetZ"/>
                <!-- a late-summer afternoon: the sun from the upper left of the screen (behind and left of
                     the view), 50 degrees up: shadows fall down and right, the plane's well off its body -->
                <ScriptInputNumber propertyValue="-140" name="sunYaw"/>
                <ScriptInputNumber propertyValue="50" name="sunPitch"/>
                <ScriptInputNumber propertyValue="0.42" name="keyLight"/>
                <ScriptInputNumber propertyValue="0.85" name="highlight"/>
                <ScriptInputNumber propertyValue="1" name="shadeSteps"/>
                <ScriptInputNumber propertyValue="1" name="lightSteps"/>
                <ScriptInputBoolean propertyValue="true" name="splatDither"/>
                <ScriptInputNumber propertyValue="0.35" name="bandDither"/>
                <ScriptInputNumber propertyValue="1" name="ink"/>
                <ScriptInputNumber propertyValue="0.6" name="edgeDepth"/>
                <ScriptInputNumber propertyValue="2048" name="shadowSize"/>
                <ScriptInputNumber propertyValue="0" name="fogMax"/>
                <!-- no horizon in view: a flat sky (it only shows if the ground ever left a gap) -->
                <ScriptInputNumber propertyValue="2" name="horizon"/>
            </ScriptedLayout>
        </LayoutComponent>
        <StateMachine name="SM" id="0:7">
            <StateMachineLayer name="L" id="0:8">
                <AnyState x="0" y="-120"/>
                <ExitState x="300" y="-120"/>
                <EntryState><StateTransition stateToId="0:9"/></EntryState>
                <AnimationState x="150" y="0" animationId="0:6" id="0:9"/>
            </StateMachineLayer>
        </StateMachine>
        <LinearAnimation loopValue="loop" duration="60" name="Idle" id="0:6"/>
    </Artboard>
    <!-- what a host may set on this sample: the gallery switches `demo` per tile -->
    <ViewModel defaultInstanceId="0:62" name="Sample" id="0:60">
        <ViewModelPropertyBoolean name="demo" id="0:61"/>
        <ViewModelInstance exports="true" name="Default" id="0:62">
            <ViewModelInstanceBoolean propertyValue="false" viewModelPropertyId="0:61"/>
        </ViewModelInstance>
    </ViewModel>
    <ScriptAsset file="splat_scene.as" name="splat_scene" id="0:80"/>
    <!-- In an RML project a blob must be declared; its name is what blobName looks up.
         Add one BlobAsset per baked .bin the scene may switch to. -->
    <BlobAsset file="splats.bin" name="splats" id="0:81"/>
</Rive>
