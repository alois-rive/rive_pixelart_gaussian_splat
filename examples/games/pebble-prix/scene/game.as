class Car {
    i: i32 = 0;
    bone: i32 = -1;
    flame: i32 = -1;
    x: f64 = 0; z: f64 = 0; psi: f64 = 0; vx: f64 = 0; vz: f64 = 0;
    w: f64 = 0;               // turn rate (rad/s), for the roll
    s: f64 = 0; si: i32 = 0; n: f64 = 0; rx: f64 = 1; rz: f64 = 0;
    lap: i32 = -1; half: bool = false; crossed: bool = false;
    drift: bool = false; ddir: f64 = 0; charge: f64 = 0; boost: f64 = 0; straight: f64 = 0;
    off: bool = false; surf: i32 = 0;
    done: bool = false; finishT: f64 = 0; lapStart: f64 = 0; best: f64 = 0; lastLap: f64 = 0;
    base: f64 = 1; power: f64 = 1;
    slipVis: f64 = 0; bounce: f64 = 0; bounceV: f64 = 0;
    smokeT: f64 = 0; dustT: f64 = 0; wheel: i32 = 0;
    place: i32 = 0;
    // the driver (computer cars, the demo, a finished player's cool-down lap)
    lineK: f64 = 1; drifts: bool = true; sloppy: f64 = 1;
    mist: f64 = 0; mistKind: i32 = 0; mistIn: f64 = 5; passOff: f64 = 0; passT: f64 = 0; wob: f64 = 0;
    // what the driver asks for this step
    want: f64 = 0; hold: bool = true; press: bool = false; brake: f64 = 0;

    progress(): f64 {
        return <f64>this.lap * TLEN + this.s;
    }
    vf(): f64 {
        return this.vx * Math.sin(this.psi) + this.vz * Math.cos(this.psi);
    }
    speed(): f64 {
        return Math.sqrt(this.vx * this.vx + this.vz * this.vz);
    }
}

function wrap(a: f64): f64 {
    while (a > Math.PI) { a -= 2.0 * Math.PI; }
    while (a < -Math.PI) { a += 2.0 * Math.PI; }
    return a;
}

function clamp(v: f64, a: f64, b: f64): f64 {
    return v < a ? a : (v > b ? b : v);
}

function fmtTime(t: f64): string {
    let cs = <i32>Math.round(t * 100.0);
    let m = cs / 6000;
    let s = (cs / 100) % 60;
    let c = cs % 100;
    let ss = (m > 0 && s < 10 ? "0" : "") + s.toString();
    let cc = (c < 10 ? "0" : "") + c.toString();
    return (m > 0 ? m.toString() + ":" : "") + ss + "." + cc;
}

