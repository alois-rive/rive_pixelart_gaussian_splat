    // ------------------------------------------------------------------ the track

    // centre point, heading and right normal at track distance s: px, pz, ppsi, prx, prz
    private at(s: f64): void {
        s = s % TLEN;
        if (s < 0) { s += TLEN; }
        let f = s / TDS;
        let i = <i32>Math.floor(f) % TN;
        let j = (i + 1) % TN;
        let u = f - Math.floor(f);
        this.px = <f64>T_X[i] + (<f64>T_X[j] - <f64>T_X[i]) * u;
        this.pz = <f64>T_Z[i] + (<f64>T_Z[j] - <f64>T_Z[i]) * u;
        let a = <f64>T_PSI[i] * Math.PI / 180.0;
        let b = <f64>T_PSI[j] * Math.PI / 180.0;
        this.ppsi = a + wrap(b - a) * u;
        this.prx = -Math.cos(this.ppsi);
        this.prz = Math.sin(this.ppsi);
    }

    private val(arr: StaticArray<f32>, s: f64): f64 {
        s = s % TLEN;
        if (s < 0) { s += TLEN; }
        let f = s / TDS;
        let i = <i32>Math.floor(f) % TN;
        let j = (i + 1) % TN;
        let u = f - Math.floor(f);
        return <f64>arr[i] + (<f64>arr[j] - <f64>arr[i]) * u;
    }

    private zone(s: f64): f64 {
        s = s % TLEN;
        if (s < 0) { s += TLEN; }
        for (let k = 0; k < NZONE; k++) {
            let a = <f64>Z_A[k], b = <f64>Z_B[k];
            let d = (s - a) % TLEN; if (d < 0) { d += TLEN; }
            let L = (b - a) % TLEN; if (L < 0) { L += TLEN; }
            if (d < L) { return <f64>Z_D[k]; }
        }
        return 0;
    }

    // where a car is along the track (a local search round its last sample), laps over the line
    private locate(c: Car): void {
        let best = 1e18;
        let bi = c.si;
        for (let o = -6; o <= 6; o++) {
            let i = ((c.si + o) % TN + TN) % TN;
            let dx = c.x - <f64>T_X[i], dz = c.z - <f64>T_Z[i];
            let d = dx * dx + dz * dz;
            if (d < best) { best = d; bi = i; }
        }
        let j = (bi + 1) % TN;
        let dx = <f64>T_X[j] - <f64>T_X[bi], dz = <f64>T_Z[j] - <f64>T_Z[bi];
        let u = ((c.x - <f64>T_X[bi]) * dx + (c.z - <f64>T_Z[bi]) * dz) / (dx * dx + dz * dz);
        if (u < 0) {
            bi = (bi - 1 + TN) % TN;
            j = (bi + 1) % TN;
            dx = <f64>T_X[j] - <f64>T_X[bi]; dz = <f64>T_Z[j] - <f64>T_Z[bi];
            u = ((c.x - <f64>T_X[bi]) * dx + (c.z - <f64>T_Z[bi]) * dz) / (dx * dx + dz * dz);
        }
        u = clamp(u, 0, 1);
        let ns = (<f64>bi + u) * TDS;
        if (c.s > TLEN * 0.75 && ns < TLEN * 0.25) {
            if (c.half || c.lap < 0) {
                c.lap++;
                c.half = false;
                c.crossed = true;
            }
        } else if (c.s < TLEN * 0.25 && ns > TLEN * 0.75) {
            c.lap--;
        }
        if (ns > TLEN * 0.4 && ns < TLEN * 0.6) { c.half = true; }
        c.s = ns;
        c.si = bi;
        this.at(ns);
        c.rx = this.prx; c.rz = this.prz;
        c.n = (c.x - this.px) * this.prx + (c.z - this.pz) * this.prz;
    }

    // ------------------------------------------------------------------ races

    // the grid: two by two behind the line, the player third
    private grid(api: GameApi): void {
        const SLOT_S: StaticArray<f64> = [-6.0, -6.0, -12.0, -12.0];
        const SLOT_N: StaticArray<f64> = [-1.6, 1.6, -1.6, 1.6];
        const ORDER: StaticArray<i32> = [2, 0, 1, 3];
        for (let k = 0; k < NCAR; k++) {
            let c = this.cars[k];
            let sl = ORDER[k];
            this.placeCar(c, TLEN + SLOT_S[sl], SLOT_N[sl], 0);
            c.lap = -1;
        }
        this.resetRace(api);
        this.goT = 9;
    }

    private placeCar(c: Car, s: f64, n: f64, v: f64): void {
        this.at(s);
        c.x = this.px + this.prx * n;
        c.z = this.pz + this.prz * n;
        c.psi = this.ppsi;
        c.vx = Math.sin(c.psi) * v;
        c.vz = Math.cos(c.psi) * v;
        let ss = s % TLEN; if (ss < 0) { ss += TLEN; }
        c.s = ss;
        c.si = <i32>Math.floor(ss / TDS) % TN;
        c.half = false;
        c.crossed = false;
        this.locate(c);
    }

    private resetRace(api: GameApi): void {
        for (let k = 0; k < NCAR; k++) {
            let c = this.cars[k];
            c.drift = false; c.charge = 0; c.boost = 0; c.done = false; c.finishT = 0; c.lapStart = 0;
            c.best = 0; c.lastLap = 0; c.power = c.base; c.mist = 0; c.mistIn = api.range(4.0, 9.0);
            c.passT = 0; c.passOff = 0; c.slipVis = 0; c.bounce = 0; c.bounceV = 0; c.w = 0;
        }
        this.raceT = 0;
        this.allDoneT = -1;
        this.finishers = 0;
        this.result = 0;
        this.newBest = false;
        this.lapBanner = 9;
        this.wrongT = 0;
        this.lastPlace = 0;
        this.charged = 0;
        for (let k = 0; k < NCONE; k++) {
            this.coneState[k] = 0;
            this.coneX[k] = <f64>C_X[k]; this.coneY[k] = 0; this.coneZ[k] = <f64>C_Z[k];
            this.coneYaw[k] = <f64>k * 37.0;
        }
        this.ranks();
    }

    private newRace(api: GameApi): void {
        this.grid(api);
        this.mode = COUNT;
        this.t = 0;
        this.beep(api, 0);
    }

    // the demo opens mid-race: lap 1, the pack bunched up the harbour straight, a few metres short of
    // the lighthouse hairpin, so the first second is a drift through it
    private demoOpening(api: GameApi): void {
        this.grid(api);
        const DS: StaticArray<f64> = [17.0, 20.5, 14.0, 11.0];
        const DN: StaticArray<f64> = [0.6, -1.4, -1.9, 1.0];
        for (let k = 0; k < NCAR; k++) {
            let c = this.cars[k];
            this.placeCar(c, DS[k], DN[k], 12.5);
            c.lap = 0;
            c.lapStart = -3.5;
            c.mistIn = api.range(3.0, 8.0);
        }
        this.raceT = 3.5;
        this.mode = RACE;
        this.t = 0;
        this.ranks();
        this.lastPlace = this.cars[0].place;
    }

    // places by progress; finished cars by their finishing order
    private ranks(): void {
        for (let a = 0; a < NCAR; a++) {
            let ca = this.cars[a];
            let p = 1;
            for (let b = 0; b < NCAR; b++) {
                if (a == b) { continue; }
                let cb = this.cars[b];
                let ahead = false;
                if (ca.done && cb.done) { ahead = cb.finishT < ca.finishT || (cb.finishT == ca.finishT && b < a); }
                else if (cb.done) { ahead = true; }
                else if (!ca.done) {
                    let pa = ca.progress(), pb = cb.progress();
                    ahead = pb > pa || (pb == pa && b < a);
                }
                if (ahead) { p++; }
            }
            ca.place = p;
        }
    }

    // ------------------------------------------------------------------ the car

    private stepCar(api: GameApi, c: Car, dt: f64): void {
        let fx = Math.sin(c.psi), fz = Math.cos(c.psi);
        let rx = -fz, rz = fx;
        let vf = c.vx * fx + c.vz * fz;
        let vl = c.vx * rx + c.vz * rz;
        let edge = Math.abs(c.n) - HALF;
        let g = c.n > 0 ? <i32>T_GR[c.si] : <i32>T_GL[c.si];
        c.off = edge > 0.15;
        c.surf = c.off ? (g == 1 ? 1 : (g == 2 ? 2 : 0)) : 3;
        let vt = (c.boost > 0 ? VBOOST : VTOP) * c.power;
        if (c.off && g != 2) {
            vt = Math.min(vt, g == 1 ? VSAND : VGRASS);
        }
        if (this.mode == COUNT || this.mode == IDLE) { vt = 0; }
        let acc = c.boost > 0 ? ACCB : ACC;
        if (vf < vt) {
            vf += acc * dt * Math.min(1.0, (vt - vf) / 3.0 + 0.15);
        } else {
            vf -= Math.min(vf - vt, (c.off ? 5.0 : 2.0) * dt);
        }
        vf -= c.brake * dt;
        let err = c.hold ? 0.0 : wrap(c.want - c.psi);
        // a drift: a held press with a sharp steer; it ends when let go, slow, or held straight a moment
        if (c.press && !c.drift && Math.abs(err) > DRIFT_IN && vf > 6.0 && this.mode == RACE) {
            c.drift = true;
            c.ddir = err > 0 ? 1.0 : -1.0;
            c.charge = 0;
            c.straight = 0;
            if (c.i == 0) { this.charged = 0; }
        }
        if (c.drift) {
            c.straight = Math.abs(err) < 0.12 ? c.straight + dt : 0.0;
            if (!c.press || vf < 4.0 || c.straight > 0.3) {
                c.drift = false;
                let b = c.charge >= BOOST2 ? 1.5 : (c.charge >= BOOST1 ? 0.9 : 0.0);
                if (b > 0) {
                    c.boost = Math.max(c.boost, b);
                    if (c.i == 0) {
                        // the boost: a whoosh and a rising zip, longer for a long drift
                        api.soundAt(SFX_WHOOSH, c.x, 0.5, c.z, b > 1.0 ? 1.5 : 1.25, 0.9);
                        api.soundAt(SFX_ZAP, c.x, 0.5, c.z, b > 1.0 ? 0.55 : 0.45, 0.5);
                    }
                }
                c.charge = 0;
            }
        }
        let G = (c.drift ? DRIFT_YAW : GRIP_YAW) * c.power;
        let wmax = Math.min(c.drift ? 3.6 : 2.8, G / Math.max(Math.abs(vf), 3.0));
        wmax = Math.min(wmax, (Math.abs(vf) + 1.5) / 2.0);       // no spinning on the spot
        let w = clamp(err * 5.0, -wmax, wmax);
        if (Math.abs(err * 5.0) > wmax && !c.drift) {
            vf -= SCRUB * dt * Math.min(1.0, (Math.abs(err * 5.0) - wmax) / wmax);
        }
        if (c.drift) {
            vf -= vf > 10.5 ? Math.min(vf - 10.5, 6.0 * dt) : 0.6 * dt;
        }
        vf = Math.max(vf, -2.0);
        c.vx = fx * vf + rx * vl;
        c.vz = fz * vf + rz * vl;
        c.psi += w * dt;
        c.w = w;
        fx = Math.sin(c.psi); fz = Math.cos(c.psi);
        rx = -fz; rz = fx;
        vf = c.vx * fx + c.vz * fz;
        vl = c.vx * rx + c.vz * rz;
        let k = c.drift ? K_DRIFT : (c.off ? K_OFF : K_GRIP);
        let vl2 = vl * Math.exp(-k * dt);
        if (c.drift) {
            vf += 0.45 * (Math.abs(vl) - Math.abs(vl2));
            if (Math.abs(w) > 0.35 && vf > 6.0) {
                c.charge += dt;
            }
        }
        c.vx = fx * vf + rx * vl2;
        c.vz = fz * vf + rz * vl2;
        c.x += c.vx * dt;
        c.z += c.vz * dt;
        c.boost = Math.max(0.0, c.boost - dt);
        this.locate(c);
        // boost strips
        for (let b = 0; b < T_BOOST.length; b++) {
            let ds = (c.s - <f64>T_BOOST[b] * TDS) % TLEN;
            if (ds < 0) { ds += TLEN; }
            if (ds < 3.0 && Math.abs(c.n) < 2.6) {
                if (c.boost < 0.05 && c.i == 0) {
                    api.soundAt(SFX_WHOOSH, c.x, 0.5, c.z, 1.7, 0.7);
                }
                c.boost = Math.max(c.boost, 0.8);
            }
        }
        // the walls (half way to the next run of track, the quay, the houses, the parapets, the coast)
        for (let sd = 0; sd < 2; sd++) {
            let side = sd == 0 ? 1.0 : -1.0;
            let lim = this.val(sd == 0 ? T_WR : T_WL, c.s) - CR;
            let o = c.n * side - lim;
            if (o > 0) {
                let nx = c.rx * side, nz = c.rz * side;
                c.x -= nx * o; c.z -= nz * o;
                let vn = c.vx * nx + c.vz * nz;
                if (vn > 0) {
                    c.vx -= 1.3 * vn * nx; c.vz -= 1.3 * vn * nz;
                    let loss = Math.max(0.55, 1.0 - 0.07 * vn);
                    c.vx *= loss; c.vz *= loss;
                    if (vn > 1.5) {
                        this.bump(api, c, c.x + nx * CR, c.z + nz * CR, vn, 0);
                    }
                }
                this.locate(c);
            }
        }
        // hay bales, oil drums and the gantry's posts
        for (let b = 0; b < NOBS; b++) {
            let dx = c.x - <f64>O_X[b], dz = c.z - <f64>O_Z[b];
            let d = Math.sqrt(dx * dx + dz * dz);
            let r = <f64>O_R[b] + CR;
            if (d < r && d > 1e-6) {
                let nx = dx / d, nz = dz / d;
                c.x += nx * (r - d); c.z += nz * (r - d);
                let vn = c.vx * nx + c.vz * nz;
                if (vn < 0) {
                    c.vx -= 1.35 * vn * nx; c.vz -= 1.35 * vn * nz;
                    let loss = Math.max(0.55, 1.0 + 0.07 * vn);
                    c.vx *= loss; c.vz *= loss;
                    if (vn < -1.0) {
                        this.bump(api, c, c.x - nx * CR, c.z - nz * CR, -vn, <f64>O_R[b] > 0.6 ? 1 : 2);
                    }
                }
                this.locate(c);
            }
        }
        // cones: knocked flying
        for (let b = 0; b < NCONE; b++) {
            if (this.coneState[b] != 0) { continue; }
            let dx = this.coneX[b] - c.x, dz = this.coneZ[b] - c.z;
            let d = Math.sqrt(dx * dx + dz * dz);
            if (d < CR + 0.3) {
                let sp = c.speed();
                let nx = d > 1e-6 ? dx / d : Math.sin(c.psi), nz = d > 1e-6 ? dz / d : Math.cos(c.psi);
                this.coneState[b] = 1;
                this.coneVX[b] = c.vx * 0.8 + nx * (2.0 + sp * 0.2);
                this.coneVZ[b] = c.vz * 0.8 + nz * (2.0 + sp * 0.2);
                this.coneVY[b] = 3.0 + sp * 0.18;
                this.coneSpin[b] = (api.rand() < 0.5 ? -1.0 : 1.0) * api.range(500, 900);
                c.vx *= 0.96; c.vz *= 0.96;
                if (this.near(c)) {
                    // a cone: a hollow plastic pop
                    api.soundAt(SFX_POP, c.x, 0.4, c.z, 0.55, 0.8);
                }
            }
        }
    }

    // a car within sight of the player (smoke and sounds only for those)
    private near(c: Car): bool {
        let p = this.cars[0];
        let dx = c.x - p.x, dz = c.z - p.z;
        return dx * dx + dz * dz < 26.0 * 26.0;
    }

    private bump(api: GameApi, c: Car, x: f64, z: f64, v: f64, kind: i32): void {
        c.bounceV = Math.max(c.bounceV, Math.min(2.2, v * 0.25));
        if (!this.near(c)) { return; }
        this.spark(x, 0.4, z);
        if (c.i == 0) {
            this.shakeT = 0.18;
        }
        if (this.bumpT <= 0) {
            this.bumpT = 0.15;
            let vol = Math.min(1.0, 0.35 + v * 0.07) * (c.i == 0 ? 1.0 : 0.6);
            if (kind == 1) {
                // a hay bale: a soft heavy thump
                api.soundAt(SFX_THUD, x, 0.4, z, 0.9, vol);
            } else if (kind == 2) {
                // an oil drum: a hollow clang
                api.soundAt(SFX_HIT, x, 0.4, z, 1.3, vol * 0.8);
                api.soundAt(SFX_NOTE, x, 0.4, z, 1.6, vol * 0.3);
            } else {
                // a wall: a crunch and a thud
                api.soundAt(SFX_THUD, x, 0.4, z, 1.1, vol);
                api.soundAt(SFX_HIT, x, 0.4, z, 0.8, vol * 0.7);
            }
        }
    }

    // car to car: two circles a car (nose and tail), pushed apart, a light exchange of momentum
    private contacts(api: GameApi): void {
        for (let a = 0; a < NCAR; a++) {
            for (let b = a + 1; b < NCAR; b++) {
                let A = this.cars[a], B = this.cars[b];
                let ddx = B.x - A.x, ddz = B.z - A.z;
                if (ddx * ddx + ddz * ddz > 16.0) { continue; }
                let hit = false;
                for (let ia = -1; ia <= 1; ia += 2) {
                    for (let ib = -1; ib <= 1; ib += 2) {
                        let ax = A.x + Math.sin(A.psi) * 0.65 * <f64>ia, az = A.z + Math.cos(A.psi) * 0.65 * <f64>ia;
                        let bx = B.x + Math.sin(B.psi) * 0.65 * <f64>ib, bz = B.z + Math.cos(B.psi) * 0.65 * <f64>ib;
                        let dx = bx - ax, dz = bz - az;
                        let d = Math.sqrt(dx * dx + dz * dz);
                        if (d > 1e-6 && d < 1.5) {
                            let nx = dx / d, nz = dz / d;
                            let o = (1.5 - d) * 0.5;
                            A.x -= nx * o; A.z -= nz * o; B.x += nx * o; B.z += nz * o;
                            let rv = (B.vx - A.vx) * nx + (B.vz - A.vz) * nz;
                            if (rv < 0) {
                                let j = -1.4 * rv * 0.5;
                                A.vx -= j * nx; A.vz -= j * nz; B.vx += j * nx; B.vz += j * nz;
                                if (-rv > 1.2) {
                                    A.bounceV = Math.max(A.bounceV, 0.6); B.bounceV = Math.max(B.bounceV, 0.6);
                                    if ((a == 0 || b == 0) && this.bumpT <= 0) {
                                        this.bumpT = 0.15;
                                        // a car-to-car tap: a light crunch
                                        api.soundAt(SFX_HIT, ax + nx * 0.75, 0.5, az + nz * 0.75, 1.1, Math.min(0.8, 0.3 + -rv * 0.08));
                                        this.spark(ax + nx * 0.75, 0.5, az + nz * 0.75);
                                    }
                                }
                            }
                            hit = true;
                        }
                    }
                }
                if (hit) {
                    this.locate(A);
                    this.locate(B);
                }
            }
        }
    }

    // ------------------------------------------------------------------ drivers

    // a computer driver (and the demo's, with the player's controls only): follows the racing line,
    // drifts the hairpins, pulls out to pass, makes small mistakes
    private drive(api: GameApi, c: Car, dt: f64, human: bool): void {
        let vf = c.vf();
        c.mistIn -= dt;
        if (c.mistIn <= 0 && c.mist <= 0) {
            c.mist = api.range(0.7, 1.4);
            c.mistKind = <i32>Math.floor(api.rand() * 3.0);
            c.mistIn = api.range(5.0, 11.0) / Math.max(0.2, c.sloppy);
            c.wob = api.range(0, 6.28);
        }
        let look = 2.6 + 0.42 * Math.max(vf, 0.0);
        if (c.mist > 0) {
            c.mist -= dt;
            if (c.mistKind == 0) { look += 4.0; }                  // turns in late, runs wide
        }
        let tn = this.val(T_LINE, c.s + look) * c.lineK;
        if (c.mist > 0 && c.mistKind == 1) {
            tn += 1.3 * Math.sin(c.wob + c.mist * 6.0);            // a wobble
        }
        // a car just ahead in the same lane: pull out to the side with more room
        c.passT -= dt;
        if (c.passT <= 0) { c.passOff = 0; }
        for (let k = 0; k < NCAR; k++) {
            let o = this.cars[k];
            if (o == c) { continue; }
            let ahead = o.progress() - c.progress();
            if (ahead > 0.5 && ahead < 7.0 && Math.abs(o.n - c.n) < 1.9 && vf > o.vf() - 0.5) {
                let roomR = HALF - 0.9 - o.n;
                let roomL = o.n + HALF - 0.9;
                c.passOff = roomR > roomL ? o.n + 2.1 - tn : o.n - 2.1 - tn;
                c.passT = 1.2;
            }
        }
        tn = clamp(tn + c.passOff, -HALF + 0.9, HALF - 0.9);
        this.at(c.s + look);
        let tx = this.px + this.prx * tn, tz = this.pz + this.prz * tn;
        let want = Math.atan2(tx - c.x, tz - c.z);
        let vt = this.val(T_V, c.s + 2.0 + 0.25 * vf);
        let press = false;
        let zd = this.zone(c.s + 1.0 + 0.1 * vf);
        if (c.drifts && zd != 0 && vf > 7.0 && !(c.mist > 0 && c.mistKind == 2) && this.mode == RACE) {
            press = true;                                          // drift the hairpin
            let e = wrap(want - c.psi);
            if (!c.drift) {
                want = c.psi + zd * Math.max(0.55, zd * e);        // flick it in
            } else if (zd * e < 0.2) {
                want = c.psi + zd * 0.2;                           // hold the slide
            }
        }
        if (c.drift && zd == 0) { press = false; }                 // straighten out: the boost
        c.brake = 0;
        if (!human && vf > vt + (c.drift ? 1.0 : 0.4)) {
            c.brake = Math.min(8.0, (vf - vt) * 4.0);
        }
        if (human && vf > vt + 0.6 && !c.drift && !press) {
            // a person scrubs speed by steering hard into the corner
            let e = wrap(want - c.psi);
            this.at(c.s + 4.0 + 0.4 * vf);
            let a = this.ppsi;
            this.at(c.s + 6.0 + 0.4 * vf);
            let kk = wrap(this.ppsi - a);
            let sg = Math.abs(e) > 0.15 ? (e > 0 ? 1.0 : -1.0) : (kk > 0 ? 1.0 : -1.0);
            want = c.psi + sg * Math.max(Math.abs(e), Math.min(0.9, 0.3 + (vf - vt) * 0.25));
        }
        c.want = want;
        c.hold = false;
        c.press = press;
    }

    // the player: toward the pointer, relative to the car on screen
    private playerInput(api: GameApi): void {
        let c = this.cars[0];
        c.brake = 0;
        c.press = this.pressed;
        c.hold = true;
        if (this.ptrOn && this.ptrX >= 0) {
            if (api.pick(this.ptrX, this.ptrY, 0)) {
                let dx = <f64>api.hitX - c.x, dz = <f64>api.hitZ - c.z;
                if (dx * dx + dz * dz > 1.1 * 1.1) {
                    c.want = Math.atan2(dx, dz);
                    c.hold = false;
                }
            }
        }
    }

    // ------------------------------------------------------------------ the frame

    update(api: GameApi): void {
        let dt = api.dt;
        if (api.demo != this.wasDemo) {
            this.wasDemo = api.demo;
            this.pressed = false;
            this.ptrOn = false;
            if (api.demo) {
                this.demoOpening(api);
            } else {
                this.grid(api);
                this.mode = IDLE;
                this.t = 0;
            }
            this.snapCamera(api);
        }
        this.t += dt;
        this.bumpT -= dt;
        this.goT += dt;
        this.lapBanner += dt;
        if (this.mode == COUNT) {
            // the lights: one a second, then green
            let k = <i32>Math.floor(this.t);
            let kp = <i32>Math.floor(this.t - dt);
            if (k != kp && k >= 1 && k <= 3) {
                this.beep(api, k);
            }
            if (this.t >= 3.0) {
                this.mode = RACE;
                this.t = 0;
                this.raceT = 0;
                this.goT = 0;
                for (let i = 0; i < NCAR; i++) { this.cars[i].lapStart = 0; }
            }
        } else if (this.mode == RACE || this.mode == OVER) {
            this.raceT += dt;
        }
        if (this.mode == OVER && api.demo && this.t > 2.5) {
            this.newRace(api);
        }

        // drivers and physics, in steps of at most 1/60 s
        let steps = max<i32>(1, <i32>Math.ceil(dt * 60.0 - 0.001));
        let h = dt / <f64>steps;
        let lead = this.cars[0].progress();
        for (let st = 0; st < steps; st++) {
            for (let k = 0; k < NCAR; k++) {
                let c = this.cars[k];
                if (this.mode == IDLE || this.mode == COUNT) {
                    c.hold = true; c.press = false; c.brake = 0;
                } else if (k == 0 && !api.demo && !c.done) {
                    this.playerInput(api);
                } else {
                    if (k != 0) {
                        let gap = c.progress() - lead;
                        // a light rubber band: a leader eases off (up to 10 %), a car behind gains a
                        // little (3 %), but never on the final lap
                        let catchUp = c.lap >= LAPS - 1 ? 0.0 : -0.03;
                        c.power = c.base * (1.0 - clamp(gap / 35.0, catchUp, 0.1));
                    }
                    if (c.done) { c.power = c.base * 0.8; }
                    this.drive(api, c, h, k == 0 && !c.done);
                }
                this.stepCar(api, c, h);
            }
            this.contacts(api);
        }
        this.laps(api);
        this.ranks();
        this.sounds(api, dt);
        this.effects(api, dt);
        this.drawCars(api, dt);
        this.scenery(api);
        this.camera(api, dt);
    }

    private laps(api: GameApi): void {
        for (let k = 0; k < NCAR; k++) {
            let c = this.cars[k];
            if (!c.crossed) { continue; }
            c.crossed = false;
            if (this.mode != RACE && this.mode != OVER) { continue; }
            if (c.lap >= 1 && !c.done) {
                let lt = this.raceT - c.lapStart;
                c.lastLap = lt;
                if (c.best == 0 || lt < c.best) { c.best = lt; }
                if (k == 0) {
                    let bl = api.demo ? this.bestLapDemo : this.bestLap;
                    this.lapBannerBest = bl == 0 || lt < bl;
                    if (this.lapBannerBest) {
                        if (api.demo) { this.bestLapDemo = lt; } else { this.bestLap = lt; }
                    }
                    this.lapBannerTime = lt;
                }
            }
            c.lapStart = this.raceT;
            if (c.lap >= LAPS && !c.done) {
                c.done = true;
                c.finishT = this.raceT;
                this.finishers++;
                if (k == 0) {
                    this.finish(api);
                } else if (this.near(c)) {
                    // a rival takes the flag: a short bell
                    api.noteAt(84, c.x, 0.5, c.z, 0.35, SFX_BELL);
                }
            } else if (k == 0 && c.lap >= 1 && c.lap < LAPS) {
                this.lapBanner = 0;
                this.lapBannerLap = c.lap + 1;
                // a lap: a two-note chime, three for the final lap, brighter on a best lap
                let top = this.lapBannerBest ? 4.0 : 0.0;
                api.note(76 + top, 0.6, 0, SFX_BELL);
                api.note(83 + top, 0.6, 0, SFX_BELL, 0.12);
                if (c.lap == LAPS - 1) {
                    api.note(88 + top, 0.6, 0, SFX_BELL, 0.24);
                }
            }
        }
        // the computer cars all home and the player still out there: the race is over
        if (this.mode == RACE && !this.cars[0].done) {
            let others = 0;
            for (let k = 1; k < NCAR; k++) { if (this.cars[k].done) { others++; } }
            if (others == NCAR - 1) {
                if (this.allDoneT < 0) { this.allDoneT = this.raceT; }
                if (this.raceT - this.allDoneT > 15.0) {
                    this.result = 5;
                    this.mode = OVER;
                    this.t = 0;
                    this.cars[0].done = true;
                    this.cars[0].finishT = 9999;
                    api.sound(SFX_LOSE, 1.0, 0.7);
                }
            }
        }
    }

    private finish(api: GameApi): void {
        let c = this.cars[0];
        this.ranks();
        this.result = c.place;
        this.mode = OVER;
        this.t = 0;
        let bt = api.demo ? this.bestTimeDemo : this.bestTime;
        this.newBest = bt == 0 || c.finishT < bt;
        if (this.newBest) {
            if (api.demo) { this.bestTimeDemo = c.finishT; } else { this.bestTime = c.finishT; }
        }
        // the finish: a jingle by position (a fanfare for a win, a shrug for last)
        if (this.result == 1) {
            api.sound(SFX_WIN, 1.0, 0.7);
            api.note(72, 0.55, 0, SFX_NOTE, 0.45);
            api.note(76, 0.55, 0, SFX_NOTE, 0.57);
            api.note(79, 0.6, 0, SFX_NOTE, 0.69);
            api.note(84, 0.7, 0, SFX_BELL, 0.84);
        } else if (this.result == 2) {
            api.note(72, 0.55, 0, SFX_NOTE);
            api.note(76, 0.55, 0, SFX_NOTE, 0.14);
            api.note(79, 0.6, 0, SFX_BELL, 0.28);
        } else if (this.result == 3) {
            api.note(72, 0.5, 0, SFX_NOTE);
            api.note(74, 0.5, 0, SFX_NOTE, 0.16);
            api.note(76, 0.5, 0, SFX_BELL, 0.32);
        } else {
            api.sound(SFX_LOSE, 1.0, 0.6);
        }
        if (this.newBest && this.result <= 4) {
            api.sound(SFX_POWERUP, 1.0, 0.5, 0, 1.1);
        }
    }

    private beep(api: GameApi, k: i32): void {
        if (k < 3) {
            // the lights: a beep each, then the start note, higher and longer
            api.note(69, 0.6, 0, SFX_NOTE);
        } else {
            api.note(81, 0.7, 0, SFX_NOTE);
            api.note(81, 0.5, 0, SFX_BELL);
        }
    }

    // ------------------------------------------------------------------ sound

    private sounds(api: GameApi, dt: f64): void {
        let c = this.cars[0];
        if (this.mode == IDLE) { return; }
        let v = c.speed();
        // the engine: sparse low ticks, quicker and higher with speed (rate-limited: the busiest sound)
        this.engineIn--;
        if (this.engineIn <= 0) {
            let rev = this.mode == COUNT ? 3.0 + 2.0 * Math.sin(this.t * 7.0) : v;
            let pitch = 0.07 + 0.0085 * rev + (c.boost > 0 ? 0.04 : 0.0);
            api.sound(SFX_TICK, pitch, 0.5 + Math.min(0.3, rev * 0.02));
            this.engineIn = max<i32>(3, <i32>Math.round(13.0 - rev * 0.75));
        }
        // the drift: a tyre scrape, a hiss of short noise bursts
        this.scrapeIn--;
        if (c.drift && this.scrapeIn <= 0) {
            api.sound(SFX_CLICK, 0.22 + 0.04 * Math.sin(this.t * 31.0), 0.6);
            this.scrapeIn = 4;
        }
        // the charge: a blip when the drift has earned a boost, a higher one for a long boost
        if (c.drift) {
            let lvl = c.charge >= BOOST2 ? 2 : (c.charge >= BOOST1 ? 1 : 0);
            if (lvl > this.charged) {
                api.sound(SFX_BLIP, lvl == 2 ? 2.0 : 1.5, 0.5);
                this.charged = lvl;
            }
        }
        // off the track: a low gravel rumble
        this.rumbleIn--;
        if (c.off && v > 2.0 && this.rumbleIn <= 0) {
            api.sound(SFX_CLICK, 0.08, 0.7);
            this.rumbleIn = 5;
        }
        // a place won or lost: a rising or falling pair of blips
        if (this.mode == RACE && !c.done) {
            this.placeT -= dt;
            if (this.lastPlace != 0 && c.place != this.lastPlace && this.placeT <= 0) {
                if (c.place < this.lastPlace) {
                    api.sound(SFX_BLIP, 1.2, 0.5);
                    api.sound(SFX_BLIP, 1.6, 0.5, 0, 0.07);
                } else {
                    api.sound(SFX_BLIP, 0.8, 0.45);
                    api.sound(SFX_BLIP, 0.6, 0.45, 0, 0.07);
                }
                this.placeT = 0.4;
                this.lastPlace = c.place;
            } else if (this.lastPlace == 0) {
                this.lastPlace = c.place;
            }
        }
    }

    // ------------------------------------------------------------------ effects

    private spark(x: f64, y: f64, z: f64): void {
        let k = this.sparkNext;
        this.sparkNext = (k + 1) % NSPARK;
        this.sparkX[k] = x; this.sparkY[k] = y; this.sparkZ[k] = z; this.sparkT[k] = 0;
    }

    private effects(api: GameApi, dt: f64): void {
        for (let k = 0; k < NCAR; k++) {
            let c = this.cars[k];
            if (!this.near(c)) { continue; }
            // tyre smoke while drifting, from the rear wheels, turn about
            c.smokeT -= dt;
            if (c.drift && c.smokeT <= 0 && c.speed() > 4.0) {
                c.smokeT = 0.07;
                c.wheel = 1 - c.wheel;
                let b = c.bone;
                api.transform(b, <f64>api.restX[b] + (c.wheel == 0 ? 0.62 : -0.62), <f64>api.restY[b] + 0.05, <f64>api.restZ[b] - 0.85);
                let p = this.puffNext;
                this.puffNext = (p + 1) % NPUFF;
                this.puffX[p] = api.tx; this.puffY[p] = 0.0; this.puffZ[p] = api.tz; this.puffT[p] = 0;
            }
            // dust off the track
            c.dustT -= dt;
            if (c.off && c.surf != 2 && c.dustT <= 0 && c.speed() > 3.0) {
                c.dustT = 0.12;
                let b = c.bone;
                api.transform(b, <f64>api.restX[b], <f64>api.restY[b], <f64>api.restZ[b] - 1.1);
                let p = this.dustNext;
                this.dustNext = (p + 1) % NDUST;
                this.dustX[p] = api.tx; this.dustZ[p] = api.tz; this.dustT[p] = 0;
            }
        }
        for (let p = 0; p < NPUFF; p++) {
            if (this.puffT[p] > 0.75) { continue; }
            this.puffT[p] += dt;
            let u = this.puffT[p] / 0.75;
            if (u >= 1.0) { api.hide(this.puffB[p]); continue; }
            // grows fast, then shrinks as it drifts up; stepped at 12 fps
            let us = Math.floor(u * 9.0) / 9.0;
            let s = us < 0.3 ? 0.35 + us / 0.3 * 0.65 : 1.0 - (us - 0.3) / 0.7 * 0.75;
            api.place(this.puffB[p], this.puffX[p], this.puffY[p] + us * 0.7, this.puffZ[p], <f64>p * 40.0, 0, 0, s);
        }
        for (let p = 0; p < NDUST; p++) {
            if (this.dustT[p] > 0.6) { continue; }
            this.dustT[p] += dt;
            let u = this.dustT[p] / 0.6;
            if (u >= 1.0) { api.hide(this.dustB[p]); continue; }
            let us = Math.floor(u * 7.0) / 7.0;
            let s = us < 0.25 ? 0.4 + us / 0.25 * 0.6 : 1.0 - (us - 0.25) / 0.75 * 0.7;
            api.place(this.dustB[p], this.dustX[p], us * 0.3, this.dustZ[p], <f64>p * 55.0, 0, 0, s);
        }
        for (let p = 0; p < NSPARK; p++) {
            if (this.sparkT[p] > 0.25) { continue; }
            this.sparkT[p] += dt;
            if (this.sparkT[p] > 0.25) { api.hide(this.sparkB[p]); continue; }
            let s = this.sparkT[p] < 0.08 ? 1.0 : 0.6;
            api.place(this.sparkB[p], this.sparkX[p], this.sparkY[p], this.sparkZ[p], this.sparkT[p] * 900.0, 0, 0, s);
        }
        // cones
        for (let k = 0; k < NCONE; k++) {
            let st = this.coneState[k];
            if (st == 1) {
                this.coneVY[k] -= 9.8 * dt;
                this.coneX[k] += this.coneVX[k] * dt;
                this.coneY[k] += this.coneVY[k] * dt;
                this.coneZ[k] += this.coneVZ[k] * dt;
                this.coneYaw[k] += this.coneSpin[k] * dt;
                if (this.coneY[k] < 0 && this.coneVY[k] < 0) {
                    this.coneY[k] = 0;
                    if (this.coneVY[k] < -3.0) {
                        this.coneVY[k] *= -0.35;
                        this.coneVX[k] *= 0.6; this.coneVZ[k] *= 0.6;
                    } else {
                        this.coneState[k] = 2;
                    }
                }
                api.place(this.coneB[k], this.coneX[k], this.coneY[k] + 0.3, this.coneZ[k], this.coneYaw[k], this.coneYaw[k] * 0.7, 0, 1);
            } else if (st == 2) {
                api.place(this.coneB[k], this.coneX[k], 0.27, this.coneZ[k], this.coneYaw[k], 90, 0, 1);
            } else {
                api.place(this.coneB[k], this.coneX[k], 0, this.coneZ[k], this.coneYaw[k], 0, 0, 1);
            }
        }
    }

    private drawCars(api: GameApi, dt: f64): void {
        for (let k = 0; k < NCAR; k++) {
            let c = this.cars[k];
            // the rear slides out in a drift: the nose turned further into the corner
            let want = c.drift ? c.ddir * 0.42 : 0.0;
            c.slipVis += (want - c.slipVis) * Math.min(1.0, dt * 9.0);
            // a bounce after a bump, a rattle off the track
            c.bounceV -= 30.0 * c.bounce * dt + 6.0 * c.bounceV * dt;
            c.bounce += c.bounceV * dt * 4.0;
            c.bounce = clamp(c.bounce, -0.15, 0.25);
            let y = Math.max(0.0, c.bounce * 0.4);
            if (c.off && c.speed() > 2.0) {
                y += Math.floor(this.raceT * 15.0 + <f64>k) % 2.0 == 0.0 ? 0.04 : 0.0;
            }
            let vf = c.vf();
            let roll = clamp(c.w * vf * 0.55, -7.0, 7.0);
            let pitch = -c.bounce * 18.0 + (c.boost > 0 ? -3.0 : 0.0);
            let yaw = (c.psi + c.slipVis) * 180.0 / Math.PI;
            api.place(c.bone, c.x, y, c.z, yaw, pitch, roll, 1);
            // the boost flame out of the exhaust, flickering in two lengths
            if (c.boost > 0) {
                let b = c.bone;
                api.transform(b, <f64>api.restX[b], <f64>api.restY[b] + 0.30, <f64>api.restZ[b] - 1.36);
                let f = Math.floor(api.time * 16.0 + <f64>k) % 2.0 == 0.0 ? 1.0 : 0.7;
                api.placeScaled(c.flame, api.tx, api.ty, api.tz, yaw, 1, 1, f * (c.boost > 1.0 ? 1.3 : 1.0), pitch, 0);
            } else {
                api.hide(c.flame);
            }
        }
    }

    private scenery(api: GameApi): void {
        let t = api.time;
        // boats at their moorings, bobbing and rolling at 8 fps
        let ts = Math.floor(t * 8.0) / 8.0;
        api.place(this.boat0, -12.0, -1.0 + 0.08 * Math.sin(ts * 1.7), 9.6, 80.0 + 4.0 * Math.sin(ts * 0.6), 0, 4.0 * Math.sin(ts * 1.3), 1);
        api.place(this.boat1, 11.0, -1.0 + 0.08 * Math.sin(ts * 1.5 + 2.0), 10.4, 105.0 + 4.0 * Math.sin(ts * 0.5 + 1.0), 0, 4.0 * Math.sin(ts * 1.1 + 1.0), 1);
        // the chequered flag by the line: waves, faster once the player has finished
        let rate = this.mode == OVER ? 12.0 : 6.0;
        let fl = Math.floor(t * rate) % 4.0;
        this.at(0);
        let fx = this.px - this.prx * (HALF + 2.3), fz = this.pz - this.prz * (HALF + 2.3);
        api.placeScaled(this.flag, fx, 0, fz, 15.0 + fl * 10.0, fl == 1.0 || fl == 3.0 ? 0.85 : 1.0, 1, 1, 0, 0);
        // the start lights on the gantry: three reds one a second, then the green
        this.at(0);
        for (let k = 0; k < 3; k++) {
            let lit = this.mode == COUNT && this.t >= <f64>k;
            if (lit) {
                let yy = -1.65 + <f64>k * 1.1;
                api.place(this.lamps[k], this.px - 0.75, 4.0, this.pz - yy, 0, 0, 0, 1);
            } else {
                api.hide(this.lamps[k]);
            }
        }
        if (this.goT < 1.2) {
            api.place(this.golamp, this.px - 0.75, 4.0, this.pz - (-1.65 + 3.0 * 1.1), 0, 0, 0, 1);
        } else {
            api.hide(this.golamp);
        }
        // two gulls circling over the harbour, flapping at 8 fps
        for (let g = 0; g < 2; g++) {
            let b = g == 0 ? this.gull0 : this.gull1;
            let a = t * (0.32 + 0.07 * <f64>g) + <f64>g * 2.6;
            let cx = g == 0 ? -6.0 : 14.0, cz = g == 0 ? 11.0 : 8.0;
            let x = cx + 7.0 * Math.cos(a), z = cz + 4.5 * Math.sin(a);
            let flap = Math.floor(t * 8.0 + <f64>g * 3.0) % 3.0;
            let yaw = Math.atan2(-7.0 * Math.sin(a), 4.5 * Math.cos(a)) * 180.0 / Math.PI;
            api.placeScaled(b, x, 6.5 + 0.4 * Math.sin(a * 2.0), z, yaw, 1, flap == 0.0 ? 1.0 : (flap == 1.0 ? 2.5 : -1.5), 1, 0, 14.0);
        }
    }

    // ------------------------------------------------------------------ the camera

    private camTarget(api: GameApi): f64 {
        let c = this.cars[0];
        return this.val(T_CAM, c.s) * Math.PI / 180.0;
    }

    private snapCamera(api: GameApi): void {
        this.camPsi = this.camTarget(api);
        this.camLook = 4.0;
        this.camera(api, 0);
    }

    // a high orthographic camera behind the player, turning slowly after the circuit's long-run
    // direction (a rate-limited follow), looking a little ahead of the car
    private camera(api: GameApi, dt: f64): void {
        let c = this.cars[0];
        let e = wrap(this.camTarget(api) - this.camPsi);
        this.camPsi += clamp(e * 2.2, -0.8, 0.8) * dt;
        let lk = 3.6 + 0.13 * c.speed();
        this.camLook += (lk - this.camLook) * Math.min(1.0, dt * 2.0);
        let x = c.x + Math.sin(this.camPsi) * this.camLook;
        let z = c.z + Math.cos(this.camPsi) * this.camLook;
        if (this.shakeT > 0) {
            this.shakeT -= dt;
            let k = Math.floor(api.time * 30.0) % 2.0 == 0.0 ? 1.0 : -1.0;
            x += k * 0.18;
            z += k * 0.12;
        }
        api.useTarget = true;
        api.lookAt = false;
        api.targetX = x;
        api.targetY = 0;
        api.targetZ = z;
        api.yaw = this.camPsi * 180.0 / Math.PI + 180.0;
        // where the player's car shows (for the HUD's charge meter)
        if (api.project(<f32>c.x, 1.0, <f32>c.z)) {
            this.carSX = <f64>api.screenX;
            this.carSY = <f64>api.screenY;
        }
        // wrong way: heading against the track for a while
        this.at(c.s);
        if (this.mode == RACE && !c.done && Math.abs(wrap(c.psi - this.ppsi)) > 1.9 && c.speed() > 1.5) {
            this.wrongT += dt;
        } else {
            this.wrongT = 0;
        }
    }

    // ------------------------------------------------------------------ input

    pointer(api: GameApi, kind: i32, x: f32, y: f32): bool {
        if (kind == POINTER_DOWN) {
            this.ptrX = x; this.ptrY = y;
            if (this.mode == IDLE) {
                this.newRace(api);
                this.ptrOn = false;
                return true;
            }
            if (this.mode == OVER) {
                if (this.t > 1.0) {
                    this.newRace(api);
                }
                this.ptrOn = false;
                return true;
            }
            this.pressed = true;
            this.ptrOn = true;
        } else if (kind == POINTER_MOVE) {
            // a lifted finger reports one more move at the lift point: not a steer
            if (this.pressed || Mathf.abs(x - this.upX) > 0.01 || Mathf.abs(y - this.upY) > 0.01) {
                this.ptrX = x; this.ptrY = y;
                this.ptrOn = true;
                this.upX = -99; this.upY = -99;
            }
        } else if (kind == POINTER_UP) {
            // on touch nothing moves after a lift: hold the heading until the pointer moves again
            this.pressed = false;
            this.ptrOn = false;
            this.upX = x; this.upY = y;
        }
        return true;
    }

    // ------------------------------------------------------------------ HUD

    hud(api: GameApi): void {
        let W = <f32>api.hudW;
        let H = <f32>api.hudH;
        let ink = api.rampColor(R_ROAD, 0);
        let white = api.rampColor(R_WHITE, 3);
        let pale = api.rampColor(R_WHITE, 2);
        let gold = api.rampColor(R_GOLD, 3);
        let orange = api.rampColor(R_GOLD, 2);
        let dark = api.rampColor(R_NAVY, 1);
        let c = this.cars[0];

        if (this.mode == IDLE) {
            api.rect(0, 6, W, 21, dark);
            api.textCentered(9, "PEBBLE PRIX", gold, 3, ink);
            api.rect(0, H - 34.0, W, 30, dark);
            api.textCentered(H - 31.0, "TAP OR CLICK TO START", white, 2, ink);
            api.textCentered(H - 18.0, "STEER: POINT OR DRAG  -  DRIFT: HOLD", pale, 1, 0);
            api.textCentered(H - 11.0, "A SHARP TURN, LET GO TO BOOST", pale, 1, 0);
            this.board(api, W, H);
            return;
        }
        // place, top left
        let pl = this.mode == OVER && this.result >= 1 && this.result <= 4 ? this.result : c.place;
        let ps = SUFFIX[pl - 1];
        api.text(4, 4, ps, pl == 1 ? gold : white, 3, ink);
        api.text(4 + api.textWidth(ps, 3) + 3.0, 13, "/4", pale, 1, ink);
        // lap and clock, top right
        let lap = min<i32>(LAPS, max<i32>(1, c.lap + 1));
        let ls = "LAP " + lap.toString() + "/" + LAPS.toString();
        api.text(W - api.textWidth(ls, 2) - 4.0, 4, ls, white, 2, ink);
        let clock = this.mode == COUNT ? 0.0 : (c.done && c.finishT < 9000 ? c.finishT : this.raceT);
        let cs = fmtTime(clock);
        api.text(W - api.textWidth(cs, 1) - 4.0, 17, cs, pale, 1, ink);
        let bl = api.demo ? this.bestLapDemo : this.bestLap;
        if (bl > 0) {
            let bs = "BEST LAP " + fmtTime(bl);
            api.text(W - api.textWidth(bs, 1) - 4.0, 25, bs, orange, 1, ink);
        }
        // the start lights
        if (this.mode == COUNT || (this.mode == RACE && this.goT < 1.0)) {
            let bx = Mathf.floor(W * 0.5) - 25.0;
            api.rect(bx, 26, 50, 15, ink);
            for (let k = 0; k < 3; k++) {
                let col = dark;
                if (this.mode == COUNT && this.t >= <f64>k) { col = api.rampColor(R_RED, 2); }
                if (this.mode == RACE) { col = api.rampColor(R_LIME, 1); }
                api.rect(bx + 4.0 + <f32>k * 15.0, 29, 12, 9, col);
            }
            if (this.mode == RACE) {
                api.textCentered(46, "GO!", api.rampColor(R_LIME, 1), 3, ink);
            }
        }
        // the drift charge, under the car
        if (c.drift && !c.done) {
            let f = Math.min(1.0, c.charge / BOOST2);
            let mx = <f32>Math.round(this.carSX) - 10.0;
            let my = <f32>Math.round(this.carSY) + 12.0;
            api.rect(mx - 1.0, my - 1.0, 22, 4, ink);
            let col = c.charge >= BOOST2 ? gold : (c.charge >= BOOST1 ? orange : pale);
            api.rect(mx, my, <f32>Math.round(f * 20.0), 2, col);
            let m1 = mx + <f32>Math.round(BOOST1 / BOOST2 * 20.0);
            api.rect(m1, my - 1.0, 1, 4, ink);
        }
        if (c.boost > 0 && !c.done && Math.floor(api.time * 10.0) % 2.0 == 0.0) {
            api.textCentered(H - 22.0, "BOOST!", gold, 2, ink);
        }
        // lap banner
        if (this.lapBanner < 1.8) {
            let s = this.lapBannerLap == LAPS ? "FINAL LAP" : "LAP " + this.lapBannerLap.toString();
            api.textCentered(34, s, white, 2, ink);
            let t2 = fmtTime(this.lapBannerTime) + (this.lapBannerBest ? "  BEST!" : "");
            api.textCentered(48, t2, this.lapBannerBest ? gold : pale, 1, ink);
        }
        if (this.wrongT > 0.8 && Math.floor(api.time * 4.0) % 2.0 == 0.0) {
            api.textCentered(60, "WRONG WAY!", api.rampColor(R_RED, 3), 2, ink);
        }
        if (this.mode == OVER) {
            this.results(api, W, H);
        } else if (api.demo) {
            api.text(W - 20.0, H - 8.0, "DEMO", white, 1, ink);
        }
    }

    // the standings: the four drivers in place order with their colours
    private board(api: GameApi, W: f32, H: f32): void {
        let ink = api.rampColor(R_ROAD, 0);
        for (let k = 0; k < NCAR; k++) {
            let c = this.cars[k];
            let y = 34.0 + <f32>k * 8.0;
            api.rect(4, y, 5, 5, api.rampColor(CAR_RAMP[k], 3));
            api.text(12, y, NAMES[k], api.rampColor(R_WHITE, 3), 1, ink);
        }
    }

    private results(api: GameApi, W: f32, H: f32): void {
        let ink = api.rampColor(R_ROAD, 0);
        let dark = api.rampColor(R_NAVY, 1);
        let white = api.rampColor(R_WHITE, 3);
        let pale = api.rampColor(R_WHITE, 2);
        let gold = api.rampColor(R_GOLD, 3);
        let c = this.cars[0];
        let top: f32 = 30;
        api.rect(Mathf.floor(W * 0.5) - 62.0, top, 124, 76, dark);
        let head = this.result == 5 ? "OUT OF TIME" : SUFFIX[this.result - 1] + " PLACE!";
        api.textCentered(top + 4.0, head, this.result == 1 ? gold : white, 2, ink);
        // the order: finished cars first, by time
        for (let p = 1; p <= NCAR; p++) {
            for (let k = 0; k < NCAR; k++) {
                let o = this.cars[k];
                if (o.place != p) { continue; }
                let y = top + 18.0 + <f32>(p - 1) * 8.0;
                let x0 = Mathf.floor(W * 0.5) - 56.0;
                api.text(x0, y, SUFFIX[p - 1], k == 0 ? gold : pale, 1, 0);
                api.rect(x0 + 16.0, y, 5, 5, api.rampColor(CAR_RAMP[k], 3));
                api.text(x0 + 24.0, y, NAMES[k], k == 0 ? gold : white, 1, 0);
                let ts = o.done && o.finishT < 9000 ? fmtTime(o.finishT) : "--";
                api.text(x0 + 112.0 - api.textWidth(ts, 1), y, ts, k == 0 ? gold : pale, 1, 0);
            }
        }
        let bt = api.demo ? this.bestTimeDemo : this.bestTime;
        let bl = api.demo ? this.bestLapDemo : this.bestLap;
        let line = "BEST " + (bt > 0 ? fmtTime(bt) : "--") + "   BEST LAP " + (bl > 0 ? fmtTime(bl) : "--");
        api.textCentered(top + 53.0, line, this.newBest ? gold : pale, 1, 0);
        if (this.newBest) {
            api.textCentered(top + 61.0, "NEW BEST TIME!", gold, 1, 0);
        }
        if (this.t > 1.0 && Math.floor(this.t * 2.0) % 2.0 == 0.0) {
            api.textCentered(top + 69.0, api.demo ? "DEMO" : "CLICK TO RACE AGAIN", white, 1, 0);
        }
    }
}
