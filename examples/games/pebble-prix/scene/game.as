        for (let k = 0; k < NSPARK; k++) { this.sparkB[k] = api.bone("spark" + k.toString()); this.sparkT[k] = 9; api.hide(this.sparkB[k]); }
        for (let k = 0; k < NCONE; k++) { this.coneB[k] = api.bone("cone" + k.toString()); }
        for (let k = 0; k < 3; k++) { this.lamps[k] = api.bone("lamp" + k.toString()); api.hide(this.lamps[k]); }
        this.golamp = api.bone("golamp");
        api.hide(this.golamp);
        this.boat0 = api.bone("boat0");
        this.boat1 = api.bone("boat1");
        this.flag = api.bone("flag");
        this.gull0 = api.bone("gull0");
        this.gull1 = api.bone("gull1");
        this.wasDemo = api.demo;
        if (api.demo) {
            this.demoOpening(api);
        } else {
            this.grid(api);
            this.mode = IDLE;
        }
        this.snapCamera(api);
