// Crate Keeper: a calm push-puzzle in a night greenhouse. Tansy the keeper tidies seed crates onto the
// teal pads of seven small benches. A press (click or tap) steps her ONE tile toward the pointer (the
// dominant axis; the arrow on the next tile shows where), holding keeps stepping, dragging turns her.
// Walking into a crate pushes it when the cell behind it is free; a crate on a pad glows. Cover every pad
// and the bench is clear: the camera glides to the next one while Tansy hops across. UNDO steps back
// (unlimited), RESET puts the bench back. The run is the seven benches; the end shows the moves against
// the par and the session's best, and the next press starts again from the first bench.
// Demo mode plays each bench's optimal solution like a person: a pause to think now and then, a step
// aside and back, and once in a while a wrong move taken back with UNDO; it starts mid-push and restarts
// two seconds after the end.
import { GameApi, POINTER_DOWN, POINTER_MOVE, POINTER_UP, SFX_TICK, SFX_WHOOSH, SFX_THUD, SFX_BELL,
    SFX_NOTE, SFX_CLICK, SFX_WIN, SFX_POWERUP, SFX_JUMP, SFX_BLIP, SFX_POP } from "./game_api";

// <rooms> generated by models/env/make_env.py from its ROOMS list: do not edit by hand
// grid legend: '#' wall, ' ' floor, '.' pad, '$' crate, '*' crate on a pad, '@' keeper, '-' void
const NROOM: i32 = 7;
const ROOM_GRID: string = "#######.   ##    ## #$ ##@   #######-########  . ##  $  ## $#  ##@  . ########-########  ..## $$  ## @#  ###   ###################     ##    $ ### $ $###...  @#########-########    . ##  $#  ## # ..###  $ $ #####@ ##-################   #..## $ $  ##  # $ ## .  # ## ###@ ##################.  #  ##.$$ $ ##. #   ##  #$  ##  .@###########";
const ROOM_OFF: StaticArray<i32> = [0, 36, 78, 120, 168, 224, 280];
const ROOM_W: StaticArray<i32> = [6, 7, 7, 8, 8, 8, 8];
const ROOM_H: StaticArray<i32> = [6, 6, 6, 6, 7, 7, 7];
const ROOM_X: StaticArray<f64> = [0.0, 10.0, 20.0, 20.0, 10.0, 0.0, 0.0];
const ROOM_Z: StaticArray<f64> = [0.0, 0.0, 0.0, 10.0, 10.0, 10.0, 20.0];
const ROOM_PAR: StaticArray<i32> = [8, 18, 30, 37, 46, 64, 76];
const ROOM_NAME: StaticArray<string> = ["SEED SHELF", "FERN BAY", "POTTING NOOK", "TULIP ROW", "MOSS CORNER", "ORCHID LOFT", "MOON GARDEN"];
// an optimal solution per room (BFS; upper case a walk, lower case a push): the demo's plan
const ROOM_SOL: StaticArray<string> = ["RRuuRUll", "UURrURRDDLuLLdLDrr", "DRRUUULLdrURRDDLuDDLLuLUrrrDRu", "LLUUURRDlllULddrDlRRRulUURRDllldUULdd", "RuuuRUllldLLDDRruRRDDLuLLLUUUrrrLddULLDDRrrDRu", "RUUULlDDLLULUURdLDDRRRUURRDlULlULLDrrrLLLDDRRRuRullULLDrdUrrrDRu", "LLUULUURddLDDRRRuRURUULdLllULdRRRRRDDLuRUllllRRRDDLuDDLLuuuRrDRRUlllUldddLDr"];
// </rooms>

const MAXC: i32 = 4;            // crates per bench (each set of bones)
const NPUFF: i32 = 5;
const STEP_T: f64 = 0.15;       // one step's slide
const HOLD_FIRST: f64 = 0.32;   // a held press: the first repeat
const HOLD_EVERY: f64 = 0.2;    //   then every
const GLIDE_T: f64 = 1.7;       // bench to bench
const KEEPER_SCALE: f64 = 1.0;  // baked at 1.15 (the bake's scale): 1 = as baked
const CAM_Y: f64 = 0.3;

const ST_PLAY: i32 = 0;
const ST_CLEAR: i32 = 1;        // the last crate settles, the jingle
const ST_GLIDE: i32 = 2;        // the camera glides, the keeper hops to the next bench
const ST_END: i32 = 3;          // the run's summary

// pad chord: one bell note per pad of a bench, a little major chord built pad by pad
const CHORD: StaticArray<f64> = [72, 76, 79, 84];

export class Game {
    // bones
    keeper: i32 = -1;
    crate: StaticArray<i32> = new StaticArray<i32>(2 * MAXC);     // set A 0..3, set B 4..7
    glow: StaticArray<i32> = new StaticArray<i32>(2 * MAXC);
    markW: i32 = -1;
    markP: i32 = -1;
    puffs: StaticArray<i32> = new StaticArray<i32>(NPUFF);

    // the bench being played
    state: i32 = ST_PLAY;
    stateT: f64 = 0;
    room: i32 = 0;
    set: i32 = 0;                  // which crate set (0 A, 1 B) this bench uses
    W: i32 = 0; H: i32 = 0; off: i32 = 0;
    nc: i32 = 0;
    cc: StaticArray<i32> = new StaticArray<i32>(MAXC);            // crate cells
    cr: StaticArray<i32> = new StaticArray<i32>(MAXC);
    kc: i32 = 0; kr: i32 = 0;      // keeper cell
    moves: i32 = 0;
    // undo: the keeper's cell before each move, the crate it pushed (-1 none)
    uKC: Array<i32> = new Array<i32>();
    uKR: Array<i32> = new Array<i32>();
    uCrate: Array<i32> = new Array<i32>();

    // the run
    results: StaticArray<i32> = new StaticArray<i32>(16);
    best: i32 = 0;                 // the session's best total (a visitor's)
    bestDemo: i32 = 0;
    newBest: bool = false;
    wasDemo: bool = false;

    // visuals: the keeper slides from (fx, fz) to its cell, the pushed crate likewise
    kx: f64 = 0; kz: f64 = 0; ky: f64 = 0;
    kfx: f64 = 0; kfz: f64 = 0; kT: f64 = -10; kYaw: f64 = 45;
    bumpT: f64 = -10; bumpDX: f64 = 0; bumpDZ: f64 = 0;
    pushI: i32 = -1; pushFX: f64 = 0; pushFZ: f64 = 0; pushDX: f64 = 0; pushDZ: f64 = 0;
    cx: StaticArray<f64> = new StaticArray<f64>(2 * MAXC);        // every crate bone's shown place
    cz: StaticArray<f64> = new StaticArray<f64>(2 * MAXC);
    cy: StaticArray<f64> = new StaticArray<f64>(2 * MAXC);
    cOn: StaticArray<bool> = new StaticArray<bool>(2 * MAXC);     // shown glowing
    cShow: StaticArray<bool> = new StaticArray<bool>(2 * MAXC);
    cPop: StaticArray<f64> = new StaticArray<f64>(2 * MAXC);      // time of the last glow-up pop
    cDrop: StaticArray<f64> = new StaticArray<f64>(2 * MAXC);     // when it lands (dropping in), else -10
    camX: f64 = 0; camZ: f64 = 0;
    gFromX: f64 = 0; gFromZ: f64 = 0; gToX: f64 = 0; gToZ: f64 = 0;
    hFromX: f64 = 0; hFromZ: f64 = 0;
    pT: StaticArray<f64> = new StaticArray<f64>(NPUFF);
    pX: StaticArray<f64> = new StaticArray<f64>(NPUFF);
    pZ: StaticArray<f64> = new StaticArray<f64>(NPUFF);
    pS: StaticArray<f64> = new StaticArray<f64>(NPUFF);
    nextPuff: i32 = 0;

    // input: a press steps, a hold repeats, a drag turns
    holding: bool = false;
    holdDir: i32 = -1;
    holdNext: f64 = 0;
    pending: i32 = -1;             // a press during a step's slide: taken when it ends
    markDir: i32 = -1;             // the marker's direction (-1 none) and when it was last set
    markT: f64 = -10;
    btnT: StaticArray<f64> = [-10.0, -10.0];        // UNDO, RESET flashes

    // the demo player
    plan: string = "";
    planI: i32 = 0;
    demoNext: f64 = 0;
    demoBack: i32 = -1;            // a step aside to take back (the opposite direction), or -1
    demoUndo: bool = false;        // a wrong move made: press UNDO next
    demoUndos: i32 = 0;
    demoAsides: i32 = 0;

    // ------------------------------------------------------------------ the grid

    ch(c: i32, r: i32): i32 {
        if (c < 0 || r < 0 || c >= this.W || r >= this.H) return 45; // '-'
        return ROOM_GRID.charCodeAt(this.off + r * this.W + c);
    }
    floor(c: i32, r: i32): bool {
        let k = this.ch(c, r);
        return k != 35 && k != 45;                                  // not '#', not '-'
    }
    pad(c: i32, r: i32): bool {
        let k = this.ch(c, r);
        return k == 46 || k == 42 || k == 43;                       // '.', '*', '+'
    }
    crateAt(c: i32, r: i32): i32 {
        for (let i = 0; i < this.nc; i++) if (this.cc[i] == c && this.cr[i] == r) return i;
        return -1;
    }
    wx(room: i32, c: f64): f64 { return ROOM_X[room] + c - <f64>(ROOM_W[room] - 1) * 0.5; }
    wz(room: i32, r: f64): f64 { return ROOM_Z[room] + r - <f64>(ROOM_H[room] - 1) * 0.5; }
    dc(d: i32): i32 { return d == 1 ? 1 : (d == 3 ? -1 : 0); }     // 0 up (-Z), 1 right (+X), 2 down (+Z), 3 left
    dr(d: i32): i32 { return d == 0 ? -1 : (d == 2 ? 1 : 0); }
    solved(): bool {
        for (let i = 0; i < this.nc; i++) if (!this.pad(this.cc[i], this.cr[i])) return false;
        return true;
    }
    onPads(): i32 {
        let n = 0;
        for (let i = 0; i < this.nc; i++) if (this.pad(this.cc[i], this.cr[i])) n++;
        return n;
    }

    // ------------------------------------------------------------------ benches and runs

    start(api: GameApi): void {
        api.playable = true;
        api.seed = 20261116;
        this.keeper = api.bone("keeper");
        for (let i = 0; i < MAXC; i++) {
            this.crate[i] = api.bone("crateA" + i.toString());
            this.crate[MAXC + i] = api.bone("crateB" + i.toString());
            this.glow[i] = api.bone("glowA" + i.toString());
            this.glow[MAXC + i] = api.bone("glowB" + i.toString());
        }
        this.markW = api.bone("markW");
        this.markP = api.bone("markP");
        for (let i = 0; i < NPUFF; i++) { this.puffs[i] = api.bone("puff" + i.toString()); this.pT[i] = -10; }
        for (let i = 0; i < 2 * MAXC; i++) { this.cDrop[i] = -10; this.cPop[i] = -10; }
        this.wasDemo = api.demo;
        this.newRun(api, false);
    }

    // a fresh run on bench 1, at once (no glide)
    newRun(api: GameApi, glide: bool): void {
        for (let i = 0; i < 16; i++) this.results[i] = 0;
        this.newBest = false;
        if (glide) {
            this.beginGlide(api, 0);
            return;
        }
        for (let i = 0; i < 2 * MAXC; i++) this.cShow[i] = false;
        this.set = 0;
        this.loadRoom(api, 0, false);
        this.camX = ROOM_X[0]; this.camZ = ROOM_Z[0];
        if (api.demo) {
            // the demo starts mid-bench: the first two steps already walked, so its first move (at once) pushes
            this.planI = 2;
            for (let k = 0; k < 2; k++) this.apply(api, this.dirOf(this.plan.charCodeAt(k)), true);
            this.uKC.length = 0; this.uKR.length = 0; this.uCrate.length = 0;
            this.kfx = this.kx; this.kfz = this.kz; this.kT = -10;
            this.kYaw = 90;
            this.demoNext = api.time + 0.12;
        }
    }

    // bench `room` with the crate set `this.set`; dropIn: the crates fall in from above (staggered)
    loadRoom(api: GameApi, room: i32, dropIn: bool): void {
        this.room = room;
        this.W = ROOM_W[room]; this.H = ROOM_H[room]; this.off = ROOM_OFF[room];
        this.state = ST_PLAY; this.stateT = 0;
        this.nc = 0;
        for (let r = 0; r < this.H; r++) {
            for (let c = 0; c < this.W; c++) {
                let k = this.ch(c, r);
                if ((k == 36 || k == 42) && this.nc < MAXC) { this.cc[this.nc] = c; this.cr[this.nc] = r; this.nc++; }
                if (k == 64 || k == 43) { this.kc = c; this.kr = r; }
            }
        }
        this.moves = 0;
        this.uKC.length = 0; this.uKR.length = 0; this.uCrate.length = 0;
        this.pushI = -1; this.pending = -1; this.holding = false; this.markDir = -1;
        this.kx = this.wx(room, <f64>this.kc); this.kz = this.wz(room, <f64>this.kr); this.ky = 0;
        this.kfx = this.kx; this.kfz = this.kz; this.kT = -10;
        let s0 = this.set * MAXC;
        for (let i = 0; i < MAXC; i++) {
            let b = s0 + i;
            if (i < this.nc) {
                this.cx[b] = this.wx(room, <f64>this.cc[i]); this.cz[b] = this.wz(room, <f64>this.cr[i]);
                this.cy[b] = 0; this.cShow[b] = true;
                this.cOn[b] = this.pad(this.cc[i], this.cr[i]);
                this.cDrop[b] = dropIn ? api.time + 0.75 + <f64>i * 0.13 : -10;
            } else {
                this.cShow[b] = false;
            }
        }
        // the demo's plan for this bench
        this.plan = ROOM_SOL[room];
        this.planI = 0;
        this.demoBack = -1; this.demoUndo = false; this.demoUndos = 0; this.demoAsides = 0;
        this.demoNext = api.time + (dropIn ? 0.5 : 0.5);
    }

    // glide to bench `room` (the next one, or bench 1 again for a new run); the keeper hops across
    beginGlide(api: GameApi, room: i32): void {
        this.gFromX = ROOM_X[this.room]; this.gFromZ = ROOM_Z[this.room];
        this.hFromX = this.kx; this.hFromZ = this.kz;
        this.set = 1 - this.set;
        this.loadRoom(api, room, true);
        this.state = ST_GLIDE; this.stateT = 0;
        this.gToX = ROOM_X[room]; this.gToZ = ROOM_Z[room];
        this.kT = -10;
        api.soundAt(SFX_JUMP, this.hFromX, 0.5, this.hFromZ, 0.8, 0.6);
        api.sound(SFX_WHOOSH, 0.6, 0.35, 0, 0.1);
    }

    resetRoom(api: GameApi): void {
        // the crates puff away and come back where the bench began
        let s0 = this.set * MAXC;
        for (let i = 0; i < this.nc; i++) this.puff(this.cx[s0 + i], this.cz[s0 + i], 0.8);
        this.puff(this.kx, this.kz, 0.7);
        this.loadRoom(api, this.room, false);
        for (let i = 0; i < this.nc; i++) { this.cPop[s0 + i] = api.time; this.puff(this.cx[s0 + i], this.cz[s0 + i], 0.6); }
        api.sound(SFX_WHOOSH, 0.8, 0.5);
        api.sound(SFX_POP, 0.9, 0.5, 0, 0.12);
        this.btnT[1] = api.time;
    }

    // ------------------------------------------------------------------ moves

    dirOf(code: i32): i32 {
        if (code >= 97) code -= 32;
        if (code == 85) return 0;      // U
        if (code == 82) return 1;      // R
        if (code == 68) return 2;      // D
        return 3;                      // L
    }

    // what a step in direction d would do: 0 blocked, 1 walk, 2 push
    probe(d: i32): i32 {
        let nc = this.kc + this.dc(d), nr = this.kr + this.dr(d);
        if (!this.floor(nc, nr)) return 0;
        let i = this.crateAt(nc, nr);
        if (i < 0) return 1;
        let bc = nc + this.dc(d), br = nr + this.dr(d);
        if (!this.floor(bc, br) || this.crateAt(bc, br) >= 0) return 0;
        return 2;
    }

    // one step (the logic at once, the picture slides); quiet: no sound, no animation (setting up)
    apply(api: GameApi, d: i32, quiet: bool): i32 {
        let what = this.probe(d);
        let ddx = <f64>this.dc(d), ddz = <f64>this.dr(d);
        this.kYaw = Math.atan2(ddx, ddz) * 180 / Math.PI;
        if (what == 0) {
            if (!quiet) {
                this.bumpT = api.time; this.bumpDX = ddx; this.bumpDZ = ddz;
                api.soundAt(SFX_THUD, this.kx + ddx * 0.5, 0.3, this.kz + ddz * 0.5, 1.5, 0.45);
            }
            return 0;
        }
        this.uKC.push(this.kc); this.uKR.push(this.kr);
        let pushed = -1;
        if (what == 2) {
            pushed = this.crateAt(this.kc + this.dc(d), this.kr + this.dr(d));
            let wasOn = this.pad(this.cc[pushed], this.cr[pushed]);
            this.cc[pushed] += this.dc(d); this.cr[pushed] += this.dr(d);
            let b = this.set * MAXC + pushed;
            this.pushI = pushed;
            this.pushFX = this.cx[b]; this.pushFZ = this.cz[b];
            this.pushDX = ddx; this.pushDZ = ddz;
            if (!quiet) {
                // the scrape: each crate has its own grain; leaving a pad sighs a step down
                let tx = this.wx(this.room, <f64>this.cc[pushed]), tz = this.wz(this.room, <f64>this.cr[pushed]);
                api.soundAt(SFX_WHOOSH, tx, 0.3, tz, 0.42 + 0.07 * <f64>pushed, 0.5);
                api.soundAt(SFX_TICK, tx, 0.3, tz, 0.55 + 0.05 * <f64>pushed, 0.35, 0.05);
                if (wasOn && !this.pad(this.cc[pushed], this.cr[pushed])) {
                    api.note(CHORD[min<i32>(this.onPads(), 3)] - 12, 0.3, api.panAt(tx, 0.3, tz), SFX_NOTE, 0.08);
                }
            }
        }
        this.uCrate.push(pushed);
        this.kc += this.dc(d); this.kr += this.dr(d);
        this.moves++;
        this.kfx = this.kx; this.kfz = this.kz;
        if (quiet) {
            this.kx = this.wx(this.room, <f64>this.kc); this.kz = this.wz(this.room, <f64>this.kr);
            if (pushed >= 0) {
                let b = this.set * MAXC + pushed;
                this.cx[b] = this.wx(this.room, <f64>this.cc[pushed]); this.cz[b] = this.wz(this.room, <f64>this.cr[pushed]);
                this.cOn[b] = this.pad(this.cc[pushed], this.cr[pushed]);
                this.pushI = -1;
            }
        } else {
            this.kT = api.time;
            // soft steps, left and right feet
            api.soundAt(SFX_TICK, this.kx, 0.2, this.kz, (this.moves & 1) == 0 ? 0.85 : 1.0, 0.32);
            if (pushed >= 0) this.puff(this.kfx + ddx * 0.55, this.kfz + ddz * 0.55, 0.45);
        }
        return what;
    }

    undo(api: GameApi): void {
        let n = this.uKC.length;
        this.btnT[0] = api.time;
        if (n == 0 || this.state != ST_PLAY) {
            api.sound(SFX_BLIP, 0.6, 0.3);
            return;
        }
        this.finishSlide(api);
        let pk = this.kc, pr = this.kr;
        this.kc = this.uKC[n - 1]; this.kr = this.uKR[n - 1];
        let i = this.uCrate[n - 1];
        this.uKC.length = n - 1; this.uKR.length = n - 1; this.uCrate.length = n - 1;
        this.moves--;
        // slide back (the keeper walks backwards: it keeps facing the way it went)
        this.kfx = this.kx; this.kfz = this.kz; this.kT = api.time;
        if (i >= 0) {
            let b = this.set * MAXC + i;
            this.pushI = i;
            this.pushFX = this.cx[b]; this.pushFZ = this.cz[b];
            this.cc[i] += this.kc - pk; this.cr[i] += this.kr - pr;
            this.pushDX = <f64>(this.kc - pk); this.pushDZ = <f64>(this.kr - pr);
        }
        api.sound(SFX_WHOOSH, 1.35, 0.42);
        api.sound(SFX_TICK, 1.3, 0.25, 0, 0.06);
    }

    // snap the running slide to its end (before an undo or a reset takes over)
    finishSlide(api: GameApi): void {
        this.kx = this.wx(this.room, <f64>this.kc); this.kz = this.wz(this.room, <f64>this.kr);
        this.kfx = this.kx; this.kfz = this.kz; this.kT = -10;
        if (this.pushI >= 0) this.settleCrate(api, this.pushI, false);
        this.pushI = -1;
    }

    // a pushed crate arrives: glow on a pad (with its chord note and a sparkle)
    settleCrate(api: GameApi, i: i32, loud: bool): void {
        let b = this.set * MAXC + i;
        this.cx[b] = this.wx(this.room, <f64>this.cc[i]); this.cz[b] = this.wz(this.room, <f64>this.cr[i]);
        let on = this.pad(this.cc[i], this.cr[i]);
        if (on && !this.cOn[b] && loud) {
            this.cPop[b] = api.time;
            this.puff(this.cx[b], this.cz[b], 1.0);
            let n = this.onPads();
            // a bell per pad: the chord grows as the bench fills
            api.noteAt(CHORD[min<i32>(n - 1, 3)], this.cx[b], 0.4, this.cz[b], 0.55, SFX_BELL);
        }
        this.cOn[b] = on;
    }

    tryStep(api: GameApi, d: i32): void {
        if (this.state != ST_PLAY || d < 0) return;
        if (api.time - this.kT < STEP_T) { this.pending = d; return; }
        this.finishSlide(api);
        this.apply(api, d, false);
    }

    // ------------------------------------------------------------------ frame

    update(api: GameApi): void {
        let dt = api.dt;
        if (api.demo != this.wasDemo || api.demoChanged) {
            this.wasDemo = api.demo;
            for (let i = 0; i < 2 * MAXC; i++) { this.cShow[i] = false; this.cDrop[i] = -10; }
            this.holding = false;
            this.newRun(api, false);
        }
        this.stateT += dt;

        // the slide in progress ends: the pushed crate settles, a buffered press goes
        if (this.kT > 0 && api.time - this.kT >= STEP_T) {
            this.kT = -10;
            this.kx = this.wx(this.room, <f64>this.kc); this.kz = this.wz(this.room, <f64>this.kr);
            if (this.pushI >= 0) { this.settleCrate(api, this.pushI, true); this.pushI = -1; }
            if (this.state == ST_PLAY && this.solved()) {
                this.state = ST_CLEAR; this.stateT = 0;
                this.results[this.room] = this.moves;
                this.pending = -1; this.holding = false;
                this.jingle(api, this.room == NROOM - 1);
            } else if (this.pending >= 0) {
                let d = this.pending;
                this.pending = -1;
                this.apply(api, d, false);
            }
        }

        if (this.state == ST_PLAY) {
            if (api.demo) this.demoThink(api);
            else if (this.holding && api.time >= this.holdNext && this.kT < 0) {
                this.apply(api, this.holdDir, false);
                this.markDir = this.holdDir; this.markT = api.time;
                this.holdNext = api.time + HOLD_EVERY;
            }
        } else if (this.state == ST_CLEAR) {
            if (this.stateT > 1.25) {
                if (this.room == NROOM - 1) {
                    this.state = ST_END; this.stateT = 0;
                    let total = 0;
                    for (let i = 0; i < NROOM; i++) total += this.results[i];
                    if (api.demo) { if (this.bestDemo == 0 || total < this.bestDemo) this.bestDemo = total; }
                    else if (this.best == 0 || total < this.best) { this.best = total; this.newBest = true; }
                    api.sound(SFX_POWERUP, 1.0, 0.55, 0, 0.1);
                    let mel: StaticArray<f64> = [72, 76, 79, 84, 79, 84, 88];
                    for (let k = 0; k < 7; k++) api.note(mel[k], 0.5, 0, SFX_BELL, 0.35 + <f64>k * 0.14);
                } else {
                    this.beginGlide(api, this.room + 1);
                }
            }
        } else if (this.state == ST_GLIDE) {
            if (this.stateT >= GLIDE_T) {
                this.state = ST_PLAY; this.stateT = 0;
                this.puff(this.kx, this.kz, 1.0);
                api.soundAt(SFX_THUD, this.kx, 0, this.kz, 1.1, 0.6);
                this.demoNext = api.time + 0.45;
            }
        } else if (this.state == ST_END) {
            if (api.demo && this.stateT > 2.6) this.newRun(api, true);     // about two seconds after the summary
        }

        this.placeAll(api);
    }


    jingle(api: GameApi, last: bool): void {
        // bench clear: the pads' chord rolls up, a little cadence
        api.sound(SFX_WIN, 1.0, 0.45, 0, 0.05);
        api.note(72, 0.45, 0, SFX_NOTE, 0.12);
        api.note(76, 0.45, 0, SFX_NOTE, 0.24);
        api.note(79, 0.45, 0, SFX_NOTE, 0.36);
        api.note(last ? 84 : 81, 0.5, 0, SFX_BELL, 0.5);
    }

    puff(x: f64, z: f64, s: f64): void {
        let i = this.nextPuff;
        this.nextPuff = (i + 1) % NPUFF;
        this.pT[i] = this.nowT; this.pX[i] = x; this.pZ[i] = z; this.pS[i] = s;
    }
    nowT: f64 = 0;

    placeAll(api: GameApi): void {
        this.nowT = api.time;
        let t = api.time;
        // the camera: a glide between benches (eased), else resting on the bench
        let camX = ROOM_X[this.room], camZ = ROOM_Z[this.room];
        let hopY = 0.0;
        if (this.state == ST_GLIDE) {
            let u = Math.min(this.stateT / GLIDE_T, 1.0);
            let e = u * u * (3 - 2 * u);
            camX = this.gFromX + (this.gToX - this.gFromX) * e;
            camZ = this.gFromZ + (this.gToZ - this.gFromZ) * e;
            // the keeper hops across: a crouch, a high arc, the landing
            let toX = this.wx(this.room, <f64>this.kc), toZ = this.wz(this.room, <f64>this.kr);
            let hu = Math.min(Math.max((this.stateT - 0.15) / (GLIDE_T - 0.15), 0.0), 1.0);
            let he = hu * hu * (3 - 2 * hu);
            this.kx = this.hFromX + (toX - this.hFromX) * he;
            this.kz = this.hFromZ + (toZ - this.hFromZ) * he;
            hopY = 4.0 * 3.0 * hu * (1 - hu);
            let dx = toX - this.hFromX, dz = toZ - this.hFromZ;
            this.kYaw = Math.atan2(dx, dz) * 180 / Math.PI;
        }
        this.camX = camX; this.camZ = camZ;
        api.targetX = camX; api.targetY = CAM_Y; api.targetZ = camZ;

        // the keeper
        let x = this.kx, z = this.kz, y = hopY;
        let sx = 1.0, sy = 1.0;
        let k = (t - this.kT) / STEP_T;
        if (this.kT > 0 && k >= 0 && k < 1) {
            let tx = this.wx(this.room, <f64>this.kc), tz = this.wz(this.room, <f64>this.kr);
            let e = k * k * (3 - 2 * k);
            x = this.kfx + (tx - this.kfx) * e; z = this.kfz + (tz - this.kfz) * e;
            y = 0.09 * Math.sin(k * Math.PI);
            sy = 1 + 0.08 * Math.sin(k * Math.PI); sx = 1 - 0.05 * Math.sin(k * Math.PI);
        } else if (this.state == ST_GLIDE) {
            let u = this.stateT;
            if (u < 0.15) { let q = Math.sin(u / 0.15 * Math.PI); sy = 1 - 0.25 * q; sx = 1 + 0.15 * q; }
            else { sy = 1.1; sx = 0.94; }
        } else {
            // idle: a slow stepped breath; a landing squash
            let br = Math.floor(t * 3.0) % 4.0;
            sy = br == 1 || br == 2 ? 1.02 : 1.0;
            if (this.state == ST_PLAY && this.stateT < 0.2 && this.stateT > 0) {
                let q = Math.sin(this.stateT / 0.2 * Math.PI); sy = 1 - 0.22 * q; sx = 1 + 0.14 * q;
            }
            if (this.state == ST_CLEAR || this.state == ST_END) {
                // a happy bounce
                let q = Math.abs(Math.sin(this.stateT * 9.0));
                y = 0.12 * q * (this.stateT < 1.0 || this.state == ST_END ? 1.0 : 0.0);
            }
        }
        let bt = t - this.bumpT;
        if (bt >= 0 && bt < 0.16) {
            let q = Math.sin(bt / 0.16 * Math.PI) * 0.16;
            x += this.bumpDX * q; z += this.bumpDZ * q;
        }
        api.placeScaled(this.keeper, x, y, z, this.kYaw, sx * KEEPER_SCALE, sy * KEEPER_SCALE, sx * KEEPER_SCALE);

        // the crates of both sets
        let s0 = this.set * MAXC;
        for (let b = 0; b < 2 * MAXC; b++) {
            if (!this.cShow[b]) { api.hide(this.crate[b]); api.hide(this.glow[b]); continue; }
            let px = this.cx[b], pz = this.cz[b], py = 0.0;
            let ax = 1.0, ay = 1.0, az = 1.0;
            let i = b - s0;
            if (i >= 0 && i < MAXC && i == this.pushI && this.kT > 0 && k >= 0 && k < 1) {
                let tx = this.wx(this.room, <f64>this.cc[i]), tz = this.wz(this.room, <f64>this.cr[i]);
                let e = k * k * (3 - 2 * k);
                px = this.pushFX + (tx - this.pushFX) * e; pz = this.pushFZ + (tz - this.pushFZ) * e;
                // squash along the push, a little bulge across
                let q = Math.sin(k * Math.PI);
                let along = 1 - 0.14 * q, across = 1 + 0.07 * q;
                ax = Math.abs(this.pushDX) > 0.5 ? along : across;
                az = Math.abs(this.pushDZ) > 0.5 ? along : across;
                ay = 1 - 0.05 * q;
            }
            let dropT = this.cDrop[b];
            if (dropT > 0) {
                let u = t - dropT;
                if (u < -0.5) { api.hide(this.crate[b]); api.hide(this.glow[b]); continue; }
                if (u < 0) { py = 4.0 * u * u * 4.0; }          // falls from 4 m in half a second
                else if (u < 0.22) {
                    let q = Math.sin(u / 0.22 * Math.PI);
                    ay = 1 - 0.25 * q; ax = 1 + 0.12 * q; az = ax;
                } else {
                    this.cDrop[b] = -10;
                }
                if (u >= 0 && this.cy[b] > 0.5) {
                    this.cy[b] = 0;
                    this.puff(px, pz, 0.8);
                    api.soundAt(SFX_THUD, px, 0, pz, 0.9 + 0.08 * <f64>(b % MAXC), 0.5);
                }
                if (u < 0) this.cy[b] = 1;
            }
            let pop = t - this.cPop[b];
            if (pop >= 0 && pop < 0.25) {
                let q = Math.sin(pop / 0.25 * Math.PI) * 0.16;
                ax *= 1 + q; ay *= 1 + q; az *= 1 + q;
            }
            let showGlow = this.cOn[b] && !(i == this.pushI && this.kT > 0);
            if (showGlow) {
                api.hide(this.crate[b]);
                api.placeScaled(this.glow[b], px, py, pz, 0, ax, ay, az);
            } else {
                api.hide(this.glow[b]);
                api.placeScaled(this.crate[b], px, py, pz, 0, ax, ay, az);
            }
        }

        // the direction marker on the next tile: shown at a press and while it is held (never on hover)
        let md = this.markDir;
        let mAge = t - this.markT;
        let showMark = this.state == ST_PLAY && md >= 0 && (this.holding || mAge < 0.35);
        if (showMark) {
            let what = this.probe(md);
            let mc = this.kc + this.dc(md), mr = this.kr + this.dr(md);
            let mx = this.wx(this.room, <f64>mc), mz = this.wz(this.room, <f64>mr);
            let ddx = <f64>this.dc(md), ddz = <f64>this.dr(md);
            let yaw = Math.atan2(-ddz, ddx) * 180 / Math.PI;
            let bob = Math.floor(t * 6.0) % 2.0 == 0 ? 0.0 : 0.05;
            let my = what == 2 ? 0.72 : 0.0;     // over a crate: on its lid
            if (what == 0) {
                // blocked: a small pink arrow tucked against the keeper
                api.hide(this.markW);
                api.place(this.markP, this.kx + ddx * 0.42, 0.0, this.kz + ddz * 0.42, yaw, 0, 0, 0.55);
            } else if (what == 2) {
                // a push: the white arrow on the crate's lid (dark soil)
                api.hide(this.markP);
                api.place(this.markW, mx - ddx * 0.1 + ddx * bob, my, mz - ddz * 0.1 + ddz * bob, yaw, 0, 0, 0.9);
            } else {
                api.hide(this.markP);
                api.place(this.markW, mx + ddx * bob, my, mz + ddz * bob, yaw, 0, 0, 1.0);
            }
        } else {
            api.hide(this.markW); api.hide(this.markP);
        }

        // puffs: stepped growth in four poses
        for (let i = 0; i < NPUFF; i++) {
            let age = t - this.pT[i];
            if (age < 0 || age > 0.36) { api.hide(this.puffs[i]); continue; }
            let ks = Math.floor(age / 0.36 * 4.0) / 4.0;
            api.place(this.puffs[i], this.pX[i], 0.04 + 0.25 * ks, this.pZ[i], <f64>i * 37.0, 0, 0, this.pS[i] * (0.55 + 0.8 * ks));
        }
    }

    // ------------------------------------------------------------------ the demo player

    demoThink(api: GameApi): void {
        if (api.time < this.demoNext || this.kT > 0) return;
        let pace = api.range(0.2, 0.3);
        if (this.demoUndo) {
            // take the wrong move back
            this.demoUndo = false;
            this.undo(api);
            this.demoNext = api.time + 0.45 + api.range(0.0, 0.2);
            return;
        }
        if (this.demoBack >= 0) {
            let d = this.demoBack;
            this.demoBack = -1;
            this.demoStep(api, d);
            this.demoNext = api.time + pace + 0.1;
            return;
        }
        if (this.planI >= this.plan.length) return;
        let code = this.plan.charCodeAt(this.planI);
        let d = this.dirOf(code);
        let isPush = code >= 97;
        let early = this.room == 0 && this.planI < 4;
        // now and then a step aside to look, and back (never in the first steps of a run)
        if (!early && !isPush && this.demoAsides < 2 && api.rand() < 0.07) {
            for (let k = 1; k < 4; k++) {
                let a = (d + k) % 4;
                if (this.probe(a) == 1) {
                    this.demoAsides++;
                    this.demoStep(api, a);
                    this.demoBack = (a + 2) % 4;
                    this.demoNext = api.time + pace + api.range(0.2, 0.5);
                    return;
                }
            }
        }
        // once in a while a wrong push or step, taken back with UNDO
        if (!early && this.room > 0 && this.demoUndos < 1 && this.planI > 2 && api.rand() < 0.045) {
            for (let k = 1; k < 4; k++) {
                let a = (d + k) % 4;
                if (this.probe(a) != 0) {
                    this.demoUndos++;
                    this.demoStep(api, a);
                    this.demoUndo = true;
                    this.demoNext = api.time + 0.5 + api.range(0.1, 0.4);
                    return;
                }
            }
        }
        this.demoStep(api, d);
        this.planI++;
        // a pause to think before some pushes
        let next = this.planI < this.plan.length ? this.plan.charCodeAt(this.planI) : 0;
        let think = next >= 97 && code < 97 && api.rand() < 0.3 ? api.range(0.3, 0.8) : 0.0;
        this.demoNext = api.time + pace + think;
    }

    demoStep(api: GameApi, d: i32): void {
        this.markDir = d; this.markT = api.time;
        this.finishSlide(api);
        this.apply(api, d, false);
    }

    // ------------------------------------------------------------------ input

    // the HUD buttons (HUD pixels): UNDO bottom left, RESET bottom right
    btnX(i: i32, api: GameApi): f32 { return i == 0 ? 3 : <f32>api.hudW - 53; }
    btnY(api: GameApi): f32 { return <f32>api.hudH - 19; }
    btnW(i: i32): f32 { return i == 0 ? 44 : 50; }

    hitButton(api: GameApi, x: f32, y: f32): i32 {
        for (let i = 0; i < 2; i++) {
            let bx = this.btnX(i, api), by = this.btnY(api);
            if (x >= bx - 3 && x <= bx + this.btnW(i) + 3 && y >= by - 3 && y <= by + 19) return i;
        }
        return -1;
    }

    // the direction a pointer asks for: the dominant world axis from the keeper to its floor point
    dirAt(api: GameApi, x: f32, y: f32): i32 {
        if (!api.pick(x, y, 0.0)) return -1;
        let dx = <f64>api.hitX - this.wx(this.room, <f64>this.kc);
        let dz = <f64>api.hitZ - this.wz(this.room, <f64>this.kr);
        if (Math.abs(dx) < 0.45 && Math.abs(dz) < 0.45) return -1;    // on the keeper's own tile
        if (Math.abs(dx) >= Math.abs(dz)) return dx > 0 ? 1 : 3;
        return dz > 0 ? 2 : 0;
    }

    pointer(api: GameApi, kind: i32, x: f32, y: f32): bool {
        if (kind == POINTER_UP) {
            this.holding = false;
            return true;
        }
        if (kind == POINTER_MOVE) {
            // a drag turns the held direction (no hover: a move without a press does nothing)
            if (this.holding && api.pointerDown) {
                let d = this.dirAt(api, x, y);
                if (d >= 0 && d != this.holdDir) { this.holdDir = d; this.markDir = d; this.markT = api.time; }
            }
            return true;
        }
        if (kind != POINTER_DOWN) return true;
        if (this.state == ST_END) {
            if (this.stateT > 0.8) {
                api.sound(SFX_CLICK, 1.0, 0.5);
                this.newRun(api, true);
            }
            return true;
        }
        let b = this.hitButton(api, x, y);
        if (b == 0) { api.sound(SFX_CLICK, 1.1, 0.45); this.undo(api); return true; }
        if (b == 1) {
            api.sound(SFX_CLICK, 0.9, 0.45);
            if (this.state == ST_PLAY) this.resetRoom(api);
            return true;
        }
        if (this.state != ST_PLAY) return true;
        let d = this.dirAt(api, x, y);
        if (d < 0) return true;
        this.markDir = d; this.markT = api.time;
        this.holding = true; this.holdDir = d; this.holdNext = api.time + HOLD_FIRST;
        this.tryStep(api, d);
        return true;
    }

    // ------------------------------------------------------------------ HUD

    // small text with a dark outline all round: readable over the mint hedges
    outlined(api: GameApi, x: f32, y: f32, t: string, c: u32, dark: u32, scale: i32 = 1): void {
        api.text(x - 1, y, t, dark, scale); api.text(x + 1, y, t, dark, scale);
        api.text(x, y - 1, t, dark, scale); api.text(x, y + 1, t, dark, scale);
        api.text(x + <f32>scale, y + <f32>scale, t, dark, scale);
        api.text(x, y, t, c, scale);
    }

    hud(api: GameApi): void {
        let dark = api.rampColor(10, 0), violet = api.rampColor(2, 1);
        let mint = api.rampColor(3, 3), white = api.rampColor(9, 0), cream = api.rampColor(0, 3);
        let pink = api.rampColor(0, 2), mag = api.rampColor(0, 1);
        let W = <f32>api.hudW, Hh = <f32>api.hudH;

        // the bench, its name; moves against the par
        this.outlined(api, 4, 3, "ROOM " + (this.room + 1).toString() + "/" + NROOM.toString(), cream, dark, 2);
        this.outlined(api, 4, 15, ROOM_NAME[this.room], white, dark);
        let ms = "MOVES " + this.moves.toString();
        let par = ROOM_PAR[this.room];
        let mc = this.moves <= par ? cream : pink;
        this.outlined(api, W - api.textWidth(ms, 2) - 4, 3, ms, mc, dark, 2);
        let ps = "PAR " + par.toString();
        this.outlined(api, W - api.textWidth(ps, 1) - 4, 15, ps, white, dark);

        // the buttons: UNDO, RESET (big enough to tap: 15 art pixels tall)
        for (let i = 0; i < 2; i++) {
            let bx = this.btnX(i, api), by = this.btnY(api), bw = this.btnW(i);
            let lit = api.time - this.btnT[i] < 0.15;
            let usable = this.state == ST_PLAY && (i == 1 || this.uKC.length > 0);
            api.rect(bx, by, bw, 15, dark);
            api.rect(bx + 1, by + 1, bw - 2, 13, lit ? cream : (usable ? violet : dark));
            let label = i == 0 ? "UNDO" : "RESET";
            let tw = api.textWidth(label, 2);
            api.text(bx + Mathf.floor((bw - tw) * 0.5), by + 3, label, lit ? mag : (usable ? white : violet), 2);
        }

        if (this.state == ST_PLAY) {
            if (this.room == 0 && this.moves < 3 && !api.demo) {
                api.textCentered(Hh - 26, "TAP TOWARD A TILE TO STEP", white, 1, dark);
                api.textCentered(Hh - 18, "PUSH THE CRATE ONTO THE PAD", mint, 1, dark);
            }
        } else if (this.state == ST_CLEAR) {
            if (this.stateT > 0.25) {
                let m = this.results[this.room];
                api.textCentered(Hh * 0.5 - 26, this.room == NROOM - 1 ? "ALL TIDY!" : "ROOM CLEAR!", white, 2, dark);
                let line = m.toString() + " MOVES - PAR " + par.toString();
                api.textCentered(Hh * 0.5 - 12, line, m <= par ? mint : cream, 1, dark);
                if (m <= par) api.textCentered(Hh * 0.5 - 4, "PERFECT!", pink, 1, dark);
            }
        } else if (this.state == ST_END) {
            let total = 0, tpar = 0;
            for (let i = 0; i < NROOM; i++) { total += this.results[i]; tpar += ROOM_PAR[i]; }
            let best = api.demo ? this.bestDemo : this.best;
            let px: f32 = Mathf.floor(W * 0.5 - 58), py: f32 = Mathf.floor(Hh * 0.5 - 30);
            api.rect(px - 1, py - 1, 118, 54, dark);
            api.rect(px, py, 116, 52, violet);
            api.textCentered(py + 4, "GREENHOUSE TIDY!", white, 1, dark);
            api.textCentered(py + 14, total.toString() + " MOVES", cream, 2, dark);
            api.textCentered(py + 27, "PAR " + tpar.toString() + "   BEST " + best.toString(), mint, 1, dark);
            // each bench's moves, a mint number where it met its par
            let row = "";
            for (let i = 0; i < NROOM; i++) row += (i > 0 ? " " : "") + this.results[i].toString();
            let rx = Mathf.floor((W - api.textWidth(row, 1)) * 0.5);
            for (let i = 0; i < NROOM; i++) {
                let s = this.results[i].toString();
                api.text(rx, py + 35, s, this.results[i] <= ROOM_PAR[i] ? mint : cream, 1, dark);
                rx += api.textWidth(s + " ", 1) + 1;
            }
            if (!api.demo && this.newBest) api.textCentered(py - 12, "NEW BEST!", pink, 2, dark);
            if (!api.demo && this.stateT > 0.8) api.textCentered(py + 44, "TAP TO PLAY AGAIN", white, 1, dark);
        }
        // a small row of pips: the benches done
        let n = <f32>NROOM;
        let x0 = Mathf.floor(W * 0.5 - n * 3.0);
        for (let i = 0; i < NROOM; i++) {
            let done = i < this.room || (i == this.room && (this.state == ST_CLEAR || this.state == ST_END));
            let c = done ? mint : (i == this.room ? cream : violet);
            api.rect(x0 + <f32>i * 6.0, 5, 4, 4, dark);
            api.rect(x0 + <f32>i * 6.0, 4, 4, 4, c);
        }
    }
}
