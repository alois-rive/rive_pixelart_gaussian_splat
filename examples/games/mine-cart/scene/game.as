// Mine Cart: a cart rolls round a mine's track by itself, faster with every gem. Four junctions each
// open a second lane; click a switch (or anywhere: the next one ahead) to send the cart down the other
// lane. Gems on a lane score; a rockfall turns a lane into a dead end, and running into it crashes.
// One run in one world: the first click starts, a crash shows the score, the next click rolls again.
// Demo mode plays itself like a decent human (late now and then) and restarts two seconds after a crash.
import { GameApi, POINTER_DOWN, SFX_WIN, SFX_TICK, SFX_CLICK, SFX_THUD, SFX_COIN, SFX_POWERUP, SFX_WHOOSH,
    SFX_HIT, SFX_EXPLODE, SFX_LOSE } from "./game_api";

// <track> generated by models/env/make_env.py from the same layout as the rails: do not edit by hand
// world coordinates (x, z), headings in degrees (0 = +X, 90 = +Z); a segment is kind (0 straight,
// 1 arc), length or radius, turn degrees (+ = towards +Z from +X). Path 0 is the main loop.
const MAIN_LEN: f64 = 21.08142;
const PATH_START: StaticArray<f64> = [-2.60000, -1.70000, -0.00000, -1.95885, -1.70000, -0.00000, 2.60000, -1.70000, -0.00000, 1.95885, 1.70000, 180.00000, -2.60000, 1.70000, 180.00000];
const PATH_NSEG: StaticArray<i32> = [4, 5, 3, 5, 3];
const PATH_SEGS: StaticArray<f64> = [0, 5.20000, 0, 1, 1.70000, 180, 0, 5.20000, 0, 1, 1.70000, 180, 1, 0.90000, -60, 1, 0.90000, 60, 0, 0.80000, 0, 1, 0.90000, 60, 1, 0.90000, -60, 1, 0.80000, 90, 0, 1.80000, 0, 1, 0.80000, 90, 1, 0.90000, -60, 1, 0.90000, 60, 0, 0.80000, 0, 1, 0.90000, 60, 1, 0.90000, -60, 1, 0.80000, 90, 0, 1.80000, 0, 1, 0.80000, 90];
const PATH_LEN: StaticArray<f64> = [21.08142, 4.56991, 4.31327, 4.56991, 4.31327];
const J_DIVERGE: StaticArray<f64> = [0.64115, 5.20000, 11.18186, 15.74071];
const J_MERGE: StaticArray<f64> = [4.55885, 10.54071, 15.09955, 21.08142];
const LEVER_POS: StaticArray<f64> = [-2.2588, -1.0600, -0.000, 2.3000, -2.3400, -0.000, 2.2588, 1.0600, 180.000, -2.3000, 2.3400, 180.000];
// </track>

const NJ: i32 = 4;            // junctions
const NGEM: i32 = 6;          // gem pool
const NROCK: i32 = 3;         // rockfall pool
const NPUFF: i32 = 3;         // dust puff pool
const RAIL_Y: f64 = 0.08;     // the rails' top: the cart's wheels sit on it
const CART_SCALE: f64 = 1.25; // the hero, exaggerated over the track (pixel-art habit)
const GEM_SCALE: f64 = 1.4;    // gems read from across the mine
const DROP_H: f64 = 3.4;
const ROCK_SCALE: f64 = 0.75;  // the rockfall pile, a little smaller than the cart      // rocks fall from the roof
const GRAV: f64 = 15.0;

const ST_WAIT: i32 = 0;       // the world idles, the cart parked: the first click starts
const ST_RUN: i32 = 1;
const ST_CRASH: i32 = 2;      // the cart tumbling, then the game-over line

export class Game {
    // bones
    cart: i32 = -1;
    levers: StaticArray<i32> = new StaticArray<i32>(NJ);
    gems: StaticArray<i32> = new StaticArray<i32>(NGEM);
    rocks: StaticArray<i32> = new StaticArray<i32>(NROCK);
    puffs: StaticArray<i32> = new StaticArray<i32>(NPUFF);

    // run state
    state: i32 = ST_WAIT;
    wasDemo: bool = false;
    started: bool = false;
    score: i32 = 0;
    best: i32 = 0;
    bestDemo: i32 = 0;        // the demo keeps its own best: a visitor's best is theirs
    runTime: f64 = 0;
    stateTime: f64 = 0;
    speed: f64 = 2.2;
    path: i32 = 0;            // 0 the main loop, 1 + j junction j's lane B
    s: f64 = 0;               // arc length along the path
    sw: StaticArray<i32> = new StaticArray<i32>(NJ);          // 0 lane A, 1 lane B
    leverAng: StaticArray<f64> = new StaticArray<f64>(NJ);    // shown tilt (springs to the target)
    leverVel: StaticArray<f64> = new StaticArray<f64>(NJ);
    leverPop: StaticArray<f64> = new StaticArray<f64>(NJ);    // time of the last flip

    // the cart's pose this frame (world), its squash, its crash flight
    cx: f64 = 0; cy: f64 = 0; cz: f64 = 0; cyaw: f64 = 0; croll: f64 = 0; cpitch: f64 = 0;
    squashT: f64 = -10;
    vx: f64 = 0; vy: f64 = 0; vz: f64 = 0; spinP: f64 = 0; spinR: f64 = 0; landed: bool = false;

    // gems: on a path at s, or flying (spilled cargo)
    gOn: StaticArray<i32> = new StaticArray<i32>(NGEM);       // 0 free, 1 on the track, 2 popping, 3 spilled
    gPath: StaticArray<i32> = new StaticArray<i32>(NGEM);
    gS: StaticArray<f64> = new StaticArray<f64>(NGEM);
    gJ: StaticArray<i32> = new StaticArray<i32>(NGEM);
    gT: StaticArray<f64> = new StaticArray<f64>(NGEM);
    gX: StaticArray<f64> = new StaticArray<f64>(NGEM);
    gY: StaticArray<f64> = new StaticArray<f64>(NGEM);
    gZ: StaticArray<f64> = new StaticArray<f64>(NGEM);
    gVX: StaticArray<f64> = new StaticArray<f64>(NGEM);
    gVY: StaticArray<f64> = new StaticArray<f64>(NGEM);
    gVZ: StaticArray<f64> = new StaticArray<f64>(NGEM);

    // rockfalls: dropping from the roof onto a lane, then a dead end until the junction re-arms
    rOn: StaticArray<i32> = new StaticArray<i32>(NROCK);      // 0 free, 1 waiting to drop, 2 falling, 3 down
    rPath: StaticArray<i32> = new StaticArray<i32>(NROCK);
    rS: StaticArray<f64> = new StaticArray<f64>(NROCK);
    rJ: StaticArray<i32> = new StaticArray<i32>(NROCK);
    rT: StaticArray<f64> = new StaticArray<f64>(NROCK);       // drop time, then landing time
    rX: StaticArray<f64> = new StaticArray<f64>(NROCK);
    rY: StaticArray<f64> = new StaticArray<f64>(NROCK);
    rZ: StaticArray<f64> = new StaticArray<f64>(NROCK);
    rYaw: StaticArray<f64> = new StaticArray<f64>(NROCK);

    pT: StaticArray<f64> = new StaticArray<f64>(NPUFF);
    pX: StaticArray<f64> = new StaticArray<f64>(NPUFF);
    pZ: StaticArray<f64> = new StaticArray<f64>(NPUFF);
    pBig: StaticArray<f64> = new StaticArray<f64>(NPUFF);
    nextPuff: i32 = 0;

    // floating "+1" labels and click rings (HUD pixels)
    lblX: StaticArray<f64> = new StaticArray<f64>(4);
    lblY: StaticArray<f64> = new StaticArray<f64>(4);
    lblT: StaticArray<f64> = new StaticArray<f64>(4);
    nextLbl: i32 = 0;
    ringX: f64 = 0; ringY: f64 = 0; ringT: f64 = -10;
    shakeT: f64 = -10;

    // the demo player
    demoJ: i32 = -1;          // the junction it is planning for
    demoAt: f64 = -1;         // when it will click (distance-free: a time), -1 none
    demoWant: i32 = 0;

    // path evaluation results
    ex: f64 = 0; ez: f64 = 0; eh: f64 = 0;

    // sound (never decided by api.rand: the demo stays the same)
    sRail: f64 = 0;           // metres rolled since the last rail joint's clack
    sCombo: i32 = 0;          // gems picked in quick succession: each one rings higher
    sLastGem: f64 = -10;
    sNewBest: bool = false;

    start(api: GameApi): void {
        api.playable = true;
        api.seed = 20261116;
        this.cart = api.bone("cart");
        for (let i = 0; i < NJ; i++) this.levers[i] = api.bone("lever" + i.toString());
        for (let i = 0; i < NGEM; i++) this.gems[i] = api.bone("gem" + i.toString());
        for (let i = 0; i < NROCK; i++) this.rocks[i] = api.bone("rock" + i.toString());
        for (let i = 0; i < NPUFF; i++) { this.puffs[i] = api.bone("puff" + i.toString()); this.pT[i] = -10; }
        this.wasDemo = api.demo;
        this.reset(api, api.demo);
        if (api.demo) this.begin(api);
    }

    // ------------------------------------------------------------------ the track

    // world pose at arc length s on path p: ex, ez, eh (heading in degrees, 0 = +X, 90 = +Z)
    eval(p: i32, s0: f64): void {
        let s = s0;
        let off = 0;
        for (let k = 0; k < p; k++) off += PATH_NSEG[k];
        let x = PATH_START[p * 3], z = PATH_START[p * 3 + 1], h = PATH_START[p * 3 + 2];
        let n = PATH_NSEG[p];
        for (let k = 0; k < n; k++) {
            let kind = PATH_SEGS[(off + k) * 3];
            let a = PATH_SEGS[(off + k) * 3 + 1];
            let turn = PATH_SEGS[(off + k) * 3 + 2];
            let len = kind == 0 ? a : Math.abs(a * turn * Math.PI / 180);
            let t = Math.min(s, len);
            let hr = h * Math.PI / 180;
            if (kind == 0) {
                x += Math.cos(hr) * t; z += Math.sin(hr) * t;
            } else {
                let sg = turn > 0 ? 1.0 : -1.0;
                let ccx = x - sg * a * Math.sin(hr), ccz = z + sg * a * Math.cos(hr);
                let h2 = hr + sg * t / a;
                x = ccx + sg * a * Math.sin(h2); z = ccz - sg * a * Math.cos(h2);
                h = h2 * 180 / Math.PI;
            }
            if (s <= len || k == n - 1) {
                break;
            }
            s -= len;
        }
        this.ex = x; this.ez = z; this.eh = h;
    }

    // the junction whose diverge the cart reaches next
    nextJunction(): i32 {
        if (this.path > 0) return this.path % NJ;
        let bestJ = 0, bestD = 1e9;
        for (let j = 0; j < NJ; j++) {
            let d = J_DIVERGE[j] - this.s;
            if (d < 0) d += MAIN_LEN;
            if (d < bestD) { bestD = d; bestJ = j; }
        }
        return bestJ;
    }

    distToDiverge(j: i32): f64 {
        if (this.path > 0) {
            // on lane B of junction path-1: the rest of the lane, then main from its merge
            let i = this.path - 1;
            let d = J_DIVERGE[j] - J_MERGE[i];
            if (d < 0) d += MAIN_LEN;
            return PATH_LEN[this.path] - this.s + d;
        }
        let d = J_DIVERGE[j] - this.s;
        if (d < 0) d += MAIN_LEN;
        return d;
    }

    // lane A of junction j is the main loop between its diverge and merge
    laneMid(j: i32, lane: i32): f64 {
        if (lane == 1) return PATH_LEN[1 + j] * 0.5;
        return J_DIVERGE[j] + (J_MERGE[j] - J_DIVERGE[j]) * 0.5;
    }

    // ------------------------------------------------------------------ runs

    // a pan from a world x (the camera looks straight down -Z: x is across the screen)
    pan(x: f64): f64 {
        return Math.min(Math.max(x / 4.0, -1.0), 1.0) * 0.8;
    }

    reset(api: GameApi, demo: bool): void {
        this.score = 0;
        this.runTime = 0;
        this.speed = 2.2;
        this.path = 0;
        this.s = demo ? MAIN_LEN - 1.7 : MAIN_LEN - 4.6;
        this.landed = false;
        this.cpitch = 0; this.croll = 0;
        this.demoJ = -1; this.demoAt = -1;
        for (let j = 0; j < NJ; j++) { this.sw[j] = 0; }
        for (let i = 0; i < NGEM; i++) { if (this.gOn[i] != 0) this.gOn[i] = 0; api.hide(this.gems[i]); }
        for (let i = 0; i < NROCK; i++) {
            if (this.rOn[i] == 3) this.puff(this.rX[i], this.rZ[i], 1.2);
            this.rOn[i] = 0; api.hide(this.rocks[i]);
        }
        this.placeCart(api);
    }

    // a run begins: the first content arrives (a friendly first junction, a dead end at the second)
    begin(api: GameApi): void {
        this.state = ST_RUN;
        this.stateTime = 0;
        this.started = true;
        api.sound(SFX_WIN, 0.9, 0.6);
        this.sRail = 0;
        this.sCombo = 0;
        if (api.demo) {
            this.arm(api, 0, 1, 0.1);    // a rock drops on lane A at once, a gem waits on lane B
        } else {
            this.arm(api, 0, 2, 0);      // a gem on lane B, no rock: learn the switch
        }
        this.arm(api, 1, 1, 1.2);
        this.arm(api, 2, 0, 2.0);
        this.arm(api, 3, 0, 2.6);
    }

    // new content for junction j. mode 0 random, 1 rock on A + gem on B, 2 gem on B only
    arm(api: GameApi, j: i32, mode: i32, delay: f64): void {
        // clear what the junction held
        for (let i = 0; i < NGEM; i++) {
            if (this.gOn[i] == 1 && this.gJ[i] == j) { this.gOn[i] = 0; api.hide(this.gems[i]); }
        }
        for (let i = 0; i < NROCK; i++) {
            if (this.rOn[i] != 0 && this.rJ[i] == j) {
                if (this.rOn[i] == 3) this.puff(this.rX[i], this.rZ[i], 1.0);
                this.rOn[i] = 0; api.hide(this.rocks[i]);
            }
        }
        let rockLane = -1, gemLane = -1, gemCount = 1;
        if (mode == 1) { rockLane = 0; gemLane = 1; }
        else if (mode == 2) { gemLane = 1; }
        else {
            let pRock = Math.min(0.85, 0.35 + 0.035 * <f64>this.score);
            if (api.rand() < pRock) {
                rockLane = api.rand() < 0.5 ? 0 : 1;
                if (api.rand() < 0.85) gemLane = 1 - rockLane;
            } else {
                gemLane = api.rand() < 0.5 ? 0 : 1;
            }
            if (api.rand() < 0.35) gemCount = 2;
        }
        if (rockLane >= 0) {
            let r = this.freeRock();
            if (r >= 0) {
                let p = rockLane == 1 ? 1 + j : 0;
                let s = this.laneMid(j, rockLane) + (rockLane == 1 ? 0.3 : 0.3);
                this.eval(p, s);
                this.rOn[r] = 1; this.rPath[r] = p; this.rS[r] = s; this.rJ[r] = j;
                this.rX[r] = this.ex; this.rZ[r] = this.ez; this.rY[r] = DROP_H;
                this.rYaw[r] = api.range(0, 360);
                this.rT[r] = this.runTime + delay + api.range(0, 0.4);
            }
        }
        if (gemLane >= 0) {
            for (let k = 0; k < gemCount; k++) {
                let g = this.freeGem();
                if (g < 0) break;
                let p = gemLane == 1 ? 1 + j : 0;
                let s = this.laneMid(j, gemLane) - 0.35 + <f64>k * 0.7 - (gemCount == 1 ? -0.35 : 0);
                this.eval(p, s);
                this.gOn[g] = 1; this.gPath[g] = p; this.gS[g] = s; this.gJ[g] = j;
                this.gX[g] = this.ex; this.gZ[g] = this.ez; this.gY[g] = 0.2;
                this.gT[g] = this.runTime + delay * 0.5 + <f64>k * 0.12;
            }
        }
    }

    freeGem(): i32 {
        for (let i = 0; i < NGEM; i++) if (this.gOn[i] == 0) return i;
        return -1;
    }

    freeRock(): i32 {
        for (let i = 0; i < NROCK; i++) if (this.rOn[i] == 0) return i;
        return -1;
    }

    puff(x: f64, z: f64, big: f64): void {
        let i = this.nextPuff;
        this.nextPuff = (this.nextPuff + 1) % NPUFF;
        this.pT[i] = this.stateTimeAbs; this.pX[i] = x; this.pZ[i] = z; this.pBig[i] = big;
    }

    stateTimeAbs: f64 = 0;    // api.time mirror for puffs and labels

    flip(api: GameApi, j: i32): void {
        this.sw[j] = 1 - this.sw[j];
        // the lever's latch: a click and a clunk, a little higher thrown to lane B
        let pn = this.pan(LEVER_POS[j * 3]);
        api.sound(SFX_CLICK, this.sw[j] == 1 ? 0.8 : 0.6, 0.7, pn);
        api.sound(SFX_THUD, this.sw[j] == 1 ? 2.2 : 1.9, 0.5, pn);
        this.leverPop[j] = api.time;
        this.leverVel[j] += (this.sw[j] == 1 ? 1.0 : -1.0) * 260.0;
        // a ring where the switch is, so a click (or the demo's) reads
        api.project(<f32>LEVER_POS[j * 3], 0.55, <f32>LEVER_POS[j * 3 + 1]);
        this.ringX = api.screenX; this.ringY = api.screenY; this.ringT = api.time;
    }

    crash(api: GameApi): void {
        this.state = ST_CRASH;
        this.stateTime = 0;
        this.sNewBest = !api.demo && this.score > this.best;
        let pn = this.pan(this.cx);
        api.sound(SFX_EXPLODE, 1.1, 1.0, pn);
        api.sound(SFX_HIT, 0.5, 0.8, pn);
        if (api.demo) { if (this.score > this.bestDemo) this.bestDemo = this.score; }
        else if (this.score > this.best) this.best = this.score;
        let hr = this.eh * Math.PI / 180;
        this.vx = Math.cos(hr) * this.speed * 0.45; this.vz = Math.sin(hr) * this.speed * 0.45;
        this.vy = 3.2;
        this.spinP = -140; this.spinR = this.leftSign(api) * 420;
        this.landed = false;
        this.shakeT = api.time;
        this.puff(this.cx + this.vx * 0.2, this.cz + this.vz * 0.2, 1.4);
        // the cargo spills: every free gem flies out of the tub
        for (let i = 0; i < NGEM; i++) {
            if (this.gOn[i] == 1) { this.gOn[i] = 0; api.hide(this.gems[i]); }
            if (this.gOn[i] == 0) {
                this.gOn[i] = 3;
                this.gX[i] = this.cx; this.gY[i] = 0.7; this.gZ[i] = this.cz;
                let a = api.range(0, Math.PI * 2);
                let sp = api.range(1.0, 2.6);
                this.gVX[i] = Math.cos(a) * sp + this.vx; this.gVZ[i] = Math.sin(a) * sp + this.vz;
                this.gVY[i] = api.range(2.5, 4.5);
                this.gT[i] = api.time;
            }
        }
    }

    leftSign(api: GameApi): f64 {
        return api.rand() < 0.5 ? -1.0 : 1.0;
    }

    // ------------------------------------------------------------------ frame

    update(api: GameApi): void {
        let dt = api.dt;
        this.stateTimeAbs = api.time;
        // demo switched off by a visitor: a fresh run at once; switched on: the demo takes over
        if (api.demo != this.wasDemo) {
            this.wasDemo = api.demo;
            this.reset(api, api.demo);
            this.begin(api);
        }
        let prevT = this.stateTime;
        this.stateTime += dt;

        if (this.state == ST_RUN) {
            this.runTime += dt;
            this.speed = Math.min(4.6, 2.2 + 0.075 * <f64>this.score + 0.01 * this.runTime);
            if (api.demo) this.demoThink(api);
            this.advance(api, this.speed * dt);
            // the wheels over the rail joints: a clack every 1.2 m, so the rhythm is the speed
            this.sRail += this.speed * dt;
            if (this.state == ST_RUN && this.sRail >= 1.2) {
                this.sRail -= 1.2;
                api.sound(SFX_TICK, 0.32, 0.5, this.pan(this.cx));
            }
        } else if (this.state == ST_CRASH) {
            this.runTime += dt;
            let wasLanded = this.landed;
            this.tumble(dt);
            if (!wasLanded && this.landed) api.sound(SFX_THUD, 0.9, 0.9, this.pan(this.cx));
            if (prevT < 0.45 && this.stateTime >= 0.45) api.sound(SFX_LOSE, 0.85, 0.75);
            if (this.sNewBest && prevT < 1.4 && this.stateTime >= 1.4) api.sound(SFX_POWERUP, 1.0, 0.6);
            if (api.demo && this.stateTime > 2.0 + 0.9) {
                this.reset(api, true);
                this.begin(api);
            }
        }
        this.updateRocks(api, dt);
        this.updateGems(api, dt);
        this.updateLevers(api, dt);
        this.updatePuffs(api);
        this.placeCart(api);

        // a short shake on a crash and on a rock landing near the cart (whole art pixels: the
        // orthographic camera snaps its target to the grid)
        let sk = api.time - this.shakeT;
        let ox = 0.0, oz = 0.0;
        if (sk < 0.35) {
            let amp = 0.12 * (1 - sk / 0.35);
            ox = amp * Math.sin(api.time * 71.0);
            oz = amp * Math.cos(api.time * 53.0);
        }
        api.targetX = ox;
        api.targetZ = 0.15 + oz;
    }

    advance(api: GameApi, ds: f64): void {
        let ps = this.s;
        this.s += ds;
        if (this.path == 0) {
            for (let j = 0; j < NJ; j++) {
                let sd = J_DIVERGE[j];
                if (ps < sd && this.s >= sd && this.sw[j] == 1) {
                    this.path = 1 + j;
                    this.s = this.s - sd;
                    break;
                }
                // leaving junction j's lane A: new content for it
                let sm = J_MERGE[j];
                if (ps < sm && this.s >= sm) this.arm(api, j, 0, api.range(0.2, 1.4));
            }
            if (this.path == 0 && this.s >= MAIN_LEN) {
                this.s -= MAIN_LEN;
            }
        } else {
            let j = this.path - 1;
            if (this.s >= PATH_LEN[this.path]) {
                this.s = J_MERGE[j] + (this.s - PATH_LEN[this.path]);
                if (this.s >= MAIN_LEN) this.s -= MAIN_LEN;
                this.path = 0;
                this.arm(api, j, 0, api.range(0.2, 1.4));
            }
        }
        // pick up gems, hit rocks
        for (let i = 0; i < NGEM; i++) {
            if (this.gOn[i] != 1 || this.gPath[i] != this.path) continue;
            if (api.time - this.gT[i] < 0) continue;
            let d = this.gS[i] - this.s;
            if (this.path == 0) { if (d > MAIN_LEN * 0.5) d -= MAIN_LEN; if (d < -MAIN_LEN * 0.5) d += MAIN_LEN; }
            if (Math.abs(d) < 0.32) {
                this.gOn[i] = 2; this.gT[i] = api.time;
                this.score++;
                // a gem: quick pickups climb a pentatonic step each, every tenth gem a fanfare
                this.sCombo = api.time - this.sLastGem < 1.6 ? min<i32>(this.sCombo + 1, 5) : 0;
                this.sLastGem = api.time;
                let semis: f64 = this.sCombo == 0 ? 0 : (this.sCombo == 1 ? 2 : (this.sCombo == 2 ? 4 : (this.sCombo == 3 ? 7 : (this.sCombo == 4 ? 9 : 12))));
                api.sound(SFX_COIN, Math.pow(2, semis / 12.0), 0.75, this.pan(this.gX[i]));
                if (this.score % 10 == 0) api.sound(SFX_POWERUP, 1.0, 0.55);
                this.squashT = api.time;
                api.project(<f32>this.gX[i], 0.7, <f32>this.gZ[i]);
                let l = this.nextLbl; this.nextLbl = (l + 1) % 4;
                this.lblX[l] = api.screenX; this.lblY[l] = api.screenY; this.lblT[l] = api.time;
            }
        }
        for (let i = 0; i < NROCK; i++) {
            if (this.rOn[i] < 2 || this.rPath[i] != this.path) continue;
            if (this.rOn[i] == 2 && this.rY[i] > 0.9) continue;
            let d = this.rS[i] - this.s;
            if (this.path == 0) { if (d > MAIN_LEN * 0.5) d -= MAIN_LEN; if (d < -MAIN_LEN * 0.5) d += MAIN_LEN; }
            if (d < 0.78 && d > -0.4) {
                this.crash(api);
                return;
            }
        }
    }

    tumble(dt: f64): void {
        if (this.landed) return;
        this.vy -= GRAV * dt;
        this.cx += this.vx * dt; this.cz += this.vz * dt; this.cy += this.vy * dt;
        this.cpitch += this.spinP * dt; this.croll += this.spinR * dt;
        if (this.cy <= 0.49 && this.vy < 0) {
            // it lands on its side: the pivot (the wheels' base) half the tub's width off the floor
            this.cy = 0.49;
            this.landed = true;
            this.cpitch = 0; this.croll = this.spinR > 0 ? 90.0 : -90.0;
            this.puff(this.cx, this.cz, 1.0);
        }
    }

    placeCart(api: GameApi): void {
        if (this.state != ST_CRASH) {
            this.eval(this.path, this.s);
            this.cx = this.ex; this.cz = this.ez; this.cy = RAIL_Y;
            // a little rattle that grows with speed, a lean outwards on curves
            let rattle = 0.012 * Math.sin(this.s * 9.0) * (this.state == ST_RUN ? 1.0 : 0.0);
            this.cy += Math.abs(rattle);
            this.eval(this.path, this.s + 0.3);
            let dh = this.eh;
            this.eval(this.path, this.s);
            let curv = dh - this.eh;
            if (curv > 180) curv -= 360;
            if (curv < -180) curv += 360;
            this.croll = -curv * this.speed * 0.35;
        }
        this.cyaw = 90 - this.eh;
        let sq = api.time - this.squashT;
        if (this.state == ST_RUN && sq < 0.22) {
            // squash on a pickup: the tub sinks and widens, then springs back
            let k = Math.sin(sq / 0.22 * Math.PI);
            let sy = 1 - 0.22 * k, sxz = 1 + 0.14 * k;
            api.placeScaled(this.cart, this.cx, this.cy, this.cz, this.cyaw, CART_SCALE * sxz, CART_SCALE * sy, CART_SCALE * sxz);
        } else {
            api.place(this.cart, this.cx, this.cy, this.cz, this.cyaw, this.cpitch, this.croll, CART_SCALE);
        }
    }

    updateLevers(api: GameApi, dt: f64): void {
        for (let j = 0; j < NJ; j++) {
            // a spring towards the target tilt: the flip overshoots and settles
            let target = this.sw[j] == 1 ? 32.0 : -32.0;
            let a = this.leverAng[j], v = this.leverVel[j];
            v += ((target - a) * 320.0 - v * 16.0) * dt;
            a += v * dt;
            this.leverAng[j] = a; this.leverVel[j] = v;
            let pop = api.time - this.leverPop[j];
            let sc = pop < 0.2 ? 1 + 0.35 * Math.sin(pop / 0.2 * Math.PI) : 1.0;
            api.place(this.levers[j], LEVER_POS[j * 3], 0.16, LEVER_POS[j * 3 + 1], 90 - LEVER_POS[j * 3 + 2], 0, a, sc);
        }
    }

    updateGems(api: GameApi, dt: f64): void {
        for (let i = 0; i < NGEM; i++) {
            let b = this.gems[i];
            let st = this.gOn[i];
            if (st == 0) continue;
            if (st == 1) {
                let age = api.time - this.gT[i];
                if (age < 0) { api.hide(b); continue; }
                // pop in with an overshoot, then float and turn
                let sc = age < 0.3 ? Math.sin(age / 0.3 * 2.2) * 1.25 : 1.0;
                if (sc < 0.05) sc = 0.05;
                let bob = 0.05 * Math.sin(api.time * 4.0 + <f64>i * 1.7);
                api.place(b, this.gX[i], 0.2 + bob, this.gZ[i], api.time * 140.0 + <f64>i * 40.0, 0, 0, sc * GEM_SCALE);
            } else if (st == 2) {
                // collected: a quick rise and swell, then gone
                let age = api.time - this.gT[i];
                if (age > 0.18) { this.gOn[i] = 0; api.hide(b); continue; }
                let k = age / 0.18;
                api.place(b, this.gX[i], 0.3 + 0.6 * k, this.gZ[i], api.time * 400.0, 0, 0, GEM_SCALE * (1 + 0.9 * k));
            } else {
                // spilled cargo: ballistic, then lying still on the floor
                if (this.gY[i] > 0.0 || this.gVY[i] > 0) {
                    this.gVY[i] -= GRAV * dt;
                    this.gX[i] += this.gVX[i] * dt; this.gY[i] += this.gVY[i] * dt; this.gZ[i] += this.gVZ[i] * dt;
                    if (this.gY[i] <= 0.0 && this.gVY[i] < 0) { this.gY[i] = 0.0; this.gVY[i] = 0; }
                }
                api.place(b, this.gX[i], this.gY[i], this.gZ[i], <f64>i * 61.0 + (this.gY[i] > 0 ? api.time * 500.0 : 0.0), 0, this.gY[i] > 0 ? 0.0 : 70.0, 1);
            }
        }
    }

    updateRocks(api: GameApi, dt: f64): void {
        for (let i = 0; i < NROCK; i++) {
            let b = this.rocks[i];
            let st = this.rOn[i];
            if (st == 0) continue;
            if (st == 1) {
                if (this.runTime >= this.rT[i]) {
                    this.rOn[i] = 2; this.rY[i] = DROP_H; this.rT[i] = 0;
                    api.sound(SFX_WHOOSH, 0.45, 0.45, this.pan(this.rX[i]));   // loose rock from the roof
                }
                else { api.hide(b); continue; }
            }
            if (this.rOn[i] == 2) {
                this.rT[i] -= GRAV * dt;            // vertical speed while falling
                this.rY[i] += this.rT[i] * dt;
                if (this.rY[i] <= 0) {
                    this.rY[i] = 0; this.rOn[i] = 3; this.rT[i] = api.time;
                    this.puff(this.rX[i], this.rZ[i], 1.1);
                    let dx = this.rX[i] - this.cx, dz = this.rZ[i] - this.cz;
                    // the rockfall lands: a heavy thud and a gravel crunch, louder near the cart
                    let near = dx * dx + dz * dz < 9.0 ? 1.0 : 0.0;
                    api.sound(SFX_THUD, 0.75, 0.6 + 0.3 * near, this.pan(this.rX[i]));
                    api.sound(SFX_HIT, 0.35, 0.35 + 0.2 * near, this.pan(this.rX[i]));
                    if (dx * dx + dz * dz < 9.0) this.shakeT = api.time - 0.12;
                }
                api.place(b, this.rX[i], this.rY[i], this.rZ[i], this.rYaw[i], 0, 0, ROCK_SCALE);
            } else {
                // landed: a squash that springs back
                let age = api.time - this.rT[i];
                if (age < 0.25) {
                    let k = Math.sin(age / 0.25 * Math.PI) * (1 - age / 0.25);
                    api.placeScaled(b, this.rX[i], 0, this.rZ[i], this.rYaw[i], ROCK_SCALE * (1 + 0.3 * k), ROCK_SCALE * (1 - 0.4 * k), ROCK_SCALE * (1 + 0.3 * k));
                } else {
                    api.place(b, this.rX[i], 0, this.rZ[i], this.rYaw[i], 0, 0, ROCK_SCALE);
                }
            }
        }
    }

    updatePuffs(api: GameApi): void {
        for (let i = 0; i < NPUFF; i++) {
            let age = api.time - this.pT[i];
            if (age < 0 || age > 0.42) { api.hide(this.puffs[i]); continue; }
            let k = age / 0.42;
            // stepped growth (pixel-art timing: four poses)
            let ks = Mathf.floor(<f32>k * 4.0) / 4.0;
            api.place(this.puffs[i], this.pX[i], 0.05 + 0.4 * <f64>ks, this.pZ[i], <f64>i * 30.0, 0, 0, this.pBig[i] * (0.6 + 1.1 * <f64>ks));
        }
    }

    // ------------------------------------------------------------------ the demo player

    demoThink(api: GameApi): void {
        let j = this.nextJunction();
        let d = this.distToDiverge(j);
        if (j != this.demoJ) {
            // a new junction ahead: what do we want there, and when will we notice?
            this.demoJ = j;
            this.demoAt = -1;
        }
        let want = this.desired(j);
        if (want != this.sw[j] && this.demoAt < 0) {
            // reaction: usually in good time, sometimes late, now and then too late (a crash)
            let slip = Math.min(0.3, 0.025 + 0.01 * <f64>this.score);
            let r = api.rand();
            let lead = r < slip ? -0.4 : (r < slip + 0.2 ? api.range(0.18, 0.35) : api.range(0.55, 1.5));
            let tArrive = d / this.speed;
            let wait = Math.max(0.12, tArrive - lead);
            if (this.runTime < 1.0) wait = Math.min(wait, api.range(0.3, 0.45));
            this.demoAt = this.runTime + wait;
            this.demoWant = want;
        }
        if (this.demoAt >= 0 && this.runTime >= this.demoAt) {
            this.demoAt = -1;
            if (this.sw[j] != this.demoWant && this.distToDiverge(j) > 0.05) this.flip(api, j);
        }
    }

    // the lane a sensible player picks at junction j: away from rocks, towards gems
    desired(j: i32): i32 {
        let rockA = false, rockB = false, gemA = false, gemB = false;
        for (let i = 0; i < NROCK; i++) {
            if (this.rOn[i] >= 2 && this.rJ[i] == j) { if (this.rPath[i] == 0) rockA = true; else rockB = true; }
        }
        for (let i = 0; i < NGEM; i++) {
            if (this.gOn[i] == 1 && this.gJ[i] == j) { if (this.gPath[i] == 0) gemA = true; else gemB = true; }
        }
        if (rockA) return 1;
        if (rockB) return 0;
        if (gemB && !gemA) return 1;
        if (gemA && !gemB) return 0;
        return this.sw[j];
    }

    // ------------------------------------------------------------------ input

    pointer(api: GameApi, kind: i32, x: f32, y: f32): bool {
        if (kind != POINTER_DOWN) return true;
        if (this.state == ST_WAIT) {
            this.begin(api);
            this.ringX = x; this.ringY = y; this.ringT = api.time;
            return true;
        }
        if (this.state == ST_CRASH) {
            if (this.stateTime > 0.7) {
                this.reset(api, false);
                this.begin(api);
            }
            return true;
        }
        // the switch nearest the click (its lever or its lane B), else the next one ahead
        let bestJ = -1;
        let bestD: f32 = 14.0;
        for (let j = 0; j < NJ; j++) {
            api.project(<f32>LEVER_POS[j * 3], 0.4, <f32>LEVER_POS[j * 3 + 1]);
            let dx = api.screenX - x, dy = api.screenY - y;
            let d = Mathf.sqrt(dx * dx + dy * dy);
            if (d < bestD) { bestD = d; bestJ = j; }
            for (let k = 1; k < 4; k++) {
                this.eval(1 + j, PATH_LEN[1 + j] * <f64>k / 4.0);
                api.project(<f32>this.ex, 0.1, <f32>this.ez);
                dx = api.screenX - x; dy = api.screenY - y;
                d = Mathf.sqrt(dx * dx + dy * dy);
                if (d < bestD) { bestD = d; bestJ = j; }
            }
        }
        if (bestJ < 0) bestJ = this.nextJunction();
        this.flip(api, bestJ);
        return true;
    }

    // ------------------------------------------------------------------ HUD

    hud(api: GameApi): void {
        let cream = api.rampColor(1, 3), tan = api.rampColor(1, 2), green = api.rampColor(1, 1), navy = api.rampColor(1, 0);
        let W = <f32>api.hudW, Hh = <f32>api.hudH;

        // the route each switch is set to: a dotted line along the first metre and a half of its lane
        if (this.state != ST_CRASH || this.stateTime < 0.1) {
            for (let j = 0; j < NJ; j++) {
                let nextOne = this.state == ST_RUN && j == this.nextJunction();
                let blink = nextOne && (Mathf.floor(<f32>api.time * 4.0) % 2.0 == 0.0);
                let c = blink ? cream : tan;
                for (let k = 0; k < 6; k++) {
                    let ds = 0.15 + <f64>k * 0.26;
                    if (this.sw[j] == 1) this.eval(1 + j, ds); else this.eval(0, J_DIVERGE[j] + ds);
                    api.project(<f32>this.ex, 0.12, <f32>this.ez);
                    api.rect(Mathf.round(api.screenX), Mathf.round(api.screenY), 1, 1, c);
                }
            }
        }

        // the click ring
        let rt = <f32>(api.time - this.ringT);
        if (rt < 0.25) {
            let r = 2.0 + rt * 20.0;
            let n = 10;
            for (let k = 0; k < n; k++) {
                let a = <f32>k / <f32>n * 6.2832;
                api.rect(Mathf.round(<f32>this.ringX + Mathf.cos(a) * r), Mathf.round(<f32>this.ringY + Mathf.sin(a) * r * 0.8), 1, 1, cream);
            }
        }

        // floating +1s
        for (let l = 0; l < 4; l++) {
            let t = <f32>(api.time - this.lblT[l]);
            if (t >= 0 && t < 0.7 && this.lblT[l] > 0) {
                api.text(<f32>this.lblX[l] - 3, <f32>this.lblY[l] - 6 - t * 14.0, "+1", cream, 1, navy);
            }
        }

        // score, best
        api.text(4, 3, "GEMS " + this.score.toString(), cream, 2, navy);
        let best = api.demo ? this.bestDemo : this.best;
        let bs = "BEST " + best.toString();
        api.text(W - api.textWidth(bs, 1) - 4, 4, bs, tan, 1, navy);

        if (this.state == ST_WAIT) {
            api.textCentered(Hh - 18, "CLICK TO ROLL", cream, 2, navy);
            api.textCentered(Hh - 7, "SWITCH THE RAILS: GEMS IN, ROCKS OUT", tan, 1, navy);
        } else if (this.state == ST_RUN) {
            if (this.runTime < 6.0) api.textCentered(Hh - 7, "CLICK A SWITCH: GEMS IN, ROCKS OUT", tan, 1, navy);
        } else {
            if (this.stateTime > 0.45) {
                api.textCentered(Hh * 0.5 - 14, "CRASH!", cream, 2, navy);
                api.textCentered(Hh * 0.5 + 0, this.score.toString() + (this.score == 1 ? " GEM" : " GEMS") + (this.score >= best && this.score > 0 ? " - NEW BEST" : ""), tan, 1, navy);
                if (!api.demo && this.stateTime > 0.7) api.textCentered(Hh - 7, "CLICK TO ROLL AGAIN", cream, 1, navy);
            }
        }
    }
}
